    validate_volume_source_path "$share_path"
    if path_contains "$share_path" "$home_canonical"; then
      die "Refusing an additional share that contains the real host HOME: $share_path"
    fi
    if paths_overlap "$share_path" "$asset_dir"; then
      die "Refusing overlap between an additional share and installed runtime assets: $share_path"
