      && paths_overlap "$share_path" "$common_git_dir"; then
      die "Additional share overlaps the external Git common directory: $share_path"
    fi
    if [ "${#extra_share_paths[@]}" -gt 0 ]; then
      for existing_share in "${extra_share_paths[@]}"; do
        paths_overlap "$share_path" "$existing_share" \
          && die "Additional shares may not overlap: $share_path and $existing_share"
