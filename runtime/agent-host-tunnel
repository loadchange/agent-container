#!/usr/bin/env node

/**
 * Guest-side loopback forwarder for agent-container full host access.
 *
 * For each allowlisted port P it listens on the guest's 127.0.0.1:P and, for
 * every accepted connection, opens one connection to the host-exec broker's
 * tunnel listener, sends the single authentication frame
 *   AGENT-CONTAINER-TUNNEL/1 <token> <P>\n
 * and then relays raw bytes in both directions. The host broker connects the
 * other end to its own 127.0.0.1:P, so a guest tool that speaks to
 * 127.0.0.1:5037 reaches the operator's real adb server, and so on.
 *
 * This is not a security boundary against the guest: the token it holds is the
 * guest's own per-session credential, and the host broker is the authority
 * that decides which ports may be reached. The forwarder only listens on the
 * loopback interface and never on a routable address.
 *
 * Usage:
 *   agent-host-tunnel --endpoint IPV4:PORT --token 64HEX --ports P[,P...] \
 *     [--ready-fd N]
 * With --ready-fd, the single byte "1" is written to that inherited descriptor
 * once every listener is bound, so the launcher can proceed deterministically.
 */

import net from 'node:net';
import { writeSync } from 'node:fs';
import process from 'node:process';

const TOKEN_PATTERN = /^[0-9a-f]{64}$/;
const CONNECT_TIMEOUT_MS = 5_000;
const MAX_CONNECTIONS = 256;

function fail(message) {
  process.stderr.write(`agent-host-tunnel: ${message}\n`);
  process.exit(64);
}

function parseArguments(argv) {
  const values = new Map();
  const allowed = new Set(['--endpoint', '--token', '--ports', '--ready-fd']);
  for (let index = 0; index < argv.length; index += 2) {
    const name = argv[index];
    const value = argv[index + 1];
    if (!allowed.has(name) || value === undefined) {
      fail('usage: agent-host-tunnel --endpoint IPV4:PORT --token 64HEX --ports P[,P...] [--ready-fd N]');
    }
    if (values.has(name)) fail(`duplicate option: ${name}`);
    values.set(name, value);
  }

  const endpoint = values.get('--endpoint') ?? '';
  const match = /^((?:\d{1,3}\.){3}\d{1,3}):(\d{1,5})$/.exec(endpoint);
  if (!match) fail('--endpoint must be one IPv4:port');
  const host = match[1];
  if (host.split('.').some((octet) => Number(octet) > 255)) fail('--endpoint host is not IPv4');
  const endpointPort = Number(match[2]);
  if (endpointPort < 1 || endpointPort > 65535) fail('--endpoint port is out of range');

  const token = values.get('--token') ?? '';
  if (!TOKEN_PATTERN.test(token)) fail('--token must be 64 lowercase hex characters');

  const portsText = values.get('--ports') ?? '';
  const ports = [];
  for (const part of portsText.split(',')) {
    if (!/^[1-9][0-9]{0,4}$/.test(part) || Number(part) > 65535) {
      fail('--ports must be a comma-separated list of TCP ports');
    }
    const port = Number(part);
    if (!ports.includes(port)) ports.push(port);
  }
  if (ports.length === 0) fail('--ports must list at least one port');

  let readyFd = null;
  if (values.has('--ready-fd')) {
    const text = values.get('--ready-fd');
    if (!/^[0-9]{1,3}$/.test(text)) fail('--ready-fd must be a small descriptor number');
    readyFd = Number(text);
  }

  return { host, endpointPort, token, ports, readyFd };
}

function relayConnection(local, configuration, port, live) {
  if (live.size >= MAX_CONNECTIONS) {
    local.destroy();
    return;
  }
  live.add(local);
  local.on('error', () => local.destroy());
  local.setNoDelay(true);
  local.pause();

  const upstream = net.connect({
    host: configuration.host,
    port: configuration.endpointPort,
    allowHalfOpen: true,
  });
  const connectTimer = setTimeout(() => upstream.destroy(new Error('connect timeout')), CONNECT_TIMEOUT_MS);
  const closeBoth = () => {
    clearTimeout(connectTimer);
    local.destroy();
    upstream.destroy();
  };
  local.on('close', () => {
    live.delete(local);
    upstream.destroy();
  });
  upstream.on('error', closeBoth);
  upstream.on('close', closeBoth);
  upstream.once('connect', () => {
    clearTimeout(connectTimer);
    upstream.setNoDelay(true);
    upstream.write(`AGENT-CONTAINER-TUNNEL/1 ${configuration.token} ${port}\n`);
    local.pipe(upstream);
    upstream.pipe(local);
    local.resume();
  });
}

function main() {
  const configuration = parseArguments(process.argv.slice(2));
  const live = new Set();
  const servers = [];
  let bound = 0;

  const onAllBound = () => {
    if (configuration.readyFd === null) return;
    try {
      // One byte, best effort: the launcher only waits for readability.
      writeSync(configuration.readyFd, '1');
    } catch {
      // The launcher also polls the ports, so readiness is not fatal here.
    }
  };

  for (const port of configuration.ports) {
    const server = net.createServer({ allowHalfOpen: true }, (local) => {
      relayConnection(local, configuration, port, live);
    });
    server.on('error', (error) => fail(`cannot listen on 127.0.0.1:${port}: ${error.message}`));
    server.listen({ host: '127.0.0.1', port, exclusive: true }, () => {
      bound += 1;
      if (bound === configuration.ports.length) onAllBound();
    });
    servers.push(server);
  }

  const shutdown = () => {
    for (const server of servers) server.close();
    for (const socket of live) socket.destroy();
    process.exit(0);
  };
  for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
    process.on(signal, shutdown);
  }
}

main();
