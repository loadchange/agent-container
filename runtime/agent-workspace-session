#!/bin/bash
set -euo pipefail

fail() {
  printf 'agent-workspace-session: %s\n' "$*" >&2
  exit 64
}

warn() {
  printf '%s\n' "$*" >&2
}

[ "$EUID" -eq 0 ] \
  || fail 'the workspace session helper must run as root.'

readonly namespace_sentinel=--agent-workspace-private-mount-namespace
if [ "${1:-}" != "$namespace_sentinel" ]; then
  [ "$#" -ge 5 ] \
    || fail 'usage: agent-workspace-session ROOT CWD UID GID PROFILE_COMMAND [Agent args...]'
  session_script=$(/usr/bin/readlink -f -- "$0") \
    || fail 'cannot resolve the workspace session helper.'
  case "$session_script" in /*) ;; *) fail 'workspace session helper is not absolute.' ;; esac
  parent_mount_namespace=$(/usr/bin/readlink -- /proc/self/ns/mnt) \
    || fail 'cannot inspect the current mount namespace.'
  exec /usr/bin/unshare \
    --mount \
    --propagation private \
    -- "$session_script" \
    "$namespace_sentinel" \
    "$parent_mount_namespace" \
    "$@"
fi

shift
[ "$#" -ge 6 ] \
  || fail 'private mount-namespace handoff is incomplete.'
parent_mount_namespace=$1
shift
current_mount_namespace=$(/usr/bin/readlink -- /proc/self/ns/mnt) \
  || fail 'cannot inspect the private mount namespace.'
case "$parent_mount_namespace:$current_mount_namespace" in
  '':*|*:''|*[!A-Za-z0-9_:\[\]-]*)
    fail 'mount-namespace identity is malformed.'
    ;;
esac
[ "$current_mount_namespace" != "$parent_mount_namespace" ] \
  || fail 'unshare did not create a private mount namespace.'

workspace_root=$1
workspace_cwd=$2
runtime_uid=$3
runtime_gid=$4
profile_command=$5
shift 5
agent_arguments=("$@")

validate_normal_absolute_path() {
  local label=$1
  local path=$2
  local normalized

  case "$path" in
    /*) ;;
    *) fail "$label must be absolute." ;;
  esac
  case "$path" in
    *$'\n'*|*$'\r'*|*$'\t'*) fail "$label contains a control character." ;;
  esac
  [ "${#path}" -le 4096 ] || fail "$label exceeds PATH_MAX."
  normalized=$(/usr/bin/realpath -m -- "$path") \
    || fail "$label cannot be normalized."
  [ "$normalized" = "$path" ] \
    || fail "$label must already be canonical and lexically normalized."
}

validate_normal_absolute_path ROOT "$workspace_root"
validate_normal_absolute_path CWD "$workspace_cwd"
case "$workspace_root" in
  /|/bin|/bin/*|/boot|/boot/*|/dev|/dev/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*|/proc|/proc/*|/run|/run/*|/sbin|/sbin/*|/sys|/sys/*|/usr|/usr/*)
    fail 'ROOT overlaps a protected guest system tree.'
    ;;
esac
case "$workspace_cwd" in
  "$workspace_root"|"$workspace_root"/*) ;;
  *) fail 'CWD is outside ROOT.' ;;
esac

validate_numeric_identity() {
  local label=$1
  local value=$2
  case "$value" in
    [1-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
    *) fail "$label must be a positive canonical decimal integer." ;;
  esac
  [ "$((10#$value))" -le 2147483647 ] \
    || fail "$label is outside the supported identity range."
}
validate_numeric_identity UID "$runtime_uid"
validate_numeric_identity GID "$runtime_gid"

runtime_passwd_record=$(/usr/bin/getent passwd "$runtime_uid" || true)
[ -n "$runtime_passwd_record" ] \
  || fail "UID $runtime_uid has no guest passwd record."
[ "$(printf '%s\n' "$runtime_passwd_record" | /usr/bin/wc -l)" -eq 1 ] \
  || fail "UID $runtime_uid has duplicate guest passwd records."
runtime_user=$(printf '%s\n' "$runtime_passwd_record" | /usr/bin/cut -d: -f1)
runtime_passwd_gid=$(printf '%s\n' "$runtime_passwd_record" | /usr/bin/cut -d: -f4)
runtime_home=$(printf '%s\n' "$runtime_passwd_record" | /usr/bin/cut -d: -f6)
[ "$runtime_passwd_gid" = "$runtime_gid" ] \
  || fail 'requested GID differs from the guest passwd record.'
case "$runtime_user:$runtime_home" in
  :*|*:|*$'\n'*|*$'\r'*|*$'\t'*) fail 'guest passwd identity is unsafe.' ;;
esac
case "$runtime_home" in /*) ;; *) fail 'guest passwd HOME is not absolute.' ;; esac
[ -d "$runtime_home" ] && [ ! -L "$runtime_home" ] \
  || fail 'isolated Agent HOME is unavailable.'

case "$profile_command" in
  ''|.|..|[!A-Za-z0-9]*|*[!A-Za-z0-9._+-]*)
    fail 'PROFILE_COMMAND must be one safe executable basename.'
    ;;
esac
[ "${#profile_command}" -le 64 ] \
  || fail 'PROFILE_COMMAND is too long.'
agent_executable=$(type -P -- "$profile_command" || true)
case "$agent_executable" in /*) ;; *) fail 'PROFILE_COMMAND is not installed.' ;; esac
agent_executable=$(/usr/bin/readlink -f -- "$agent_executable") \
  || fail 'PROFILE_COMMAND cannot be resolved.'
[ -f "$agent_executable" ] && [ -x "$agent_executable" ] \
  || fail 'PROFILE_COMMAND does not resolve to an executable file.'
[ "$(/usr/bin/stat -c '%u' -- "$agent_executable")" -eq 0 ] \
  || fail 'PROFILE_COMMAND is not owned by root.'
agent_mode=$(/usr/bin/stat -c '%a' -- "$agent_executable")
case "$agent_mode" in ''|*[!0-7]*) fail 'PROFILE_COMMAND has an invalid mode.' ;; esac
[ "$(((8#$agent_mode) & 8#22))" -eq 0 ] \
  || fail 'PROFILE_COMMAND is writable by group or other.'
case "$agent_executable" in
  "$workspace_root"|"$workspace_root"/*)
    fail 'PROFILE_COMMAND may not be supplied by the writable workspace.'
    ;;
esac

workspace_endpoint="${AGENT_WORKSPACE_ENDPOINT:-}"
workspace_token="${AGENT_WORKSPACE_TOKEN:-}"
unset AGENT_WORKSPACE_ENDPOINT AGENT_WORKSPACE_TOKEN
[ -n "$workspace_endpoint" ] \
  || fail 'AGENT_WORKSPACE_ENDPOINT is missing.'
[[ "$workspace_token" =~ ^[0-9a-f]{64}$ ]] \
  || fail 'AGENT_WORKSPACE_TOKEN must contain exactly 64 lowercase hexadecimal characters.'

# Full host access is an explicit, launcher-set per-client capability. In this
# mode ROOT is the whole host filesystem mounted at a guest mount point (/host),
# the launcher additionally mirrors selected host directories at their own
# absolute paths, and the host-tool channel runs its commands unsandboxed. The
# marker only takes effect when the launcher set it; a guest-forged value never
# reaches this helper because the environment is scrubbed by the launcher.
host_full_access=false
case "${AGENT_WORKSPACE_FULL_ACCESS:-0}" in
  0|'') ;;
  1) host_full_access=true ;;
  *) fail 'AGENT_WORKSPACE_FULL_ACCESS must be 0 or 1.' ;;
esac
unset AGENT_WORKSPACE_FULL_ACCESS
# Optional comma-separated extra absolute host paths to mirror at identical
# guest paths, beyond the automatically chosen host top-level directories.
host_mirror_spec="${AGENT_WORKSPACE_HOST_MIRROR:-}"
unset AGENT_WORKSPACE_HOST_MIRROR
case "$host_mirror_spec" in
  *$'\n'*|*$'\r'*|*$'\t'*) fail 'AGENT_WORKSPACE_HOST_MIRROR contains a control character.' ;;
esac
if [ "$host_full_access" = false ] && [ -n "$host_mirror_spec" ]; then
  fail 'AGENT_WORKSPACE_HOST_MIRROR requires full host access.'
fi

# The optional host-tool channel arrives on the same private environment
# path as the workspace transport. Both fields must agree; a partial handoff
# is treated as corruption rather than silently ignored. The command catalog
# itself is retrieved from the authenticated broker rather than trusted from
# an environment value.
host_exec_endpoint="${AGENT_WORKSPACE_HOST_EXEC_ENDPOINT:-}"
host_exec_token="${AGENT_WORKSPACE_HOST_EXEC_TOKEN:-}"
unset AGENT_WORKSPACE_HOST_EXEC_ENDPOINT \
  AGENT_WORKSPACE_HOST_EXEC_TOKEN
host_exec_requested=false
host_exec_host=""
host_exec_port=""
if [ -n "$host_exec_endpoint$host_exec_token" ]; then
  host_exec_requested=true
  case "$host_exec_endpoint" in
    ''|*$'\n'*|*$'\r'*|*$'\t'*|*:*:*)
      fail 'AGENT_WORKSPACE_HOST_EXEC_ENDPOINT must be one IPv4:port endpoint.'
      ;;
  esac
  [ "${#host_exec_endpoint}" -le 21 ] \
    || fail 'AGENT_WORKSPACE_HOST_EXEC_ENDPOINT is too long for IPv4:port.'
  case "$host_exec_endpoint" in
    [0-9]*.*.*.*:[1-9]*) ;;
    *) fail 'AGENT_WORKSPACE_HOST_EXEC_ENDPOINT must be one IPv4:port endpoint.' ;;
  esac
  host_exec_host=${host_exec_endpoint%:*}
  host_exec_port=${host_exec_endpoint##*:}
  case "$host_exec_host" in
    *[!0-9.]*|''|.*|*..*|*.)
      fail 'AGENT_WORKSPACE_HOST_EXEC_ENDPOINT host is not IPv4.'
      ;;
  esac
  case "$host_exec_port" in
    *[!0-9]*|'')
      fail 'AGENT_WORKSPACE_HOST_EXEC_ENDPOINT port is not decimal.'
      ;;
  esac
  [ "$host_exec_port" -ge 1 ] && [ "$host_exec_port" -le 65535 ] \
    || fail 'AGENT_WORKSPACE_HOST_EXEC_ENDPOINT port is outside 1..65535.'
  [[ "$host_exec_token" =~ ^[0-9a-f]{64}$ ]] \
    || fail 'AGENT_WORKSPACE_HOST_EXEC_TOKEN must contain exactly 64 lowercase hexadecimal characters.'
fi

for required_path in \
  /dev/fuse \
  /etc/fuse.conf \
  /usr/bin/findmnt \
  /usr/bin/fusermount3 \
  /usr/bin/mountpoint \
  /usr/bin/ps \
  /usr/bin/setpriv \
  /usr/bin/setsid \
  /usr/bin/sshfs \
  /usr/local/bin/agent-host-exec \
  /usr/local/bin/agent-workspace-connect; do
  [ -e "$required_path" ] || fail "required workspace component is absent: $required_path"
done
[ -c /dev/fuse ] && [ -r /dev/fuse ] && [ -w /dev/fuse ] \
  || fail '/dev/fuse is not an accessible character device.'
[ -f /etc/fuse.conf ] && [ ! -L /etc/fuse.conf ] \
  && /bin/grep -Eq '^[[:space:]]*user_allow_other[[:space:]]*$' /etc/fuse.conf \
  || fail '/etc/fuse.conf does not enable user_allow_other.'
[ -x /usr/bin/sshfs ] && [ -x /usr/bin/fusermount3 ] \
  && [ -x /usr/local/bin/agent-workspace-connect ] \
  || fail 'workspace transport executables are unavailable.'
for cgroup_component in \
  /sys/fs/cgroup/cgroup.controllers \
  /sys/fs/cgroup/cgroup.events \
  /sys/fs/cgroup/cgroup.freeze \
  /sys/fs/cgroup/cgroup.procs; do
  [ -e "$cgroup_component" ] && [ ! -L "$cgroup_component" ] \
    || fail "required cgroup v2 component is absent: $cgroup_component"
done
[ -r /sys/fs/cgroup/cgroup.controllers ] \
  && [ -r /sys/fs/cgroup/cgroup.events ] \
  && [ -w /sys/fs/cgroup/cgroup.freeze ] \
  && [ -w /sys/fs/cgroup/cgroup.procs ] \
  || fail 'the cgroup v2 process-containment boundary is unavailable.'

mountpoint_created=false
# The host launcher intentionally uses a private umask.  Do not inherit it for
# guest-only path placeholders: the unprivileged Agent must be able to traverse
# every missing ancestor to reach the SSHFS mount, while directory listings of
# those placeholders remain unavailable.
# Create missing ancestors first, then claim only the final mountpoint with one
# atomic mkdir.  If another session wins that mkdir race, its directory is
# treated as pre-existing and this helper will never remove it during cleanup.
workspace_parent=$(/usr/bin/dirname -- "$workspace_root") \
  || fail 'cannot resolve the ROOT parent directory.'
(umask 0066; /usr/bin/mkdir -p -- "$workspace_parent")
if (umask 0066; /usr/bin/mkdir -- "$workspace_root") 2>/dev/null; then
  mountpoint_created=true
fi
[ -d "$workspace_root" ] && [ ! -L "$workspace_root" ] \
  || fail 'ROOT is not a safe directory mountpoint.'
[ "$(/usr/bin/realpath -e -- "$workspace_root")" = "$workspace_root" ] \
  || fail 'ROOT traverses a guest symlink.'
if /usr/bin/mountpoint -q -- "$workspace_root"; then
  fail 'ROOT is already a mountpoint in this session namespace.'
fi
# Ordinary shadow-HOME content below ROOT is safe to cover: this process is
# already in a private mount namespace, and unmounting SSHFS reveals the
# untouched underlying tree.  An existing child mount is rejected so teardown
# and restoration never depend on inherited, temporarily hidden guest mount
# topology.  Mountinfo escapes backslashes and spaces in target fields as \134
# and \040 respectively.
[ -r /proc/self/mountinfo ] \
  || fail 'the private mount table is unavailable.'
workspace_root_mountinfo=${workspace_root//\\/\\134}
workspace_root_mountinfo=${workspace_root_mountinfo// /\\040}
while IFS=' ' read -r \
  mount_id parent_id mount_device mount_source mount_target mount_rest; do
  case "$mount_target" in
    "$workspace_root_mountinfo"/*)
      fail 'ROOT contains an existing nested mount in this session namespace.'
      ;;
  esac
done < /proc/self/mountinfo

sshfs_pid=
agent_pid=
agent_pgid=
agent_waited=false
agent_identity_ready=false
agent_identity_file=
agent_cgroup=
agent_start_fifo=
agent_start_reader_open=false
agent_start_writer_open=false
background_launching=false
pending_signal_status=
workspace_mounted=false
session_runtime_dir=
session_control_dir=
# Full host access bookkeeping. host_mirror_mounts and host_mirror_dirs are
# stacks (one array element per path, so spaces and glob characters survive)
# unwound in reverse by remove_host_mirrors; host_tunnel_pid is the guest
# loopback forwarder; agent_start_cwd is where the Agent is finally started.
host_mirror_mounts=()
host_mirror_dirs=()
host_tunnel_pid=
agent_start_cwd=

load_agent_identity() {
  local identity_pid identity_sid identity_pgid identity_extra

  [ "$agent_identity_ready" = false ] || return 0
  [ -n "$agent_pid" ] && [ -n "$agent_pgid" ] || return 1
  [ -n "$agent_identity_file" ] && [ -s "$agent_identity_file" ] \
    || return 1
  [ "$(/usr/bin/wc -l < "$agent_identity_file")" -eq 1 ] 2>/dev/null \
    || return 1
  IFS=$'\t' read -r \
    identity_pid identity_sid identity_pgid identity_extra \
    < "$agent_identity_file" \
    || return 1
  case "$identity_pid:$identity_sid:$identity_pgid" in
    *[!0-9:]*|:*|*::*|*:)
      return 1
      ;;
  esac
  [ -z "$identity_extra" ] \
    && [ "$identity_pid" = "$identity_sid" ] \
    && [ "$identity_pid" = "$identity_pgid" ] \
    && [ "$identity_pid" = "$agent_pid" ] \
    && [ "$identity_pgid" = "$agent_pgid" ] \
    || return 1

  agent_identity_ready=true
  return 0
}

cgroup_has_agent_processes() {
  [ -n "$agent_cgroup" ] \
    && [ -r "$agent_cgroup/cgroup.events" ] \
    && /bin/grep -Fqx 'populated 1' "$agent_cgroup/cgroup.events" 2>/dev/null
}

child_job_is_active() {
  local wanted_pid=$1
  local active_pid job_state

  [ -n "$wanted_pid" ] || return 1
  for job_state in -pr -ps; do
    while IFS= read -r active_pid; do
      [ "$active_pid" = "$wanted_pid" ] && return 0
    done < <(jobs "$job_state" 2>/dev/null)
  done
  return 1
}

term_agent_cgroup_processes() {
  local contained_pid freeze_attempt malformed_pid

  cgroup_has_agent_processes || return 0
  printf '1\n' > "$agent_cgroup/cgroup.freeze" 2>/dev/null \
    || return 1

  # Freezing the leaf prevents a member from exiting and having its numeric PID
  # reused between membership enumeration and kill(2). No new descendant can
  # appear while every current task is frozen, either. Queue TERM to the exact
  # cgroup membership, then unfreeze so ordinary signal handlers get one second
  # to finish. If freeze cannot converge, skip unsafe PID/PGID signalling and
  # rely on the atomic cgroup.kill boundary below.
  freeze_attempt=0
  while ! /bin/grep -Fqx 'frozen 1' \
      "$agent_cgroup/cgroup.events" 2>/dev/null \
    && [ "$freeze_attempt" -lt 100 ]; do
    /bin/sleep 0.01
    freeze_attempt=$((freeze_attempt + 1))
  done
  if ! /bin/grep -Fqx 'frozen 1' \
      "$agent_cgroup/cgroup.events" 2>/dev/null; then
    printf '0\n' > "$agent_cgroup/cgroup.freeze" 2>/dev/null || true
    return 1
  fi

  malformed_pid=false
  while IFS= read -r contained_pid; do
    case "$contained_pid" in
      ''|0|*[!0-9]*)
        malformed_pid=true
        continue
        ;;
    esac
    kill -TERM "$contained_pid" 2>/dev/null || true
  done < "$agent_cgroup/cgroup.procs"
  printf '0\n' > "$agent_cgroup/cgroup.freeze" 2>/dev/null || true
  [ "$malformed_pid" = false ]
}

stop_agent_processes() {
  local retry

  term_agent_cgroup_processes || true

  retry=0
  while cgroup_has_agent_processes && [ "$retry" -lt 20 ]; do
    /bin/sleep 0.05
    retry=$((retry + 1))
  done

  if cgroup_has_agent_processes; then
    printf '1\n' > "$agent_cgroup/cgroup.kill" 2>/dev/null || true
  fi

  if [ -n "$agent_pid" ] && [ "$agent_waited" = false ]; then
    wait "$agent_pid" 2>/dev/null || true
    agent_waited=true
  fi

  # SIGKILL cannot be handled. Keep the FUSE transport and mount alive until
  # the kernel confirms that this cgroup contains no Agent process. This is
  # intentionally fail-closed for an uninterruptible guest process.
  while cgroup_has_agent_processes; do
    printf '1\n' > "$agent_cgroup/cgroup.kill" 2>/dev/null || true
    /bin/sleep 0.05
  done

  agent_pid=
  agent_pgid=
  agent_identity_ready=false
}

# --- host mirror functions begin ---
# Full host access: mirror selected host directories at their own absolute
# guest paths so macOS-style paths (/Users/... , /Volumes/...) resolve the same
# content the Agent sees under /host. Each mirror is a bind mount of a /host
# subtree inside this session's private mount namespace. Mounting is
# best-effort: a directory that cannot be mirrored warns and is skipped rather
# than aborting the session, and every function here returns 0 so `set -e`
# can never turn a skipped mirror into a dead session.
#
# A guest path that already holds content is never covered. Instead the merge
# descends one level and mirrors the children that do not collide, to a
# bounded depth. That is what makes the operator's home work: the guest's
# /Users/<name> is the profile's persistent shadow HOME (a VirtioFS mount), so
# /Users cannot be covered; descending mirrors /Users/<name>/project,
# Documents, and the other real home directories into it, while dot-entries
# (the shadow HOME's own Linux-side state and the host's macOS dotfiles) stay
# exactly as they are. Only directories are mirrored; a loose file in the
# home remains reachable under /host.
#
# host_mirror_guest_root is a test seam: mirror targets are placed below it so
# the merge logic can be exercised against a scratch tree. It is empty in
# production.
host_mirror_guest_root=""
readonly HOST_MIRROR_MAX_DEPTH=2

mirror_target_is_protected() {
  case "$1" in
    /|"$workspace_root"|"$workspace_root"/* ) return 0 ;;
    /bin|/bin/*|/boot|/boot/*|/dev|/dev/*|/etc|/etc/*|/home|/home/*) return 0 ;;
    /lib|/lib/*|/lib64|/lib64/*|/proc|/proc/*|/root|/root/*|/run|/run/*) return 0 ;;
    /sbin|/sbin/*|/sys|/sys/*|/tmp|/tmp/*|/usr|/usr/*|/var|/var/*) return 0 ;;
    /workspace|/workspace/*) return 0 ;;
  esac
  return 1
}

add_host_mirror() {
  local host_path="$1"
  local depth="${2:-0}"
  local source="$workspace_root$host_path"
  local target="$host_mirror_guest_root$host_path"
  local created_dir=false
  local resolved_source child existing

  case "$host_path" in
    /*) ;;
    *) return 0 ;;
  esac
  case "$host_path" in
    *$'\n'*|*$'\r'*|*$'\t'*|*//*|*/..*|*/.) return 0 ;;
  esac
  if mirror_target_is_protected "$host_path"; then
    warn "agent-workspace-session: refusing to mirror a protected guest path: $host_path"
    return 0
  fi
  # A path at or below one of this session's mirrors already shows the host
  # content; mirroring it again would only nest a redundant bind. This also
  # makes a repeated create_host_mirrors call a no-op.
  if [ "${#host_mirror_mounts[@]}" -gt 0 ]; then
    for existing in "${host_mirror_mounts[@]}"; do
      case "$target" in
        "$existing"|"$existing"/*) return 0 ;;
      esac
    done
  fi
  # The source must be a real directory under /host and must not escape it.
  if [ ! -d "$source" ] || [ -L "$source" ]; then
    return 0
  fi
  resolved_source=$(/usr/bin/realpath -e -- "$source" 2>/dev/null || true)
  case "$resolved_source" in
    "$workspace_root"|"$workspace_root"/*) ;;
    *) return 0 ;;
  esac

  if [ ! -e "$target" ]; then
    # A placeholder mountpoint. It is owned by the Agent so that, should the
    # session ever end without cleanup, the empty leftover is the user's own.
    if ! (umask 0022; /usr/bin/mkdir -- "$target") 2>/dev/null; then
      warn "agent-workspace-session: cannot create mirror point $target"
      return 0
    fi
    /usr/bin/chown "$runtime_uid:$runtime_gid" -- "$target" 2>/dev/null || true
    created_dir=true
  elif [ -d "$target" ] && [ ! -L "$target" ]; then
    if /usr/bin/mountpoint -q -- "$target" 2>/dev/null \
      || [ -n "$(/usr/bin/ls -A -- "$target" 2>/dev/null)" ]; then
      # Existing guest content (a mount such as the shadow HOME, or an
      # image-provided tree) is merged into, never covered: mirror each
      # non-hidden child directory that does not itself collide.
      if [ "$depth" -ge "$HOST_MIRROR_MAX_DEPTH" ]; then
        return 0
      fi
      for child in "$source"/*; do
        if [ -d "$child" ] && [ ! -L "$child" ]; then
          add_host_mirror "$host_path/${child##*/}" $((depth + 1))
        fi
      done
      return 0
    fi
  else
    return 0
  fi

  if /usr/bin/mount --bind -- "$source" "$target" 2>/dev/null; then
    host_mirror_mounts+=("$target")
    if [ "$created_dir" = true ]; then
      host_mirror_dirs+=("$target")
    fi
  else
    warn "agent-workspace-session: cannot mirror $source at $target"
    if [ "$created_dir" = true ]; then
      /usr/bin/rmdir -- "$target" 2>/dev/null || true
    fi
  fi
  return 0
}

create_host_mirrors() {
  local auto_name explicit_path saved_ifs
  # Standard macOS top-level directories that do not collide with the Linux
  # guest's own system trees.
  for auto_name in Users Volumes Applications Library System private cores Network; do
    if [ -e "$workspace_root/$auto_name" ]; then
      add_host_mirror "/$auto_name"
    fi
  done
  # Operator-selected additional paths (comma-separated absolute host paths).
  if [ -n "$host_mirror_spec" ]; then
    saved_ifs="$IFS"
    IFS=,
    for explicit_path in $host_mirror_spec; do
      if [ -n "$explicit_path" ]; then
        add_host_mirror "$explicit_path"
      fi
    done
    IFS="$saved_ifs"
  fi
  return 0
}

# Unwind the mirrors innermost first. A mirror is a bind mount of a /host
# subpath, so every mirror must be gone before SSHFS leaves /host, and only the
# placeholder mountpoints this helper created are removed.
remove_host_mirrors() {
  local index target
  if [ "${#host_mirror_mounts[@]}" -gt 0 ]; then
    for ((index = ${#host_mirror_mounts[@]} - 1; index >= 0; index--)); do
      target=${host_mirror_mounts[index]}
      if /usr/bin/mountpoint -q -- "$target" 2>/dev/null; then
        /usr/bin/umount -- "$target" 2>/dev/null \
          || /usr/bin/umount -l -- "$target" 2>/dev/null || true
      fi
    done
  fi
  host_mirror_mounts=()
  if [ "${#host_mirror_dirs[@]}" -gt 0 ]; then
    for ((index = ${#host_mirror_dirs[@]} - 1; index >= 0; index--)); do
      /usr/bin/rmdir -- "${host_mirror_dirs[index]}" 2>/dev/null || true
    done
  fi
  host_mirror_dirs=()
  return 0
}

# With the identical-path mirrors in place, start the Agent in the real host
# path whenever that path is backed by a mirror: pwd and every absolute path a
# tool prints then match the host, and host commands resolve the cwd directly.
# Otherwise the /host form remains the working directory.
select_agent_start_cwd() {
  local native_cwd="${workspace_cwd#"$workspace_root"}"
  local candidate mirror
  agent_start_cwd="$workspace_cwd"
  [ "$host_full_access" = true ] || return 0
  case "$native_cwd" in
    /*) ;;
    *) return 0 ;;
  esac
  candidate="$host_mirror_guest_root$native_cwd"
  if [ "${#host_mirror_mounts[@]}" -gt 0 ]; then
    for mirror in "${host_mirror_mounts[@]}"; do
      case "$candidate" in
        "$mirror"|"$mirror"/*)
          if [ -d "$candidate" ] && [ ! -L "$candidate" ]; then
            agent_start_cwd="$candidate"
          fi
          return 0
          ;;
      esac
    done
  fi
  return 0
}
# --- host mirror functions end ---

cleanup() {
  local retry
  set +e
  trap '' INT TERM HUP
  trap - EXIT

  if [ "$agent_start_reader_open" = true ]; then
    exec 8<&-
    agent_start_reader_open=false
  fi
  if [ "$agent_start_writer_open" = true ]; then
    exec 7>&-
    agent_start_writer_open=false
  fi

  stop_agent_processes

  if [ -n "$agent_cgroup" ]; then
    case "$agent_cgroup" in
      /sys/fs/cgroup/agent-container-"$runtime_uid"-*)
        /usr/bin/rmdir -- "$agent_cgroup" 2>/dev/null || true
        ;;
    esac
  fi
  agent_cgroup=

  # Full host access teardown, innermost first: stop the loopback forwarder,
  # then unwind the identical-path mirrors in reverse (a mirror is a bind mount
  # of a /host subpath, so every mirror must be gone before SSHFS leaves /host),
  # removing only the mountpoints this helper created.
  if [ -n "$host_tunnel_pid" ]; then
    kill -TERM "$host_tunnel_pid" 2>/dev/null || true
    wait "$host_tunnel_pid" 2>/dev/null || true
    host_tunnel_pid=
  fi
  remove_host_mirrors

  # The helper entered the FUSE tree before starting the Agent. Leave it before
  # asking SSHFS to exit so libfuse can perform the normal, single unmount.
  # A shell-side unmount first would race libfuse's own teardown and leak a
  # misleading "failed to unmount: Invalid argument" warning to every client.
  cd / 2>/dev/null || true

  if [ -n "$sshfs_pid" ] && child_job_is_active "$sshfs_pid"; then
    kill -TERM "$sshfs_pid" 2>/dev/null || true
    retry=0
    while child_job_is_active "$sshfs_pid" && [ "$retry" -lt 20 ]; do
      /bin/sleep 0.05
      retry=$((retry + 1))
    done
    if child_job_is_active "$sshfs_pid"; then
      kill -KILL "$sshfs_pid" 2>/dev/null || true
    fi
  fi
  [ -z "$sshfs_pid" ] || wait "$sshfs_pid" 2>/dev/null || true
  sshfs_pid=

  # TERM is the normal owner of the FUSE teardown. Retain an explicit fallback
  # for a crashed or forcibly killed SSHFS process that leaves a mount behind.
  if /usr/bin/mountpoint -q -- "$workspace_root" 2>/dev/null; then
    /usr/bin/fusermount3 -u -- "$workspace_root" 2>/dev/null \
      || /usr/bin/umount -- "$workspace_root" 2>/dev/null \
      || /usr/bin/umount -l -- "$workspace_root" 2>/dev/null \
      || true
  fi
  workspace_mounted=false

  if [ -n "$session_runtime_dir" ]; then
    case "$session_runtime_dir" in
      /run/agent-container/session-"$runtime_uid"-*)
        /bin/rm -rf -- "$session_runtime_dir" 2>/dev/null || true
        ;;
    esac
  fi
  session_runtime_dir=

  if [ -n "$session_control_dir" ]; then
    case "$session_control_dir" in
      /run/agent-container/control-"$runtime_uid"-*)
        /bin/rm -rf -- "$session_control_dir" 2>/dev/null || true
        ;;
    esac
  fi
  session_control_dir=
  agent_identity_file=
  agent_start_fifo=

  if /usr/bin/mountpoint -q -- "$workspace_root" 2>/dev/null; then
    /usr/bin/umount -l -- "$workspace_root" 2>/dev/null || true
  fi
  if [ "$mountpoint_created" = true ]; then
    /usr/bin/rmdir -- "$workspace_root" 2>/dev/null || true
  fi
  return 0
}

handle_signal() {
  local signal_status=$1
  if [ "$background_launching" = true ]; then
    [ -n "$pending_signal_status" ] \
      || pending_signal_status=$signal_status
    return 0
  fi
  if [ -n "$pending_signal_status" ]; then
    signal_status=$pending_signal_status
    pending_signal_status=
  fi
  trap '' INT TERM HUP
  set +e
  exit "$signal_status"
}

complete_background_launch() {
  background_launching=false
  if [ -n "$pending_signal_status" ]; then
    handle_signal "$pending_signal_status"
  fi
}

trap cleanup EXIT
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM
trap 'handle_signal 129' HUP

runtime_dir_parent=/run/agent-container
if [ -L "$runtime_dir_parent" ] \
  || { [ -e "$runtime_dir_parent" ] && [ ! -d "$runtime_dir_parent" ]; }; then
  fail 'the session runtime-directory parent is unsafe.'
fi
/usr/bin/install -d -o 0 -g 0 -m 0711 -- "$runtime_dir_parent"
[ "$(/usr/bin/stat -c '%u:%g:%a' -- "$runtime_dir_parent")" = 0:0:711 ] \
  || fail 'the session runtime-directory parent has unsafe ownership or mode.'
session_runtime_dir=$(/usr/bin/mktemp -d \
  "$runtime_dir_parent/session-$runtime_uid-XXXXXXXX") \
  || fail 'cannot create the private session runtime directory.'
case "$session_runtime_dir" in
  /run/agent-container/session-"$runtime_uid"-*) ;;
  *) fail 'the private session runtime directory has an unsafe path.' ;;
esac
/usr/bin/chown "$runtime_uid:$runtime_gid" -- "$session_runtime_dir"
/usr/bin/chmod 0700 -- "$session_runtime_dir"
[ "$(/usr/bin/stat -c '%u:%g:%a' -- "$session_runtime_dir")" \
    = "$runtime_uid:$runtime_gid:700" ] \
  || fail 'the private session runtime directory has unsafe ownership or mode.'

# Host-tool shims and their session credentials live inside the private
# per-session runtime directory: the Agent owns and may read them, other
# sessions never observe them, and normal session cleanup removes them.
# The complete command catalog comes from the authenticated broker. Commands
# the broker marks `first` shadow the guest copies from the front of PATH;
# `fallback` commands sit behind every guest directory so a host command is
# used exactly when the verified guest image does not provide it. Shims are
# tiny root-owned wrapper scripts written by shell builtins: one chmod per
# directory replaces thousands of per-command symlink processes.
host_exec_state_dir=
host_exec_first_dir=
host_exec_fallback_dir=
if [ "$host_exec_requested" = true ]; then
  for host_exec_tool in /usr/bin/head /usr/bin/jq /usr/bin/timeout; do
    [ -x "$host_exec_tool" ] \
      || fail "required host-tool catalog component is absent: $host_exec_tool"
  done
  host_exec_state_dir="$session_runtime_dir/host-exec"
  /usr/bin/install -d -o "$runtime_uid" -g "$runtime_gid" -m 0700 \
    -- "$host_exec_state_dir" \
    || fail 'cannot create the host-exec session directory.'
  (
    umask 077
    printf '%s\n' "$host_exec_endpoint" \
      > "$host_exec_state_dir/host-exec-endpoint" \
      && printf '%s\n' "$host_exec_token" \
        > "$host_exec_state_dir/host-exec-token"
  ) || fail 'cannot publish the host-exec session credentials.'
  /usr/bin/chown "$runtime_uid:$runtime_gid" -- \
    "$host_exec_state_dir/host-exec-endpoint" \
    "$host_exec_state_dir/host-exec-token" \
    || fail 'cannot assign the host-exec session credentials.'

  if ! exec {host_exec_catalog_fd}<>"/dev/tcp/$host_exec_host/$host_exec_port"; then
    fail 'cannot connect to the host-tool broker for the command catalog.'
  fi
  printf '{"v":1,"type":"catalog","token":"%s"}\n' "$host_exec_token" \
    >&"$host_exec_catalog_fd" \
    || fail 'cannot request the host-tool command catalog.'
  host_exec_catalog_response=$(/usr/bin/timeout 15 /usr/bin/head -c 4194304 \
    <&"$host_exec_catalog_fd") \
    || fail 'the host-tool broker did not return the command catalog.'
  exec {host_exec_catalog_fd}<&-
  [ -n "$host_exec_catalog_response" ] \
    || fail 'the host-tool broker returned an empty command catalog.'
  host_exec_catalog_tsv=$(printf '%s\n' "$host_exec_catalog_response" \
    | /usr/bin/jq -er '
      if (type == "object")
        and (.type == "catalog")
        and ((.commands | type) == "array")
        and ((.commands | length) >= 1)
        and ((.commands | length) <= 8192)
        and (all(.commands[];
          (type == "object")
          and ((.mode == "first") or (.mode == "fallback"))
          and ((.name | type) == "string")))
      then .commands[] | "\(.mode)\t\(.name)"
      else error("invalid catalog")
      end') \
    || fail 'the host-tool broker returned an invalid command catalog.'

  host_exec_first_dir="$session_runtime_dir/host-first-bin"
  host_exec_fallback_dir="$session_runtime_dir/host-fallback-bin"
  /usr/bin/install -d -o 0 -g 0 -m 0755 \
    -- "$host_exec_first_dir" "$host_exec_fallback_dir" \
    || fail 'cannot create the host-tool shim directories.'
  host_exec_first_count=0
  host_exec_fallback_count=0
  while IFS=$'\t' read -r host_exec_mode host_exec_command; do
    case "$host_exec_command" in
      ''|.|..|[!A-Za-z0-9]*|*[!A-Za-z0-9._+-]*)
        fail 'the host-tool catalog contains an unsafe command name.'
        ;;
    esac
    [ "${#host_exec_command}" -le 64 ] \
      || fail 'the host-tool catalog contains an oversized command name.'
    case "$host_exec_mode" in
      first) host_exec_shim_dir="$host_exec_first_dir" ;;
      fallback) host_exec_shim_dir="$host_exec_fallback_dir" ;;
      *) fail 'the host-tool catalog contains an invalid command mode.' ;;
    esac
    if [ -e "$host_exec_first_dir/$host_exec_command" ] \
      || [ -e "$host_exec_fallback_dir/$host_exec_command" ]; then
      fail 'the host-tool catalog contains a duplicate command name.'
    fi
    printf '%s\n' '#!/bin/bash' \
      'exec /usr/local/bin/agent-host-exec "${0##*/}" "$@"' \
      > "$host_exec_shim_dir/$host_exec_command" \
      || fail 'cannot create a host-tool command shim.'
    if [ "$host_exec_mode" = first ]; then
      host_exec_first_count=$((host_exec_first_count + 1))
    else
      host_exec_fallback_count=$((host_exec_fallback_count + 1))
    fi
  done <<EOF
$host_exec_catalog_tsv
EOF
  [ "$host_exec_first_count" -eq 0 ] \
    || /bin/chmod 0755 -- "$host_exec_first_dir"/* \
    || fail 'cannot publish the host-first command shims.'
  [ "$host_exec_fallback_count" -eq 0 ] \
    || /bin/chmod 0755 -- "$host_exec_fallback_dir"/* \
    || fail 'cannot publish the host-fallback command shims.'

  if [ "$host_full_access" = true ]; then
    # The guest client reads this marker to apply the full-access environment
    # policy (forward everything except guest-only names) instead of the
    # sandboxed one. Writing it here, next to the credentials, keeps it inside
    # the Agent-owned private runtime directory.
    (umask 077; printf 'full\n' > "$host_exec_state_dir/host-exec-mode") \
      && /usr/bin/chown "$runtime_uid:$runtime_gid" -- \
        "$host_exec_state_dir/host-exec-mode" \
      || fail 'cannot publish the host-exec access marker.'

    # The broker reports its loopback tunnel in the same catalog response. When
    # present, start one guest forwarder for the allowlisted ports so guest
    # tools reach the operator's real adb server and other loopback services.
    host_tunnel_port=$(printf '%s\n' "$host_exec_catalog_response" \
      | /usr/bin/jq -er '.tunnel.port // empty | select(type=="number")' 2>/dev/null || true)
    host_tunnel_ports=$(printf '%s\n' "$host_exec_catalog_response" \
      | /usr/bin/jq -er '
          (.tunnel.ports // []) | select(type=="array")
          | map(select(type=="number" and . >= 1 and . <= 65535)) | join(",")' \
        2>/dev/null || true)
    if [ -n "$host_tunnel_port" ] && [ -n "$host_tunnel_ports" ]; then
      case "$host_tunnel_port" in
        ''|*[!0-9]*) fail 'the host-tool broker reported an invalid tunnel port.' ;;
      esac
      [ "$host_tunnel_port" -ge 1 ] && [ "$host_tunnel_port" -le 65535 ] \
        || fail 'the host-tool broker reported an out-of-range tunnel port.'
      # The image installs the pinned Node.js release under /usr/local.
      [ -f /usr/local/bin/agent-host-tunnel ] && [ -x /usr/local/bin/node ] \
        || fail 'the loopback forwarder requires /usr/local/bin/node and agent-host-tunnel.'
      # The forwarder is best-effort device-and-service plumbing: if it cannot
      # bind, the Agent still has full filesystem and host-command access, so a
      # failure here warns rather than aborting the session.
      (
        trap '' INT TERM HUP
        exec /usr/bin/setpriv \
          --reuid="$runtime_uid" --regid="$runtime_gid" \
          --clear-groups --no-new-privs \
          /usr/local/bin/node /usr/local/bin/agent-host-tunnel \
          --endpoint "$host_exec_host:$host_tunnel_port" \
          --token "$host_exec_token" \
          --ports "$host_tunnel_ports" \
          < /dev/null
      ) &
      host_tunnel_pid=$!
      host_tunnel_first_port=${host_tunnel_ports%%,*}
      host_tunnel_ready=false
      for host_tunnel_attempt in $(/usr/bin/seq 1 100); do
        kill -0 "$host_tunnel_pid" 2>/dev/null || break
        if (exec 3<>"/dev/tcp/127.0.0.1/$host_tunnel_first_port") 2>/dev/null; then
          exec 3>&- 3<&- 2>/dev/null || true
          host_tunnel_ready=true
          break
        fi
        /bin/sleep 0.05
      done
      if [ "$host_tunnel_ready" != true ]; then
        warn "agent-workspace-session: the host loopback forwarder did not start; host ports ($host_tunnel_ports) are unavailable this session."
        if [ -n "$host_tunnel_pid" ]; then
          kill -TERM "$host_tunnel_pid" 2>/dev/null || true
          wait "$host_tunnel_pid" 2>/dev/null || true
          host_tunnel_pid=
        fi
      fi
    fi
  fi

  host_exec_catalog_response=
  host_exec_catalog_tsv=
fi
host_exec_endpoint=
host_exec_token=
unset host_exec_endpoint host_exec_token

agent_environment=(
  HOME="$runtime_home"
  USER="$runtime_user"
  LOGNAME="$runtime_user"
  XDG_RUNTIME_DIR="$session_runtime_dir"
  PNPM_CONFIG_STORE_DIR=/var/lib/agent-container/pnpm/store
  PNPM_CONFIG_CACHE_DIR=/var/lib/agent-container/pnpm/cache
  PNPM_CONFIG_STATE_DIR=/var/lib/agent-container/pnpm/state
)
if [ -n "$host_exec_first_dir" ]; then
  agent_environment+=(
    PATH="$host_exec_first_dir:${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}:$host_exec_fallback_dir"
    AGENT_HOST_EXEC_DIR="$host_exec_state_dir"
  )
fi

session_control_dir=$(/usr/bin/mktemp -d \
  "$runtime_dir_parent/control-$runtime_uid-XXXXXXXX") \
  || fail 'cannot create the private session control directory.'
case "$session_control_dir" in
  /run/agent-container/control-"$runtime_uid"-*) ;;
  *) fail 'the private session control directory has an unsafe path.' ;;
esac
/usr/bin/chown 0:0 -- "$session_control_dir"
/usr/bin/chmod 0700 -- "$session_control_dir"
[ "$(/usr/bin/stat -c '%u:%g:%a' -- "$session_control_dir")" = 0:0:700 ] \
  || fail 'the private session control directory has unsafe ownership or mode.'
agent_identity_file="$session_control_dir/agent.identity"
agent_cgroup=$(/usr/bin/mktemp -d \
  "/sys/fs/cgroup/agent-container-$runtime_uid-XXXXXXXX") \
  || fail 'cannot create the private Agent cgroup.'
case "$agent_cgroup" in
  /sys/fs/cgroup/agent-container-"$runtime_uid"-*) ;;
  *) fail 'the private Agent cgroup has an unsafe path.' ;;
esac
[ "$(/usr/bin/stat -c '%u:%g:%a' -- "$agent_cgroup")" = 0:0:700 ] \
  && [ -w "$agent_cgroup/cgroup.procs" ] \
  && [ -w "$agent_cgroup/cgroup.kill" ] \
  && [ -w "$agent_cgroup/cgroup.freeze" ] \
  && [ -r "$agent_cgroup/cgroup.events" ] \
  || fail 'the private Agent cgroup has unsafe ownership or access.'
/bin/grep -Fqx 'populated 0' "$agent_cgroup/cgroup.events" \
  || fail 'the private Agent cgroup was unexpectedly populated.'

background_launching=true
# FUSE3 allows an ordinary nonempty mountpoint to be covered by default.  Its
# parser rejects the obsolete FUSE2-only `nonempty` option, so underlay safety
# comes from the private namespace and nested-mount checks above, not a mount
# flag.  Cleanup reveals the untouched underlay and never removes one that
# existed before this session.
env \
  AGENT_WORKSPACE_ENDPOINT="$workspace_endpoint" \
  AGENT_WORKSPACE_TOKEN="$workspace_token" \
  /usr/bin/sshfs \
    agent-container:. \
    "$workspace_root" \
    -f \
    -o allow_other \
    -o attr_timeout=1 \
    -o cache=yes \
    -o cache_timeout=1 \
    -o entry_timeout=1 \
    -o idmap=none \
    -o negative_timeout=1 \
    -o ssh_command=/usr/local/bin/agent-workspace-connect \
    < /dev/null &
sshfs_pid=$!
complete_background_launch
workspace_token=
workspace_endpoint=
unset workspace_token workspace_endpoint

mount_ready=false
for mount_attempt in $(/usr/bin/seq 1 200); do
  if ! child_job_is_active "$sshfs_pid"; then
    set +e
    wait "$sshfs_pid"
    sshfs_status=$?
    set -e
    sshfs_pid=
    fail "sshfs exited before mount readiness (status $sshfs_status)."
  fi
  if /usr/bin/mountpoint -q -- "$workspace_root"; then
    workspace_fstype=$(/usr/bin/findmnt -rn -M "$workspace_root" -o FSTYPE || true)
    case "$workspace_fstype" in
      fuse|fuse.sshfs) mount_ready=true; break ;;
      '') ;;
      *) fail "ROOT was mounted with unexpected filesystem type '$workspace_fstype'." ;;
    esac
  fi
  /bin/sleep 0.05
done
[ "$mount_ready" = true ] \
  || fail 'sshfs did not mount ROOT within 10 seconds.'
workspace_mounted=true

# With the whole host filesystem mounted at ROOT, publish the identical-path
# mirrors so the Agent can use real host paths directly, then prefer the real
# path of the working directory when a mirror backs it.
if [ "$host_full_access" = true ]; then
  create_host_mirrors
fi
select_agent_start_cwd

[ -d "$workspace_cwd" ] && [ ! -L "$workspace_cwd" ] \
  || fail 'CWD is not a directory after mounting ROOT.'
resolved_cwd=$(/usr/bin/realpath -e -- "$workspace_cwd") \
  || fail 'CWD cannot be resolved through the workspace filesystem.'
case "$resolved_cwd" in
  "$workspace_root"|"$workspace_root"/*) ;;
  *) fail 'resolved CWD escapes ROOT.' ;;
esac
[ "$resolved_cwd" = "$workspace_cwd" ] \
  || fail 'CWD must not traverse a workspace symlink.'
child_job_is_active "$sshfs_pid" \
  || fail 'sshfs stopped after mount readiness.'

cd -- "$agent_start_cwd"
agent_start_fifo="$session_control_dir/agent.start"
/usr/bin/mkfifo -m 0600 -- "$agent_start_fifo" \
  || fail 'cannot create the Agent bootstrap gate.'
[ -p "$agent_start_fifo" ] && [ ! -L "$agent_start_fifo" ] \
  && [ "$(/usr/bin/stat -c '%u:%g:%a' -- "$agent_start_fifo")" = 0:0:600 ] \
  || fail 'the Agent bootstrap gate is unsafe.'
# Holding both FIFO ends avoids an open-order deadlock. Open them only after
# SSHFS is running so no long-lived transport inherits these control fds. The
# child reads its inherited fd instead of reopening the pathname, so the parent
# may safely unlink the FIFO before a newly forked child gets scheduled.
exec 7<> "$agent_start_fifo"
agent_start_writer_open=true
exec 8< "$agent_start_fifo"
agent_start_reader_open=true
set +e
setsid_arguments=(/usr/bin/setsid)
if [ -t 0 ] && [ -t 1 ]; then
  setsid_arguments+=(--ctty)
fi
set +m
background_launching=true
(
  trap '' INT TERM HUP
  exec 7>&-
  IFS= read -r bootstrap_gate <&8 || exit 70
  exec 8<&-
  [ "$bootstrap_gate" = start ] || exit 70
  exec /usr/bin/env \
    --default-signal=HUP \
    --default-signal=INT \
    --default-signal=QUIT \
    --default-signal=TERM \
    "${setsid_arguments[@]}" \
    /bin/bash -c '
    set -euo pipefail
    agent_cgroup=$1
    identity_file=$2
    shift 2
    session_pid=$$
    printf "%s\n" "$session_pid" > "$agent_cgroup/cgroup.procs"
    expected_cgroup=${agent_cgroup#/sys/fs/cgroup}
    [ "$(/bin/cat /proc/self/cgroup)" = "0::$expected_cgroup" ] \
      || exit 70
    session_record=$(/usr/bin/ps -o sid=,pgid= -p "$session_pid")
    read -r session_sid session_pgid session_extra <<< "$session_record"
    case "$session_pid:$session_sid:$session_pgid" in
      *[!0-9:]*|:*|*::*|*:) exit 70 ;;
    esac
    [ -z "${session_extra:-}" ] \
      && [ "$session_pid" = "$session_sid" ] \
      && [ "$session_pid" = "$session_pgid" ] \
      || exit 70
    identity_tmp="$identity_file.tmp"
    umask 077
    printf "%s\t%s\t%s\n" \
      "$session_pid" "$session_sid" "$session_pgid" > "$identity_tmp"
    /bin/mv -f -- "$identity_tmp" "$identity_file"
    exec "$@"
  ' agent-session-bootstrap \
  "$agent_cgroup" \
  "$agent_identity_file" \
  /usr/bin/setpriv \
    --reuid="$runtime_uid" \
    --regid="$runtime_gid" \
    --clear-groups \
    --no-new-privs \
    /usr/bin/env \
      "${agent_environment[@]}" \
      "$agent_executable" \
      "${agent_arguments[@]}" \
    <&0
) <&0 &
agent_pid=$!
agent_pgid=$agent_pid
exec 8<&-
agent_start_reader_open=false
if ! printf '%s\n' "$agent_pid" > "$agent_cgroup/cgroup.procs" \
  || ! cgroup_has_agent_processes; then
  kill -KILL "$agent_pid" 2>/dev/null || true
  wait "$agent_pid" 2>/dev/null || true
  agent_waited=true
  complete_background_launch
  set -e
  fail 'cannot place the Agent bootstrap into its private cgroup.'
fi
if ! printf 'start\n' >&7; then
  complete_background_launch
  set -e
  fail 'cannot release the contained Agent bootstrap.'
fi
exec 7>&-
agent_start_writer_open=false
/bin/rm -f -- "$agent_start_fifo"
agent_start_fifo=
complete_background_launch
identity_ready=false
for identity_attempt in $(/usr/bin/seq 1 200); do
  if load_agent_identity; then
    identity_ready=true
    break
  fi
  kill -0 "$agent_pid" 2>/dev/null || break
  /bin/sleep 0.01
done
if [ "$identity_ready" != true ]; then
  if cgroup_has_agent_processes; then
    set -e
    fail 'Agent session bootstrap did not publish its process group within two seconds.'
  fi
  wait "$agent_pid"
  bootstrap_status=$?
  agent_waited=true
  case "$bootstrap_status" in
    129|130|131|143)
      exit "$bootstrap_status"
      ;;
  esac
  set -e
  fail "Agent session bootstrap failed before publishing its process group (status $bootstrap_status)."
fi
/bin/rm -f -- "$agent_identity_file"
while :; do
  # Bash drops completed asynchronous jobs from `jobs -p` but retains their
  # status for an explicit wait. Polling avoids wait -n's failure mode where a
  # fast Agent is already "no such job" and Bash waits forever on live SSHFS.
  # Agent is checked first so simultaneous completion preserves its real exit.
  if ! child_job_is_active "$agent_pid"; then
    wait "$agent_pid"
    agent_status=$?
    agent_waited=true
    break
  fi
  if ! child_job_is_active "$sshfs_pid"; then
    wait "$sshfs_pid" 2>/dev/null || true
    sshfs_pid=
    printf '%s\n' \
      'agent-workspace-session: workspace transport stopped while the Agent was still running.' \
      >&2
    exit 74
  fi
  /bin/sleep 0.05
done
set -e

exit "$agent_status"
