#!/bin/bash
set -euo pipefail

session_dir=""
broker_arguments=("$@")

while [ "$#" -gt 0 ]; do
  case "$1" in
    --session-dir)
      [ "$#" -ge 2 ] || exit 64
      session_dir="$2"
      shift 2
      ;;
    --bind-address|--launcher-pid|--real-home|--exec-home|--sandbox-bin)
      [ "$#" -ge 2 ] || exit 64
      shift 2
      ;;
    *)
      exit 64
      ;;
  esac
done

[ -n "$session_dir" ] && [ -d "$session_dir" ] || exit 66
for argument in "${broker_arguments[@]}"; do
  printf 'ARG=%s\n' "$argument" >> "$session_dir/fake-host-broker-args"
done
endpoint_tmp="$session_dir/.host-exec-endpoint.$$"
case "$session_dir" in
  *broker_endpoint_zero*) endpoint='192.168.64.1:0' ;;
  *broker_endpoint_overflow*) endpoint='192.168.64.1:65536' ;;
  *broker_endpoint_suffix*) endpoint='192.168.64.1:54321junk' ;;
  *broker_endpoint_huge*) endpoint='192.168.64.1:999999999999999999999' ;;
  *) endpoint='192.168.64.1:54321' ;;
esac
printf '%s\n' "$endpoint" > "$endpoint_tmp"
mv -f "$endpoint_tmp" "$session_dir/host-exec-endpoint"

# The fixture has no host commands to serve. Publishing the validated endpoint
# is sufficient; exiting also keeps the shell regression suite fast.
exit 0
