verify_singleton_container_inspect() {
  local inspect_tmp="$1"
  local expected_state="$2"
  local expected_digest="$3"
  local expected_creator_pid="$4"

  "$osascript_bin" -l JavaScript - \
    "$inspect_tmp" \
    "$singleton_container_name" \
    "$profile_id" \
    "$host_uid" \
    "$singleton_config_hash" \
    "$expected_state" \
    "$expected_digest" \
    "$expected_creator_pid" >/dev/null 2>&1 <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('container inspect is not readable UTF-8');
  const containers = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(containers) || containers.length !== 1) {
    throw new Error('container inspect must contain exactly one container');
  }
  const container = containers[0];
  if (container === null || typeof container !== 'object' || Array.isArray(container)
      || container.id !== argv[1]) {
    throw new Error('singleton container id mismatch');
  }
  const configuration = container.configuration;
  if (configuration === null || typeof configuration !== 'object'
      || Array.isArray(configuration) || configuration.id !== argv[1]) {
    throw new Error('singleton configuration id mismatch');
  }
  const labels = configuration.labels;
  if (labels === null || typeof labels !== 'object' || Array.isArray(labels)
      || labels['com.loadchange.agent-container'] !== 'true'
      || labels['com.loadchange.agent-container.profile'] !== argv[2]
      || labels['com.loadchange.agent-container.host-uid'] !== argv[3]
      || labels['com.loadchange.agent-container.launcher-pid'] !== argv[7]
      || labels['com.loadchange.agent-container.mode'] !== 'singleton'
      || labels['com.loadchange.agent-container.config-sha256'] !== argv[4]) {
    throw new Error('singleton provenance labels mismatch');
  }
  const status = container.status;
  if (status === null || typeof status !== 'object' || Array.isArray(status)
      || status.state !== argv[5]) {
    throw new Error('singleton runtime state mismatch');
  }
  const image = configuration.image;
  const descriptor = image && typeof image === 'object' && !Array.isArray(image)
    ? image.descriptor
    : null;
  const digest = descriptor && typeof descriptor === 'object' && !Array.isArray(descriptor)
    ? descriptor.digest
    : null;
  if (typeof digest !== 'string' || digest !== argv[6]) {
    throw new Error('singleton image digest mismatch');
  }
  const initProcess = configuration.initProcess;
  if (initProcess === null || typeof initProcess !== 'object'
      || Array.isArray(initProcess) || initProcess.terminal !== false) {
    throw new Error('singleton primary process must not own a terminal');
  }
  return 'verified';
}
JXA
}

resolve_singleton_host_gateway() {
  local network_inspect_tmp

  host_gateway="${AGENT_CONTAINER_HOST_GATEWAY:-}"
  if [ -z "$host_gateway" ]; then
    network_inspect_tmp="$host_stage_dir/.singleton-network-inspect.$$"
    "$container_bin" network inspect default > "$network_inspect_tmp" 2>/dev/null \
      || die "Unable to inspect Apple's default container network for workspace sharing."
    host_gateway=$(
      "$osascript_bin" -l JavaScript - "$network_inspect_tmp" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('network inspect is not readable UTF-8');
  const networks = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(networks) || networks.length !== 1) {
    throw new Error('network inspect must contain exactly one network');
  }
  const gateway = networks[0]
    && networks[0].status
    && networks[0].status.ipv4Gateway;
  if (typeof gateway !== 'string'
      || !/^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$/.test(gateway)) {
    throw new Error('default network has no IPv4 gateway');
  }
  return gateway;
}
JXA
    ) || {
      rm -f "$network_inspect_tmp"
      die "Apple's default container network returned an invalid host gateway."
    }
    rm -f "$network_inspect_tmp"
  fi
  if ! printf '%s\n' "$host_gateway" \
    | awk -F. 'NF == 4 { for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit 1; ok = 1 } END { exit !ok }'; then
    die "Unsafe workspace-broker gateway address: $host_gateway"
  fi
}

