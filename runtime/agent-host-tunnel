#!/usr/bin/env node

/**
 * Guest-side loopback forwarder for agent-container full host access.
 *
 * For each forwarded port it listens on the guest's 127.0.0.1 and, for every
 * accepted connection, opens one connection to the host-exec broker's tunnel
 * listener, sends the single authentication frame
 *   AGENT-CONTAINER-TUNNEL/1 <token> <target port>\n
 * and then relays raw bytes in both directions. The host broker connects the
 * other end to its own 127.0.0.1:<target port>, so a guest tool that speaks
 * to 127.0.0.1:5037 reaches the operator's real adb server, and so on.
 *
 * A port entry is either P (listen on P, reach host port P — the normal
 * case) or LISTEN:TARGET, for a guest port that must differ from the host
 * port (for example when a guest-side service already occupies it).
 *
 * Teardown is graceful: when one side finishes cleanly the other side is
 * ended, not destroyed, so a service's final burst before it closes still
 * reaches a slow guest reader; a bounded stall watchdog then closes a peer
 * that never drains. Only an error destroys both sides at once.
 *
 * This is not a security boundary against the guest: the token it holds is the
 * guest's own per-session credential, and the host broker is the authority
 * that decides which target ports may be reached. The forwarder only listens
 * on the loopback interface and never on a routable address.
 *
 * Usage:
 *   agent-host-tunnel --endpoint IPV4:PORT --token 64HEX \
 *     --ports P[,P...] [--ready-fd N]
 * With --ready-fd, the single byte "1" is written to that inherited descriptor
 * once every listener is bound, so a launcher can proceed deterministically.
 */

import net from 'node:net';
import { writeSync } from 'node:fs';
import process from 'node:process';

const TOKEN_PATTERN = /^[0-9a-f]{64}$/;
const CONNECT_TIMEOUT_MS = 5_000;
const CLOSE_STALL_MS = 30_000;
const MAX_CONNECTIONS = 256;

function fail(message) {
  process.stderr.write(`agent-host-tunnel: ${message}\n`);
  process.exit(64);
}

function parsePort(text, label) {
  if (!/^[1-9][0-9]{0,4}$/.test(text) || Number(text) > 65535) {
    fail(`${label} must be a TCP port from 1 to 65535`);
  }
  return Number(text);
}

function parseArguments(argv) {
  const values = new Map();
  const allowed = new Set(['--endpoint', '--token', '--ports', '--ready-fd']);
  for (let index = 0; index < argv.length; index += 2) {
    const name = argv[index];
    const value = argv[index + 1];
    if (!allowed.has(name) || value === undefined) {
      fail('usage: agent-host-tunnel --endpoint IPV4:PORT --token 64HEX --ports P[,P...] [--ready-fd N]');
    }
    if (values.has(name)) fail(`duplicate option: ${name}`);
    values.set(name, value);
  }

  const endpoint = values.get('--endpoint') ?? '';
  const match = /^((?:\d{1,3}\.){3}\d{1,3}):(\d{1,5})$/.exec(endpoint);
  if (!match) fail('--endpoint must be one IPv4:port');
  const host = match[1];
  if (host.split('.').some((octet) => Number(octet) > 255)) fail('--endpoint host is not IPv4');
  const endpointPort = Number(match[2]);
  if (endpointPort < 1 || endpointPort > 65535) fail('--endpoint port is out of range');

  const token = values.get('--token') ?? '';
  if (!TOKEN_PATTERN.test(token)) fail('--token must be 64 lowercase hex characters');

  const forwards = [];
  for (const entry of (values.get('--ports') ?? '').split(',')) {
    const parts = entry.split(':');
    if (parts.length > 2) fail('--ports entries are P or LISTEN:TARGET');
    const listen = parsePort(parts[0], '--ports listen port');
    const target = parts.length === 2 ? parsePort(parts[1], '--ports target port') : listen;
    if (forwards.some((forward) => forward.listen === listen)) {
      fail(`--ports lists guest port ${listen} twice`);
    }
    forwards.push({ listen, target });
  }
  if (forwards.length === 0) fail('--ports must list at least one port');

  let readyFd = null;
  if (values.has('--ready-fd')) {
    const text = values.get('--ready-fd');
    if (!/^[0-9]{1,3}$/.test(text)) fail('--ready-fd must be a small descriptor number');
    readyFd = Number(text);
  }

  return { host, endpointPort, token, forwards, readyFd };
}

// End a socket and let its queued writes drain. A peer that stops reading is
// cut off once the queue has made no progress for a whole stall window.
function endGracefully(socket) {
  if (socket.destroyed) return;
  socket.resume();
  socket.end();
  let lastPending = Number.POSITIVE_INFINITY;
  const watchdog = setInterval(() => {
    const pending = socket.writableLength;
    if (pending > 0 && pending < lastPending) {
      lastPending = pending;
      return;
    }
    socket.destroy();
  }, CLOSE_STALL_MS);
  watchdog.unref();
  socket.once('close', () => clearInterval(watchdog));
}

function relayConnection(local, configuration, target, live) {
  if (live.size >= MAX_CONNECTIONS) {
    local.destroy();
    return;
  }
  live.add(local);
  local.setNoDelay(true);
  local.pause();

  const upstream = net.connect({
    host: configuration.host,
    port: configuration.endpointPort,
    allowHalfOpen: true,
  });
  const connectTimer = setTimeout(
    () => upstream.destroy(new Error('connect timeout')),
    CONNECT_TIMEOUT_MS,
  );
  const destroyBoth = () => {
    clearTimeout(connectTimer);
    local.destroy();
    upstream.destroy();
  };
  local.on('error', destroyBoth);
  upstream.on('error', destroyBoth);
  local.once('close', (hadError) => {
    live.delete(local);
    if (hadError) destroyBoth();
    else endGracefully(upstream);
  });
  upstream.once('close', (hadError) => {
    clearTimeout(connectTimer);
    if (hadError) destroyBoth();
    else endGracefully(local);
  });
  upstream.once('connect', () => {
    clearTimeout(connectTimer);
    upstream.setNoDelay(true);
    upstream.write(`AGENT-CONTAINER-TUNNEL/1 ${configuration.token} ${target}\n`);
    local.pipe(upstream);
    upstream.pipe(local);
    local.resume();
  });
}

function main() {
  const configuration = parseArguments(process.argv.slice(2));
  const live = new Set();
  const servers = [];
  let bound = 0;

  const onAllBound = () => {
    if (configuration.readyFd === null) return;
    try {
      // One byte, best effort: the launcher only waits for readability.
      writeSync(configuration.readyFd, '1');
    } catch {
      // The launcher can also probe the ports, so readiness is not fatal here.
    }
  };

  for (const forward of configuration.forwards) {
    const server = net.createServer({ allowHalfOpen: true }, (local) => {
      relayConnection(local, configuration, forward.target, live);
    });
    server.on('error', (error) => fail(`cannot listen on 127.0.0.1:${forward.listen}: ${error.message}`));
    server.listen({ host: '127.0.0.1', port: forward.listen, exclusive: true }, () => {
      bound += 1;
      if (bound === configuration.forwards.length) onAllBound();
    });
    servers.push(server);
  }

  const shutdown = () => {
    for (const server of servers) server.close();
    for (const socket of live) socket.destroy();
    process.exit(0);
  };
  for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
    process.on(signal, shutdown);
  }
}

main();
