#!/bin/bash
set -euo pipefail

readonly PROGRAM_NAME="agent-container"
readonly MIN_CONTAINER_VERSION="1.2.0"
readonly MAX_PROFILE_ID_LENGTH=32
readonly VIRTIOFS_ISSUE_URL="https://github.com/apple/container/issues/1097"
readonly OWNERSHIP_MARKER_TEXT="managed by agent-container"
readonly DEFAULT_BASE_IMAGE="mirror.gcr.io/library/debian:bookworm-slim@sha256:9b67294679b30e5d6ab257b40594feeb4a4b81f7fcf4131f4decf0d6a212a9b0"

die() {
  echo "Error: $*" >&2
  exit 1
}

warn() {
  echo "Warning: $*" >&2
}

is_true() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

version_at_least() {
  local actual="$1"
  local required="$2"
  local actual_major actual_minor actual_patch
  local required_major required_minor required_patch

  IFS=. read -r actual_major actual_minor actual_patch <<EOF
$actual
EOF
  IFS=. read -r required_major required_minor required_patch <<EOF
$required
EOF

  [ "${actual_major:-0}" -gt "${required_major:-0}" ] && return 0
  [ "${actual_major:-0}" -lt "${required_major:-0}" ] && return 1
  [ "${actual_minor:-0}" -gt "${required_minor:-0}" ] && return 0
  [ "${actual_minor:-0}" -lt "${required_minor:-0}" ] && return 1
  [ "${actual_patch:-0}" -ge "${required_patch:-0}" ]
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    die "shasum or sha256sum is required."
  fi
}

sha256_stream() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    sha256sum | awk '{print $1}'
  fi
}

bounded_file_count() {
  local root="$1"
  local limit="$2"
  local count error_file first_error

  error_file=$(mktemp "${TMPDIR:-/tmp}/agent-container-find.XXXXXX") \
    || die "Unable to create a temporary file for the workspace safety scan."

  # Stop after limit+1 NUL-delimited paths. Temporarily disable pipefail because
  # find is expected to receive SIGPIPE once the bounded reader exits. Any real
  # traversal error is captured separately and fails closed.
  set +o pipefail
  count=$(
    find "$root" -mindepth 1 -print0 2>"$error_file" \
      | (
          bounded_count=0
          while IFS= read -r -d '' ignored_path; do
            bounded_count=$((bounded_count + 1))
            [ "$bounded_count" -gt "$limit" ] && break
          done
          printf '%s\n' "$bounded_count"
        )
  )
  set -o pipefail

  if [ -s "$error_file" ]; then
    first_error=$(sed -n '1p' "$error_file")
    rm -f "$error_file"
    die "Unable to safely scan workspace '$root': $first_error"
  fi
  rm -f "$error_file"
  case "$count" in
    ''|*[!0-9]*) die "Workspace safety scan returned an invalid file count." ;;
  esac
  printf '%s\n' "$count"
}

resolve_absolute_dir() {
  (CDPATH= cd -- "$1" 2>/dev/null && pwd -P)
}

canonical_data_dir() {
  local target="$1"
  local parent base canonical_parent
  if [ -L "$target" ] && [ ! -e "$target" ]; then
    die "Refusing a broken symlink as a writable data path: $target"
  fi
  if [ -e "$target" ]; then
    [ -d "$target" ] || die "Expected a directory path, found a file: $target"
    resolve_absolute_dir "$target"
    return
  fi
  parent=$(dirname -- "$target")
  base=$(basename -- "$target")
  [ -d "$parent" ] \
    || die "Parent directory must already exist for custom data path: $parent"
  canonical_parent=$(resolve_absolute_dir "$parent")
  printf '%s/%s\n' "$canonical_parent" "$base"
}

path_contains() {
  local parent="$1"
  local child="$2"
  if [ "$parent" = / ]; then
    case "$child" in
      /*) return 0 ;;
      *) return 1 ;;
    esac
  fi
  case "$child/" in
    "$parent/"*) return 0 ;;
    *) return 1 ;;
  esac
}

is_empty_dir() {
  local first_entry
  [ -d "$1" ] || return 0
  if ! first_entry=$(find "$1" -mindepth 1 -maxdepth 1 -print -quit 2>&1); then
    return 1
  fi
  [ -z "$first_entry" ]
}

ownership_marker_valid() {
  local marker="$1"
  [ -f "$marker" ] \
    && [ ! -L "$marker" ] \
    && cmp -s "$marker" <(printf '%s\n' "$OWNERSHIP_MARKER_TEXT")
}

validate_marker_path() {
  local marker="$1"
  if [ -L "$marker" ] || { [ -e "$marker" ] && [ ! -f "$marker" ]; }; then
    die "Refusing an unsafe agent-container ownership marker: $marker"
  fi
  if [ -f "$marker" ] && ! ownership_marker_valid "$marker"; then
    die "Refusing an invalid agent-container ownership marker: $marker"
  fi
}

validate_managed_directory() {
  local directory="$1"
  if [ -L "$directory" ]; then
    die "Refusing a symlink as a managed directory: $directory"
  fi
  if [ -e "$directory" ] && [ ! -d "$directory" ]; then
    die "Expected a managed directory, found another file type: $directory"
  fi
}

validate_volume_source_path() {
  local source="$1"
  case "$source" in
    *:*)
      die "Apple container 1.2 cannot bind-mount a macOS path containing ':': $source"
      ;;
  esac
}

atomic_write_line() {
  local destination="$1"
  local value="$2"
  local parent temporary
  if [ -L "$destination" ] \
    || { [ -e "$destination" ] && [ ! -f "$destination" ]; }; then
    die "Refusing to replace an unsafe state file: $destination"
  fi
  parent=$(dirname -- "$destination")
  temporary=$(mktemp "$parent/.agent-container-write.XXXXXX") \
    || die "Unable to create a temporary file in $parent."
  if ! printf '%s\n' "$value" > "$temporary"; then
    rm -f "$temporary"
    die "Unable to write temporary state in $parent."
  fi
  chmod 0600 "$temporary"
  # Recheck immediately before rename. A same-directory mv atomically replaces
  # an existing regular file, so readers never observe an absent destination.
  if [ -L "$destination" ] \
    || { [ -e "$destination" ] && [ ! -f "$destination" ]; }; then
    rm -f "$temporary"
    die "Refusing to replace an unsafe state file: $destination"
  fi
  if ! mv -f "$temporary" "$destination"; then
    rm -f "$temporary"
    die "Unable to atomically publish state at $destination."
  fi
}

read_single_line() {
  local file="$1"
  local value
  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  IFS= read -r value < "$file" || return 1
  [ -n "$value" ] || return 1
  cmp -s "$file" <(printf '%s\n' "$value") || return 1
  printf '%s\n' "$value"
}

usage() {
  cat <<'EOF'
Usage:
  agent-container <profile> [agent arguments...]
  agent-container profiles

Built-in compatibility commands:
  claude-container [arguments...]
  codex-container [arguments...]
  grok-container [arguments...]

The host must be Apple silicon running macOS 26 or newer. Each profile runs
inside an arm64 Linux Micro-VM with an isolated, persistent shadow HOME.
EOF
}

validate_env_name() {
  local name="$1"
  [ -z "$name" ] && return 0
  case "$name" in
    [A-Z_]* ) ;;
    *) return 1 ;;
  esac
  case "$name" in
    *[!A-Z0-9_]*) return 1 ;;
  esac
}

valid_agent_version() {
  printf '%s\n' "$1" \
    | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9._-]*)?(\+[A-Za-z0-9][A-Za-z0-9._-]*)?$'
}

valid_profile_id() {
  [ "${#1}" -le "$MAX_PROFILE_ID_LENGTH" ] || return 1
  case "$1" in
    ''|*[!a-z0-9-]*|[0-9-]*) return 1 ;;
    *) return 0 ;;
  esac
}

load_profile() {
  local requested_id="$1"
  local allow_experimental="${2:-false}"
  local profile_record

  valid_profile_id "$requested_id" \
    || die "Invalid profile id '$requested_id'. Use '$PROGRAM_NAME profiles' to list profiles."
  profile_id="$requested_id"
  profile_file="$asset_dir/profiles/$profile_id.json"
  [ -f "$profile_file" ] && [ ! -L "$profile_file" ] \
    || die "Unknown or unsafe Agent profile '$profile_id'. Use '$PROGRAM_NAME profiles' to list profiles."

  # Parse once with macOS JavaScriptCore instead of spawning plutil for every
  # field. The constant parser enforces an exact typed key set and emits one
  # unit-separator-delimited record; profile data is never evaluated as code.
  # Unlike a whitespace IFS delimiter, unit separator preserves empty fields.
  profile_record=$("$osascript_bin" -l JavaScript - "$profile_file" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const keys = [
    'schema',
    'id',
    'displayName',
    'status',
    'installerKind',
    'installerUrl',
    'installerShell',
    'installerVersionUrl',
    'installerVersionFormat',
    'installerVersionEnv',
    'installerBinDirEnv',
    'installerHomeEnv',
    'installerNonInteractiveEnv',
    'version',
    'command',
    'probeArg',
    'apiKeyEnv',
    'disableAutoUpdateEnv'
  ];
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('profile is not readable UTF-8');
  const value = JSON.parse(ObjC.unwrap(source));
  if (value === null || Array.isArray(value) || typeof value !== 'object') {
    throw new Error('profile root must be an object');
  }
  const actualKeys = Object.keys(value).sort();
  const expectedKeys = keys.slice().sort();
  if (actualKeys.length !== expectedKeys.length
      || actualKeys.some((key, index) => key !== expectedKeys[index])) {
    throw new Error('profile keys do not match schema 2');
  }
  if (!Number.isInteger(value.schema)) {
    throw new Error('schema must be an integer');
  }
  for (const key of keys.slice(1)) {
    if (typeof value[key] !== 'string' || /[\u0000-\u001f\u007f]/.test(value[key])) {
      throw new Error(key + ' must not contain control characters');
    }
  }
  return keys.map((key) => String(value[key])).join('\u001f');
}
JXA
  ) || die "Agent profile '$profile_id' is not valid schema-2 JSON."

  IFS=$'\037' read -r \
    profile_schema \
    profile_declared_id \
    profile_display_name \
    profile_status \
    profile_installer_kind \
    profile_installer_url \
    profile_installer_shell \
    profile_installer_version_url \
    profile_installer_version_format \
    profile_installer_version_env \
    profile_installer_bin_dir_env \
    profile_installer_home_env \
    profile_installer_noninteractive_env \
    profile_version \
    profile_command \
    profile_probe_arg \
    profile_api_key_env \
    profile_disable_update_env <<EOF
$profile_record
EOF

  [ "$profile_schema" = 2 ] \
    || die "Unsupported schema '$profile_schema' in profile '$profile_id'."
  [ "$profile_declared_id" = "$profile_id" ] \
    || die "Profile id '$profile_declared_id' does not match filename '$profile_id.json'."
  [ -n "$profile_display_name" ] \
    && printf '%s\n' "$profile_display_name" \
      | grep -Eq '^[A-Za-z0-9 ._+()/-]+$' \
    || die "Profile '$profile_id' has an unsafe displayName."
  case "$profile_status" in
    stable|preview) ;;
    experimental)
      if [ "$allow_experimental" != true ] \
        && ! is_true "${AGENT_CONTAINER_ENABLE_EXPERIMENTAL:-false}"; then
        die "Profile '$profile_id' is experimental. Set AGENT_CONTAINER_ENABLE_EXPERIMENTAL=true to enable it explicitly."
      fi
      ;;
    *) die "Profile '$profile_id' has unsupported status '$profile_status'." ;;
  esac
  [ "$profile_installer_kind" = native-script ] \
    || die "Profile '$profile_id' uses unsupported installerKind '$profile_installer_kind'."
  case "$profile_installer_url" in
    https://*) ;;
    *) die "Profile '$profile_id' must use an HTTPS native installer URL." ;;
  esac
  case "$profile_installer_url" in
    *[!A-Za-z0-9._:/-]*) die "Profile '$profile_id' has an unsafe installerUrl." ;;
  esac
  case "$profile_installer_shell" in
    bash|sh) ;;
    *) die "Profile '$profile_id' has an unsupported installerShell." ;;
  esac
  case "$profile_installer_version_url" in
    https://*) ;;
    *) die "Profile '$profile_id' must use an HTTPS installerVersionUrl." ;;
  esac
  case "$profile_installer_version_url" in
    *[!A-Za-z0-9._:/-]*) die "Profile '$profile_id' has an unsafe installerVersionUrl." ;;
  esac
  case "$profile_installer_version_format" in
    plain-semver|rust-tag-json) ;;
    *) die "Profile '$profile_id' has an unsupported installerVersionFormat." ;;
  esac
  validate_env_name "$profile_installer_version_env" \
    || die "Profile '$profile_id' has an unsafe installerVersionEnv."
  validate_env_name "$profile_installer_bin_dir_env" \
    || die "Profile '$profile_id' has an unsafe installerBinDirEnv."
  validate_env_name "$profile_installer_home_env" \
    || die "Profile '$profile_id' has an unsafe installerHomeEnv."
  validate_env_name "$profile_installer_noninteractive_env" \
    || die "Profile '$profile_id' has an unsafe installerNonInteractiveEnv."
  if [ "$profile_version" != latest ]; then
    valid_agent_version "$profile_version" \
      || die "Profile '$profile_id' must select 'latest' or an exact native CLI version."
  fi
  case "$profile_command" in
    ''|*[!A-Za-z0-9._-]*) die "Profile '$profile_id' has an unsafe command." ;;
  esac
  case "$profile_probe_arg" in
    --version|-V|version) ;;
    *) die "Profile '$profile_id' has an unsupported probe argument." ;;
  esac
  validate_env_name "$profile_api_key_env" \
    || die "Profile '$profile_id' has an unsafe apiKeyEnv."
  validate_env_name "$profile_disable_update_env" \
    || die "Profile '$profile_id' has an unsafe disableAutoUpdateEnv."
}

host_home_dir="${HOME:?HOME is not set}"
script_dir=$(resolve_absolute_dir "$(dirname -- "$0")")
asset_dir="${AGENT_CONTAINER_ASSET_DIR:-$script_dir}"
if [ ! -f "$asset_dir/Containerfile" ] \
  || [ ! -f "$asset_dir/Containerfile.dockerignore" ] \
  || [ ! -f "$asset_dir/entrypoint.sh" ] \
  || [ ! -d "$asset_dir/profiles" ]; then
  asset_dir="${AGENT_CONTAINER_ASSET_DIR:-$host_home_dir/.local/share/agent-container/current}"
fi
asset_dir=$(resolve_absolute_dir "$asset_dir") \
  || die "Unable to resolve Agent container assets: $asset_dir"
[ -f "$asset_dir/Containerfile" ] && [ ! -L "$asset_dir/Containerfile" ] \
  || die "Containerfile not found. Re-run install.sh or set AGENT_CONTAINER_ASSET_DIR."
[ -f "$asset_dir/Containerfile.dockerignore" ] \
  && [ ! -L "$asset_dir/Containerfile.dockerignore" ] \
  || die "Containerfile.dockerignore not found. Re-run install.sh or set AGENT_CONTAINER_ASSET_DIR."
[ -f "$asset_dir/entrypoint.sh" ] && [ ! -L "$asset_dir/entrypoint.sh" ] \
  || die "entrypoint.sh not found. Re-run install.sh or set AGENT_CONTAINER_ASSET_DIR."
[ -d "$asset_dir/profiles" ] \
  || die "Profiles directory not found. Re-run install.sh or set AGENT_CONTAINER_ASSET_DIR."

osascript_bin=$(command -v osascript || true)
[ -n "$osascript_bin" ] \
  || die "macOS osascript/JavaScriptCore is required to validate Agent profiles."

requested_profile="${1:-}"
case "$requested_profile" in
  -h|--help|'')
    usage
    [ -n "$requested_profile" ] && exit 0
    exit 64
    ;;
  profiles)
    found_profile=false
    for profile_path in "$asset_dir"/profiles/*.json; do
      [ -f "$profile_path" ] || continue
      found_profile=true
      listed_id=$(basename -- "$profile_path" .json)
      load_profile "$listed_id" true
      printf '%-12s %-14s %s\n' "$profile_id" "$profile_status" "$profile_display_name"
    done
    [ "$found_profile" = true ] || die "No Agent profiles are installed."
    exit 0
    ;;
esac
shift
load_profile "$requested_profile"

if [ -n "${AGENT_CONTAINER_IMAGE:-}" ]; then
  die "AGENT_CONTAINER_IMAGE is not supported. Image references are profile-scoped to preserve ownership and uninstall provenance."
fi
image_repository="agent-container-$profile_id"
image_name="$image_repository:latest"

[ "$(uname -s)" = "Darwin" ] \
  || die "agent-container is supported only on macOS."
[ "$(uname -m)" = "arm64" ] \
  || die "agent-container requires Apple silicon."

macos_major=$(sw_vers -productVersion | cut -d. -f1)
case "$macos_major" in
  ''|*[!0-9]*) die "Could not determine the macOS version." ;;
esac
if [ "${macos_major:-0}" -lt 26 ]; then
  die "macOS 26 or newer is required by the supported Apple container release."
fi

host_uid=$(id -u)
host_gid=$(id -g)
[ "$host_uid" -gt 0 ] && [ "$host_gid" -gt 0 ] \
  || die "Refusing to launch an Agent container from a numeric root account."

container_bin="${AGENT_CONTAINER_BIN:-container}"
command -v "$container_bin" >/dev/null 2>&1 \
  || die "Apple container is not installed. Install it from https://github.com/apple/container/releases"

container_version_output=$("$container_bin" --version 2>&1) \
  || die "Unable to execute '$container_bin --version'."
container_version=$(printf '%s\n' "$container_version_output" \
  | sed -nE 's/.*version ([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' \
  | head -n 1)
[ -n "$container_version" ] \
  || die "Could not parse Apple container version from: $container_version_output"
version_at_least "$container_version" "$MIN_CONTAINER_VERSION" \
  || die "Apple container $MIN_CONTAINER_VERSION or newer is required (found $container_version)."

if ! "$container_bin" system status >/dev/null 2>&1; then
  die "Apple container services are not running. Start them explicitly with: container system start"
fi

# Return every project-labeled container plus any container occupying this
# launcher's reserved name pattern. The latter is reported even without our
# labels so recovery never deletes an unproven resource merely because its
# name looks familiar.
list_native_agent_containers() {
  local list_tmp parsed_records
  list_tmp=$(mktemp "${TMPDIR:-/tmp}/agent-container-list.XXXXXX") \
    || die "Unable to create temporary storage for Apple container state."
  if ! "$container_bin" list --all --format json > "$list_tmp" 2>/dev/null; then
    rm -f "$list_tmp"
    die "Unable to enumerate Apple containers for stale-session safety."
  fi
  if ! parsed_records=$("$osascript_bin" -l JavaScript - \
    "$list_tmp" "$host_uid" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('container list is not readable UTF-8');
  const containers = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(containers)) throw new Error('container list must be an array');

  const hostUID = argv[1];
  const reserved = new RegExp('^agent-[a-z0-9-]+-' + hostUID + '-[0-9]+$');
  const records = [];
  for (const container of containers) {
    if (container === null || typeof container !== 'object' || Array.isArray(container)) {
      throw new Error('container list contains a non-object record');
    }
    const id = container.id;
    if (typeof id !== 'string' || /[\t\r\n]/.test(id)) {
      throw new Error('container id is not a single-line string');
    }
    const configuration = container.configuration;
    if (configuration === null || typeof configuration !== 'object'
        || Array.isArray(configuration) || configuration.id !== id) {
      throw new Error('container configuration identity does not match its record');
    }
    const labels = configuration && typeof configuration === 'object'
      && configuration.labels && typeof configuration.labels === 'object'
      ? configuration.labels
      : {};
    const owned = labels['com.loadchange.agent-container'] === 'true';
    if (!owned && !reserved.test(id)) continue;

    const state = container.status && typeof container.status === 'object'
      ? container.status.state
      : null;
    if (!['unknown', 'stopped', 'running', 'stopping'].includes(state)) {
      throw new Error('managed container has an invalid runtime state');
    }
    const values = [
      id,
      owned ? 'true' : 'false',
      labels['com.loadchange.agent-container.profile'] ?? '-',
      labels['com.loadchange.agent-container.host-uid'] ?? '-',
      labels['com.loadchange.agent-container.launcher-pid'] ?? '-',
      state
    ];
    if (values.some((value) => typeof value !== 'string' || /[\t\r\n]/.test(value))) {
      throw new Error('managed container metadata is not a single-line string');
    }
    records.push(values.join('\t'));
  }
  return records.join('\n');
}
JXA
  ); then
    rm -f "$list_tmp"
    die "Apple container state did not match the expected JSON contract."
  fi
  rm -f "$list_tmp"
  [ -z "$parsed_records" ] || printf '%s\n' "$parsed_records"
}

# Confirm only the narrow fact needed after an attached --rm start: the exact
# container ID is absent from a successful, structurally valid `list --all`.
# Inspect stderr is intentionally not parsed because Apple may wrap a
# not-found phrase inside a broader service/RPC error. Any list failure,
# malformed record, or matching ID is indeterminate and therefore returns
# failure without deleting anything.
native_container_name_is_absent() {
  local expected_name="$1"
  local list_tmp
  list_tmp=$(mktemp "${TMPDIR:-/tmp}/agent-container-absence.XXXXXX") \
    || return 1
  if ! "$container_bin" list --all --format json > "$list_tmp" 2>/dev/null; then
    rm -f "$list_tmp"
    return 1
  fi
  if ! "$osascript_bin" -l JavaScript - \
    "$list_tmp" "$expected_name" >/dev/null 2>&1 <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('container list is not readable UTF-8');
  const containers = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(containers)) throw new Error('container list must be an array');

  const expectedID = argv[1];
  for (const container of containers) {
    if (container === null || typeof container !== 'object' || Array.isArray(container)) {
      throw new Error('container list contains a non-object record');
    }
    const id = container.id;
    if (typeof id !== 'string' || /[\t\r\n]/.test(id)) {
      throw new Error('container id is not a single-line string');
    }
    if (id === expectedID) throw new Error('container still exists');
  }
  return 'absent';
}
JXA
  then
    rm -f "$list_tmp"
    return 1
  fi
  rm -f "$list_tmp"
}

http_proxy_value="${AGENT_CONTAINER_HTTP_PROXY:-}"
https_proxy_value="${AGENT_CONTAINER_HTTPS_PROXY:-}"
all_proxy_value="${AGENT_CONTAINER_ALL_PROXY:-}"
no_proxy_value="${AGENT_CONTAINER_NO_PROXY:-localhost,127.0.0.1}"
dns1_value="${AGENT_CONTAINER_DNS1:-}"
dns2_value="${AGENT_CONTAINER_DNS2:-}"
timezone_value="${AGENT_CONTAINER_TZ:-}"

proxy_values_lower=$(
  printf '%s\n' "$http_proxy_value" "$https_proxy_value" "$all_proxy_value" \
    | tr '[:upper:]' '[:lower:]'
)
case "$proxy_values_lower" in
  *host.docker.internal*)
    die "host.docker.internal is Docker-specific and is unreachable from Apple containers. Configure a VM-reachable proxy address, or explicitly create and use Apple's host.container.internal bridge as documented in README.md."
    ;;
esac

host_workspace=$(pwd -P)
mount_root="$host_workspace"
common_git_dir=""

if command -v git >/dev/null 2>&1 \
  && git -C "$host_workspace" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git_top=$(git -C "$host_workspace" rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$git_top" ] && [ -d "$git_top" ]; then
    mount_root=$(resolve_absolute_dir "$git_top")
  fi

  common_git_dir=$(git -C "$host_workspace" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [ -z "$common_git_dir" ]; then
    common_git_raw=$(git -C "$host_workspace" rev-parse --git-common-dir 2>/dev/null || true)
    if [ -n "$common_git_raw" ]; then
      case "$common_git_raw" in
        /*) common_git_dir="$common_git_raw" ;;
        *) common_git_dir=$(resolve_absolute_dir "$mount_root/$common_git_raw" || true) ;;
      esac
    fi
  fi
fi

if [ -n "$common_git_dir" ]; then
  [ -d "$common_git_dir" ] \
    || die "Git reported a common directory that does not exist: $common_git_dir"
  common_git_dir=$(resolve_absolute_dir "$common_git_dir")
fi

max_workspace_files="${AGENT_CONTAINER_MAX_FILES:-40000}"
case "$max_workspace_files" in
  ''|*[!0-9]*) die "AGENT_CONTAINER_MAX_FILES must be a positive integer." ;;
esac
[ "$max_workspace_files" -gt 0 ] \
  || die "AGENT_CONTAINER_MAX_FILES must be greater than zero."

workspace_file_count=$(bounded_file_count "$mount_root" "$max_workspace_files")
if [ "$workspace_file_count" -le "$max_workspace_files" ] \
  && [ -n "$common_git_dir" ] \
  && ! path_contains "$mount_root" "$common_git_dir"; then
  remaining_file_budget=$((max_workspace_files - workspace_file_count))
  common_git_file_count=$(bounded_file_count "$common_git_dir" "$remaining_file_budget")
  workspace_file_count=$((workspace_file_count + common_git_file_count))
fi
if [ "$workspace_file_count" -gt "$max_workspace_files" ] \
  && ! is_true "${AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK:-false}"; then
  die "Workspace mounts have more than $max_workspace_files files. Apple VirtioFS issue #1097 can exhaust host file descriptors and has caused kernel panics. Reduce the mounted tree, or explicitly set AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK=true after reviewing $VIRTIOFS_ISSUE_URL"
fi

home_canonical=$(resolve_absolute_dir "$host_home_dir")
host_home_dir="$home_canonical"
state_root_input="$host_home_dir/.agent-container"
if [ -n "${AGENT_CONTAINER_STATE_DIR:-}" ] \
  && [ "$AGENT_CONTAINER_STATE_DIR" != "$state_root_input" ]; then
  die "Custom AGENT_CONTAINER_STATE_DIR is not supported because session registration must remain globally discoverable for safe uninstall."
fi
[ ! -L "$state_root_input" ] \
  || die "Refusing a symlink as the Agent container state root: $state_root_input"
state_root=$(canonical_data_dir "$state_root_input")
path_contains "$home_canonical" "$state_root" \
  || die "Agent container state must remain under the user's home directory: $state_root"
[ "$state_root" != "$home_canonical" ] \
  || die "Refusing to use the entire host home as Agent container state."

state_ownership_marker="$state_root/.agent-container-owned"
validate_marker_path "$state_ownership_marker"
if [ -d "$state_root" ] \
  && ! ownership_marker_valid "$state_ownership_marker" \
  && ! is_empty_dir "$state_root"; then
  die "State directory is non-empty and has no valid agent-container ownership marker: $state_root"
fi

for shared_tree in "$mount_root" "$common_git_dir"; do
  [ -n "$shared_tree" ] || continue
  if path_contains "$shared_tree" "$state_root" \
    || path_contains "$state_root" "$shared_tree"; then
    die "Refusing overlap between shared workspace/Git data '$shared_tree' and private Agent state '$state_root'. Run from a narrower project directory."
  fi
done

profiles_root="$state_root/profiles"
profile_root="$profiles_root/$profile_id"
profile_home="$profile_root/home"
profile_meta="$profile_root/meta"
sessions_root="$state_root/sessions"
host_stage_dir="$sessions_root/session-$$"
lock_dir="$state_root/session.lock"
profile_lock_dir="$profile_root/session.lock"
image_marker="$profile_meta/image-build-id"
image_identity_file="$profile_meta/image-identity"
image_ref_file="$profile_meta/image-ref"
full_git_config=false
gitconfig_tmp=""
if is_true "${AGENT_CONTAINER_FULL_GIT_CONFIG:-false}"; then
  full_git_config=true
fi
forward_ssh_agent=false
if is_true "${AGENT_CONTAINER_FORWARD_SSH_AGENT:-false}"; then
  forward_ssh_agent=true
fi
mount_ssh_config=false
if is_true "${AGENT_CONTAINER_MOUNT_SSH_CONFIG:-false}"; then
  mount_ssh_config=true
fi

concurrent_sessions=false
if is_true "${AGENT_CONTAINER_ALLOW_CONCURRENT:-false}"; then
  concurrent_sessions=true
fi
if [ "$concurrent_sessions" = true ] \
  && ! is_true "${AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK:-false}"; then
  die "AGENT_CONTAINER_ALLOW_CONCURRENT also requires AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK=true because every session adds another affected VirtioFS VM."
fi

validate_managed_directory "$profiles_root"
validate_managed_directory "$profile_root"
validate_managed_directory "$profile_home"
validate_managed_directory "$profile_meta"
validate_managed_directory "$sessions_root"
validate_managed_directory "$host_stage_dir"
validate_managed_directory "$lock_dir"
validate_managed_directory "$profile_lock_dir"

gh_config_dir=""
if is_true "${AGENT_CONTAINER_MOUNT_GH:-false}" \
  && [ -d "$host_home_dir/.config/gh" ]; then
  gh_config_dir=$(resolve_absolute_dir "$host_home_dir/.config/gh")
fi
git_xdg_config_dir=""
if [ "$full_git_config" = true ] \
  && [ -d "$host_home_dir/.config/git" ]; then
  git_xdg_config_dir=$(resolve_absolute_dir "$host_home_dir/.config/git")
fi

for volume_source in \
  "$mount_root" \
  "$common_git_dir" \
  "$profile_home" \
  "$host_stage_dir" \
  "$gh_config_dir" \
  "$git_xdg_config_dir"; do
  [ -n "$volume_source" ] && validate_volume_source_path "$volume_source"
done

# Account for every user-controlled directory that becomes a VirtioFS share.
# The profile HOME is isolated from the real host HOME, but it can still grow
# large enough to trigger the upstream VirtioFS descriptor-retention issue.
mounted_entry_count=$((workspace_file_count + 8))
add_tree_to_mount_budget() {
  local source="$1"
  local remaining tree_count
  [ -d "$source" ] || return 0
  [ "$mounted_entry_count" -le "$max_workspace_files" ] || return 0
  mounted_entry_count=$((mounted_entry_count + 1))
  [ "$mounted_entry_count" -le "$max_workspace_files" ] || return 0
  remaining=$((max_workspace_files - mounted_entry_count))
  tree_count=$(bounded_file_count "$source" "$remaining")
  mounted_entry_count=$((mounted_entry_count + tree_count))
}

add_tree_to_mount_budget "$profile_home"
if [ -n "$gh_config_dir" ]; then
  add_tree_to_mount_budget "$gh_config_dir"
fi
if [ -n "$git_xdg_config_dir" ]; then
  add_tree_to_mount_budget "$git_xdg_config_dir"
fi
if [ "$mounted_entry_count" -gt "$max_workspace_files" ] \
  && ! is_true "${AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK:-false}"; then
  die "Projected VirtioFS shares have more than $max_workspace_files filesystem entries. Reduce mounted trees, or explicitly accept the upstream risk after reviewing $VIRTIOFS_ISSUE_URL"
fi

fd_stop_percent="${AGENT_CONTAINER_FD_STOP_PERCENT:-80}"
if ! is_true "${AGENT_CONTAINER_DISABLE_FD_WATCHDOG:-false}"; then
  case "$fd_stop_percent" in
    ''|*[!0-9]*) die "AGENT_CONTAINER_FD_STOP_PERCENT must be an integer from 50 through 95." ;;
  esac
  [ "$fd_stop_percent" -ge 50 ] && [ "$fd_stop_percent" -le 95 ] \
    || die "AGENT_CONTAINER_FD_STOP_PERCENT must be an integer from 50 through 95."
fi

host_num_files=$(sysctl -n kern.num_files 2>/dev/null || true)
host_max_files=$(sysctl -n kern.maxfiles 2>/dev/null || true)
host_max_files_per_proc=$(sysctl -n kern.maxfilesperproc 2>/dev/null || true)
host_max_vnodes=$(sysctl -n kern.maxvnodes 2>/dev/null || true)
host_free_vnodes=$(sysctl -n kern.free_vnodes 2>/dev/null || true)
case "$host_num_files:$host_max_files:$host_max_files_per_proc:$host_max_vnodes:$host_free_vnodes" in
  *[!0-9:]*)
    host_num_files=""
    host_max_files=""
    host_max_files_per_proc=""
    host_max_vnodes=""
    host_free_vnodes=""
    ;;
esac
if [ -z "$host_num_files" ] \
  || [ -z "$host_max_files" ] \
  || [ -z "$host_max_files_per_proc" ] \
  || [ -z "$host_max_vnodes" ] \
  || [ -z "$host_free_vnodes" ] \
  || [ "$host_max_files" -le 0 ] \
  || [ "$host_max_files_per_proc" -le 0 ] \
  || [ "$host_max_vnodes" -le 0 ] \
  || [ "$host_free_vnodes" -gt "$host_max_vnodes" ]; then
  if is_true "${AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK:-false}"; then
    warn "Unable to read all macOS file/vnode limits; continuing only because AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK is enabled."
    # If counters recover after launch, a zero baseline makes the live
    # watchdog conservative instead of performing arithmetic on an empty value.
    host_num_files=0
  else
    die "Unable to read macOS file/vnode limits for the VirtioFS safety preflight. Explicitly accept the upstream risk only after reviewing $VIRTIOFS_ISSUE_URL"
  fi
else
  projected_files=$((host_num_files + mounted_entry_count))
  safe_file_limit=$((host_max_files * 70 / 100))
  safe_process_file_limit=$((host_max_files_per_proc * 70 / 100))
  used_vnodes=$((host_max_vnodes - host_free_vnodes))
  projected_vnodes=$((used_vnodes + mounted_entry_count))
  safe_vnode_limit=$((host_max_vnodes * 70 / 100))
  if [ "$projected_files" -ge "$safe_file_limit" ] \
    || [ "$mounted_entry_count" -ge "$safe_process_file_limit" ] \
    || [ "$projected_vnodes" -ge "$safe_vnode_limit" ]; then
    if ! is_true "${AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK:-false}"; then
      die "Projected VirtioFS use crosses a 70% host file, per-process file, or vnode safety limit. Reduce the shared trees or explicitly accept the upstream risk. See $VIRTIOFS_ISSUE_URL"
    fi
  fi
fi

lifecycle_lock_acquired=false
lifecycle_lock=""
release_lifecycle_lock() {
  if [ "$lifecycle_lock_acquired" = true ] \
    && [ -n "$lifecycle_lock" ] \
    && [ -d "$lifecycle_lock" ]; then
    rm -f "$lifecycle_lock/pid"
    rmdir "$lifecycle_lock" 2>/dev/null || true
    lifecycle_lock_acquired=false
  fi
}

# Install/uninstall hold this lifecycle mutex for their transaction. A launcher
# holds it until its PID registration is durable, then releases it. This closes
# the check/start race where an uninstaller could finish its active-session
# preflight and remove an image or state just as a new VM starts.
local_root_input="$host_home_dir/.local"
if [ ! -e "$local_root_input" ] && [ ! -L "$local_root_input" ]; then
  mkdir "$local_root_input"
fi
[ -d "$local_root_input" ] \
  || die "Local data root is not a directory: $local_root_input"
local_root=$(resolve_absolute_dir "$local_root_input")
path_contains "$host_home_dir" "$local_root" \
  || die "Local data root resolves outside the host home: $local_root_input"

share_dir_input="$host_home_dir/.local/share"
if [ ! -e "$share_dir_input" ] && [ ! -L "$share_dir_input" ]; then
  mkdir "$share_dir_input"
fi
[ -d "$share_dir_input" ] \
  || die "Local share path is not a directory: $share_dir_input"
share_dir=$(resolve_absolute_dir "$share_dir_input")
path_contains "$host_home_dir" "$share_dir" \
  || die "Local share path resolves outside the host home: $share_dir_input"

lifecycle_lock="$share_dir/.agent-container.install.lock"
trap '' INT TERM HUP
if ! mkdir "$lifecycle_lock" 2>/dev/null; then
  [ -d "$lifecycle_lock" ] && [ ! -L "$lifecycle_lock" ] \
    || die "Unsafe agent-container lifecycle lock: $lifecycle_lock"
  [ -f "$lifecycle_lock/pid" ] && [ ! -L "$lifecycle_lock/pid" ] \
    || die "The agent-container lifecycle lock has no trustworthy PID; refusing to steal it."
  lifecycle_pid=$(read_single_line "$lifecycle_lock/pid" || true)
  case "$lifecycle_pid" in
    ''|0|*[!0-9]*) die "The agent-container lifecycle lock has an invalid PID; refusing to steal it." ;;
  esac
  if kill -0 "$lifecycle_pid" 2>/dev/null; then
    die "Another agent-container session, install, or uninstall is running (PID $lifecycle_pid)."
  fi
  rm -f "$lifecycle_lock/pid"
  rmdir "$lifecycle_lock" 2>/dev/null \
    || die "Could not clear stale agent-container lifecycle lock: $lifecycle_lock"
  mkdir "$lifecycle_lock"
fi
lifecycle_lock_acquired=true
trap release_lifecycle_lock EXIT
printf '%s\n' "$$" > "$lifecycle_lock/pid"

umask 077
mkdir -p "$state_root"
atomic_write_line "$state_ownership_marker" "$OWNERSHIP_MARKER_TEXT"
mkdir -p \
  "$profiles_root" \
  "$profile_root" \
  "$profile_home" \
  "$profile_meta" \
  "$sessions_root"

global_lock_acquired=false
profile_lock_acquired=false
cleanup_session() {
  if [ -n "$gitconfig_tmp" ]; then
    rm -f "$gitconfig_tmp" || true
  fi
  # The per-session directory can contain opted-in Git credentials and SSH
  # metadata. Remove all staging regardless of how the child exits.
  if [ -d "$host_stage_dir" ] || [ -L "$host_stage_dir" ]; then
    rm -rf "$host_stage_dir" || true
  fi
  if [ "$profile_lock_acquired" = true ] && [ -d "$profile_lock_dir" ]; then
    rm -f "$profile_lock_dir/pid" "$profile_lock_dir/profile"
    rmdir "$profile_lock_dir" 2>/dev/null || true
  fi
  if [ "$global_lock_acquired" = true ] && [ -d "$lock_dir" ]; then
    rm -f "$lock_dir/pid" "$lock_dir/profile"
    rmdir "$lock_dir" 2>/dev/null || true
  fi
  release_lifecycle_lock
}
trap cleanup_session EXIT

# A launcher killed with SIGKILL cannot run its EXIT cleanup, and Apple can keep
# an attached auto-remove container alive when its client disappears. Reconcile the
# native resource first, while the lifecycle mutex prevents a new launcher or
# uninstall transaction from publishing another session concurrently.
native_records=$(list_native_agent_containers)
while IFS=$'\t' read -r \
  native_id native_owned native_profile native_uid native_pid native_state; do
  [ -n "$native_id" ] || continue
  [ "$native_owned" = true ] \
    || die "Container '$native_id' occupies an agent-container session name but lacks project ownership labels."
  valid_profile_id "$native_profile" \
    || die "Managed native container '$native_id' has an invalid profile label."
  [ "$native_uid" = "$host_uid" ] \
    || die "Managed native container '$native_id' has an unexpected host UID label."
  case "$native_pid" in
    ''|0|1|*[!0-9]*)
      die "Managed native container '$native_id' has an invalid launcher PID label."
      ;;
  esac
  [ "$native_id" = "agent-$native_profile-$native_uid-$native_pid" ] \
    || die "Managed native container '$native_id' does not match its provenance labels."

  if kill -0 "$native_pid" 2>/dev/null; then
    if [ "$concurrent_sessions" != true ]; then
      die "Another managed Agent VM is active (container $native_id, launcher PID $native_pid)."
    fi
    continue
  fi

  warn "Removing orphaned Agent VM '$native_id' left by launcher PID $native_pid."
  "$container_bin" delete --force "$native_id" >/dev/null 2>&1 \
    || die "Unable to remove orphaned managed Agent VM '$native_id'."
done <<EOF
$native_records
EOF

# Remove only complete, dead registrations. Malformed records fail closed
# because their directories may hold opted-in Git or SSH material.
for session_dir in "$sessions_root"/session-*; do
  [ -e "$session_dir" ] || [ -L "$session_dir" ] || continue
  [ -d "$session_dir" ] && [ ! -L "$session_dir" ] \
    || die "Unsafe Agent session registration: $session_dir"
  session_number=${session_dir##*/session-}
  case "$session_number" in
    ''|0|1|*[!0-9]*) die "Invalid Agent session registration name: $session_dir" ;;
  esac
  registered_pid=$(read_single_line "$session_dir/pid" || true)
  [ "$registered_pid" = "$session_number" ] \
    || die "Agent session registration has an invalid PID: $session_dir"
  registered_profile=$(read_single_line "$session_dir/profile" || true)
  valid_profile_id "$registered_profile" \
    || die "Agent session registration has an invalid profile: $session_dir"
  if kill -0 "$registered_pid" 2>/dev/null; then
    if [ "$concurrent_sessions" != true ]; then
      die "Another Agent session is registering or running (PID $registered_pid, profile $registered_profile)."
    fi
    continue
  fi
  warn "Removing stale Agent session staging for PID $registered_pid."
  rm -rf -- "$session_dir"
done

if [ "$concurrent_sessions" != true ]; then
  if ! mkdir "$lock_dir" 2>/dev/null; then
    [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] \
      || die "Unable to safely inspect the Agent session lock at $lock_dir."
    [ -f "$lock_dir/pid" ] && [ ! -L "$lock_dir/pid" ] \
      || die "The Agent session lock has no trustworthy PID; refusing to steal it."
    existing_pid=$(read_single_line "$lock_dir/pid" || true)
    case "$existing_pid" in
      ''|*[!0-9]*) die "The Agent session lock contains an invalid PID; refusing to steal it." ;;
    esac
    [ "$existing_pid" -gt 1 ] \
      || die "The Agent session lock contains an unsafe PID; refusing to steal it."
    existing_profile=$(read_single_line "$lock_dir/profile" || true)
    valid_profile_id "$existing_profile" \
      || die "The Agent session lock contains an invalid profile; refusing to steal it."
    if kill -0 "$existing_pid" 2>/dev/null; then
      die "Another Agent container session is running (PID $existing_pid). Concurrent sessions are disabled because of Apple container issue #1097."
    fi
    rm -f "$lock_dir/pid" "$lock_dir/profile"
    rmdir "$lock_dir" 2>/dev/null || true
    mkdir "$lock_dir" || die "Unable to acquire native session lock at $lock_dir."
  fi
  global_lock_acquired=true
  printf '%s\n' "$$" > "$lock_dir/pid"
  printf '%s\n' "$profile_id" > "$lock_dir/profile"
fi

# Even after cross-profile concurrency is explicitly accepted, one session per
# profile prevents two builds from racing on its fixed, provenance-tracked tag.
if ! mkdir "$profile_lock_dir" 2>/dev/null; then
  [ -d "$profile_lock_dir" ] && [ ! -L "$profile_lock_dir" ] \
    || die "Unable to safely inspect the profile session lock at $profile_lock_dir."
  [ -f "$profile_lock_dir/pid" ] && [ ! -L "$profile_lock_dir/pid" ] \
    || die "The profile session lock has no trustworthy PID; refusing to steal it."
  profile_lock_pid=$(read_single_line "$profile_lock_dir/pid" || true)
  case "$profile_lock_pid" in
    ''|0|1|*[!0-9]*) die "The profile session lock contains an invalid PID; refusing to steal it." ;;
  esac
  profile_lock_profile=$(read_single_line "$profile_lock_dir/profile" || true)
  [ "$profile_lock_profile" = "$profile_id" ] \
    || die "The profile session lock has mismatched profile provenance; refusing to steal it."
  if kill -0 "$profile_lock_pid" 2>/dev/null; then
    die "Another '$profile_id' Agent session is running (PID $profile_lock_pid). Same-profile sessions are serialized to protect image provenance."
  fi
  rm -f "$profile_lock_dir/pid" "$profile_lock_dir/profile"
  rmdir "$profile_lock_dir" 2>/dev/null || true
  mkdir "$profile_lock_dir" \
    || die "Unable to acquire the '$profile_id' profile session lock."
fi
profile_lock_acquired=true
printf '%s\n' "$$" > "$profile_lock_dir/pid"
printf '%s\n' "$profile_id" > "$profile_lock_dir/profile"

mkdir "$host_stage_dir"
printf '%s\n' "$$" > "$host_stage_dir/pid"
printf '%s\n' "$profile_id" > "$host_stage_dir/profile"

# Registration is now visible to an uninstaller holding the same lifecycle
# mutex. Release the short gate so explicitly accepted concurrent sessions can
# coexist; uninstall will acquire it, observe these live registrations, and
# fail before mutation.
release_lifecycle_lock
trap - INT TERM HUP

rm -f "$host_stage_dir/gitconfig"
gitconfig_tmp=$(mktemp "$host_stage_dir/.gitconfig.XXXXXX") \
  || die "Unable to create temporary Git configuration staging."
if [ "$full_git_config" = true ]; then
  if [ -f "$host_home_dir/.gitconfig" ]; then
    cp "$host_home_dir/.gitconfig" "$gitconfig_tmp"
  fi
  chmod 0600 "$gitconfig_tmp"
else
  # Extract only identity values. Never copy include/includeIf, credential,
  # http, url, or other arbitrary host Git configuration by default.
  git_user_name=""
  git_user_email=""
  if command -v git >/dev/null 2>&1; then
    git_user_name=$(git config --global --get user.name 2>/dev/null || true)
    git_user_email=$(git config --global --get user.email 2>/dev/null || true)
  fi
  if [ -n "$git_user_name" ]; then
    git config --file "$gitconfig_tmp" user.name "$git_user_name"
  fi
  if [ -n "$git_user_email" ]; then
    git config --file "$gitconfig_tmp" user.email "$git_user_email"
  fi
fi
mv "$gitconfig_tmp" "$host_stage_dir/gitconfig"
gitconfig_tmp=""

if [ "$mount_ssh_config" = true ]; then
  mkdir "$host_stage_dir/ssh"
  chmod 0700 "$host_stage_dir/ssh"
  for ssh_metadata in config known_hosts known_hosts.old allowed_signers; do
    if [ -f "$host_home_dir/.ssh/$ssh_metadata" ] \
      && [ ! -L "$host_home_dir/.ssh/$ssh_metadata" ]; then
      cp "$host_home_dir/.ssh/$ssh_metadata" "$host_stage_dir/ssh/$ssh_metadata"
      chmod 0600 "$host_stage_dir/ssh/$ssh_metadata"
    fi
  done
fi

requested_agent_version="${AGENT_CONTAINER_VERSION:-$profile_version}"
case "$requested_agent_version" in
  latest)
    curl_bin=$(command -v curl || true)
    [ -n "$curl_bin" ] \
      || die "curl is required to resolve the $profile_display_name latest channel."
    agent_version_response=$(mktemp "$host_stage_dir/.agent-version-response.XXXXXX") \
      || die "Unable to create temporary storage for native CLI version resolution."
    if ! "$curl_bin" \
      --fail \
      --silent \
      --show-error \
      --location \
      --connect-timeout 10 \
      --max-time 60 \
      --max-filesize 1048576 \
      --proto '=https' \
      --tlsv1.2 \
      "$profile_installer_version_url" \
      --output "$agent_version_response"; then
      rm -f "$agent_version_response"
      die "Unable to resolve the $profile_display_name latest channel from $profile_installer_version_url. Enable the host proxy (for example, proxy_on), or set AGENT_CONTAINER_VERSION to an exact version to run without the lookup."
    fi
    agent_version_response_size=$(wc -c < "$agent_version_response" | tr -d '[:space:]')
    case "$agent_version_response_size" in
      ''|*[!0-9]*)
        rm -f "$agent_version_response"
        die "The $profile_display_name version channel returned an invalid response size."
        ;;
    esac
    if [ "$agent_version_response_size" -le 0 ] \
      || [ "$agent_version_response_size" -gt 1048576 ]; then
      rm -f "$agent_version_response"
      die "The $profile_display_name version channel returned an unsafe response size."
    fi
    if ! agent_version=$("$osascript_bin" -l JavaScript - \
      "$agent_version_response" "$profile_installer_version_format" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('version response is not readable UTF-8');
  const text = ObjC.unwrap(source);
  const format = argv[1];
  let version;
  if (format === 'plain-semver') {
    if (!/^[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9._-]+)?(?:\+[A-Za-z0-9._-]+)?\n?$/.test(text)) {
      throw new Error('plain version response is not one exact semver');
    }
    version = text.endsWith('\n') ? text.slice(0, -1) : text;
  } else if (format === 'rust-tag-json') {
    const value = JSON.parse(text);
