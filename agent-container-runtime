host_broker_pid=""
workspace_broker_pid=""
workspace_broker_watchdog_pid=""
workspace_broker_liveness_fifo=""
workspace_broker_liveness_reader_open=false
workspace_broker_liveness_writer_open=false
session_job_is_active() {
  local wanted_pid="$1"
  local job_pid job_state

  [ -n "$wanted_pid" ] || return 1
  # These PIDs always belong to asynchronous children of this shell.  Consult
  # Bash's job table instead of probing the numeric PID: after a child exits,
  # kill -0 can accidentally match an unrelated process that reused its PID.
  for job_state in -pr -ps; do
    while IFS= read -r job_pid; do
      [ "$job_pid" = "$wanted_pid" ] && return 0
    done < <(jobs "$job_state" 2>/dev/null)
  done
  return 1
}
stop_host_broker() {
  local stop_attempt
  [ -n "$host_broker_pid" ] || return 0
  if session_job_is_active "$host_broker_pid"; then
    kill -TERM "$host_broker_pid" 2>/dev/null || true
    stop_attempt=0
    while session_job_is_active "$host_broker_pid" \
      && [ "$stop_attempt" -lt 50 ]; do
      sleep 0.1
      stop_attempt=$((stop_attempt + 1))
    done
    if session_job_is_active "$host_broker_pid"; then
      kill -KILL "$host_broker_pid" 2>/dev/null || true
    fi
  fi
  wait "$host_broker_pid" 2>/dev/null || true
  host_broker_pid=""
}
stop_workspace_broker_watchdog() {
  [ -n "$workspace_broker_watchdog_pid" ] || return 0
  if session_job_is_active "$workspace_broker_watchdog_pid"; then
    kill -TERM "$workspace_broker_watchdog_pid" 2>/dev/null || true
  fi
  wait "$workspace_broker_watchdog_pid" 2>/dev/null || true
  workspace_broker_watchdog_pid=""
}
close_workspace_broker_liveness() {
  if [ "$workspace_broker_liveness_reader_open" = true ]; then
    exec 8<&-
    workspace_broker_liveness_reader_open=false
  fi
  if [ "$workspace_broker_liveness_writer_open" = true ]; then
    exec 7>&-
    workspace_broker_liveness_writer_open=false
  fi
  if [ -n "$workspace_broker_liveness_fifo" ]; then
    case "$workspace_broker_liveness_fifo" in
      "$host_stage_dir"/workspace-broker.liveness)
        rm -f -- "$workspace_broker_liveness_fifo" 2>/dev/null || true
        ;;
    esac
    workspace_broker_liveness_fifo=""
  fi
}
cleanup_session() {
  local cleanup_status=$?

  trap '' INT TERM HUP
  trap - EXIT
  set +e
  close_workspace_broker_liveness
  stop_workspace_broker_watchdog
  if [ -n "$workspace_broker_pid" ] \
    && session_job_is_active "$workspace_broker_pid"; then
    kill -TERM "$workspace_broker_pid" 2>/dev/null || true
  fi
  if [ -n "$workspace_broker_pid" ]; then
    wait "$workspace_broker_pid" 2>/dev/null || true
  fi
  workspace_broker_pid=""
  stop_host_broker
  if [ -n "$gitconfig_tmp" ]; then
    rm -f "$gitconfig_tmp" || true
  fi
  # The per-session directory can contain opted-in Git credentials and SSH
  # metadata. Remove all staging regardless of how the child exits.
  if [ -d "$host_stage_dir" ] || [ -L "$host_stage_dir" ]; then
    rm -rf "$host_stage_dir" || true
  fi
  if [ "$profile_lock_acquired" = true ] && [ -d "$profile_lock_dir" ]; then
    rm -f "$profile_lock_dir/pid" "$profile_lock_dir/profile"
    rmdir "$profile_lock_dir" 2>/dev/null || true
  fi
  if [ "$global_lock_acquired" = true ] && [ -d "$lock_dir" ]; then
    rm -f "$lock_dir/pid" "$lock_dir/profile"
    rmdir "$lock_dir" 2>/dev/null || true
  fi
  release_lifecycle_lock
  return "$cleanup_status"
}
