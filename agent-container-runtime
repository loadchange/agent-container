    "$asset_dir/target/release/agent-container-launcher" \
    "$script_dir/agent-container-darwin-arm64" \
    "$asset_dir/agent-container-darwin-arm64" \
    "$script_dir/agent-container" \
    "$script_dir/agent-container-launcher" \
    "$asset_dir/agent-container-launcher" \
    "$script_dir/target/debug/agent-container-launcher" \
    "$asset_dir/target/debug/agent-container-launcher"; do
    [ -f "$candidate" ] && [ ! -L "$candidate" ] && [ -x "$candidate" ] \
      || continue
    candidate_path=$(/bin/realpath "$candidate" 2>/dev/null || true)
    [ -n "$candidate_path" ] && [ "$candidate_path" != "$runtime_path" ] \
      || continue
    workspace_launcher_bin="$candidate_path"
    return 0
  done
  die "The Rust agent-container launcher is unavailable; reinstall it or build target/release/agent-container-launcher."
}

run_singleton_client() {
  local broker_record broker_log broker_line broker_ready broker_signal_ready
  local watchdog_signal_ready
  local workspace_endpoint workspace_token workspace_port run_status
  local singleton_exec_pid=""
  local singleton_exec_launching=false
  local singleton_pending_signal_name=""
  local singleton_pending_signal_status=""
  local forward_env_name
  local -a singleton_exec_args singleton_forwarded_env_names

  singleton_exec_is_active_job() {
    local job_pid job_state

    [ -n "$singleton_exec_pid" ] || return 1
    for job_state in -pr -ps; do
      while IFS= read -r job_pid; do
        [ "$job_pid" = "$singleton_exec_pid" ] && return 0
      done < <(jobs "$job_state" 2>/dev/null)
    done
    return 1
  }

  handle_singleton_client_signal() {
    local signal_name="$1"
    local signal_status="$2"
    local stop_attempt=0

    if [ "$singleton_exec_launching" = true ]; then
      if [ -z "$singleton_pending_signal_status" ]; then
        singleton_pending_signal_name=$signal_name
        singleton_pending_signal_status=$signal_status
      fi
      return 0
    fi
    if [ -n "$singleton_pending_signal_status" ]; then
      signal_name=$singleton_pending_signal_name
      signal_status=$singleton_pending_signal_status
      singleton_pending_signal_name=""
      singleton_pending_signal_status=""
    fi

    # A non-job-control Bash starts asynchronous children with INT and QUIT
    # ignored. TERM is the reliable host-side request for Apple container CLI
    # teardown; the launcher itself still reports the user's original signal.
    trap '' INT TERM HUP
    set +e
    if singleton_exec_is_active_job; then
      kill -TERM "$singleton_exec_pid" 2>/dev/null || true
      while singleton_exec_is_active_job \
        && [ "$stop_attempt" -lt 50 ]; do
        sleep 0.1
        stop_attempt=$((stop_attempt + 1))
      done
      if singleton_exec_is_active_job; then
        kill -KILL "$singleton_exec_pid" 2>/dev/null || true
      fi
    fi
    [ -z "$singleton_exec_pid" ] \
      || wait "$singleton_exec_pid" 2>/dev/null || true
    singleton_exec_pid=""
    exit "$signal_status"
  }

  complete_singleton_exec_launch() {
    singleton_exec_launching=false
    if [ -n "$singleton_pending_signal_status" ]; then
      handle_singleton_client_signal \
        "$singleton_pending_signal_name" \
        "$singleton_pending_signal_status"
    fi
  }

  resolve_singleton_host_gateway
  resolve_workspace_launcher

  broker_record="$host_stage_dir/workspace-broker.record"
  broker_log="$host_stage_dir/workspace-broker.log"
  broker_signal_ready="$host_stage_dir/workspace-broker.signal-ready"
  watchdog_signal_ready="$host_stage_dir/workspace-broker-watchdog.signal-ready"
  : > "$broker_record"
  : > "$broker_log"

  # The lifecycle critical section ignores interactive signals. Both children
  # explicitly restore defaults and acknowledge that reset before the parent
  # may try to terminate and wait for them.
  (
    trap - INT TERM HUP
    # The BSD lock is tied to the shared open-file description.  A forked
    # watchdog must not keep the lifecycle mutex alive after the launcher
    # closes its own descriptor to admit another singleton client.
    exec 9<&-
    : > "$watchdog_signal_ready"
    exec sleep "$WORKSPACE_BROKER_READY_TIMEOUT_SECONDS"
  ) &
  workspace_broker_watchdog_pid=$!
  while [ ! -f "$watchdog_signal_ready" ] \
    && session_job_is_active "$workspace_broker_watchdog_pid"; do
    sleep 0.01
  done
  [ -f "$watchdog_signal_ready" ] \
    || die "Unable to start the workspace-broker readiness watchdog."
  rm -f "$watchdog_signal_ready"

  workspace_broker_liveness_fifo="$host_stage_dir/workspace-broker.liveness"
  [ ! -e "$workspace_broker_liveness_fifo" ] \
    || die "Workspace-broker liveness endpoint already exists."
  mkfifo -m 0600 -- "$workspace_broker_liveness_fifo" \
    || die "Unable to create the workspace-broker liveness endpoint."
  exec 7<> "$workspace_broker_liveness_fifo" \
    || die "Unable to open the workspace-broker liveness writer."
  workspace_broker_liveness_writer_open=true
  exec 8< "$workspace_broker_liveness_fifo" \
    || die "Unable to open the workspace-broker liveness reader."
  workspace_broker_liveness_reader_open=true
  rm -f -- "$workspace_broker_liveness_fifo" \
    || die "Unable to unlink the workspace-broker liveness endpoint."
  workspace_broker_liveness_fifo=""

  (
    trap - INT TERM HUP
    # The broker intentionally lives for the whole workspace connection, so
    # retaining fd 9 here would serialize clients for the whole Agent session.
    exec 9<&-
    # Only the launcher parent may retain the write end. The broker receives
    # the read end and tears down its socket as soon as that parent disappears.
    exec 7>&-
    : > "$broker_signal_ready"
    exec "$workspace_launcher_bin" \
      __workspace-broker "$mount_root" "$host_gateway" \
      --liveness-fd 8
  ) > "$broker_record" 2> "$broker_log" &
  workspace_broker_pid=$!
  exec 8<&-
  workspace_broker_liveness_reader_open=false
  while [ ! -f "$broker_signal_ready" ] \
    && session_job_is_active "$workspace_broker_pid" \
    && session_job_is_active "$workspace_broker_watchdog_pid"; do
    sleep 0.01
  done
  [ -f "$broker_signal_ready" ] \
    || die "Unable to start the workspace broker safely."
  rm -f "$broker_signal_ready"

  broker_ready=false
  while session_job_is_active "$workspace_broker_pid" \
    && session_job_is_active "$workspace_broker_watchdog_pid"; do
    if IFS= read -r broker_line < "$broker_record"; then
      if session_job_is_active "$workspace_broker_pid" \
        && session_job_is_active "$workspace_broker_watchdog_pid"; then
        broker_ready=true
      fi
      break
    fi
    sleep 0.05
  done
  stop_workspace_broker_watchdog
  if [ "$broker_ready" != true ]; then
    broker_line=$(sed -n '1p' "$broker_log" 2>/dev/null || true)
    [ -n "$broker_line" ] \
      || broker_line="the broker did not publish an endpoint"
    die "Unable to start the workspace broker: $broker_line"
  fi
  IFS=$'\t' read -r workspace_endpoint workspace_token < "$broker_record" \
    || die "The workspace broker returned an incomplete endpoint record."
  cmp -s "$broker_record" \
    <(printf '%s\t%s\n' "$workspace_endpoint" "$workspace_token") \
    || die "The workspace broker returned an invalid multi-line endpoint record."
  [ "${#workspace_token}" -eq 64 ] \
    || die "The workspace broker returned an invalid token length."
  case "$workspace_token" in
    *[!0-9a-f]*) die "The workspace broker returned an invalid token." ;;
  esac
  workspace_port=""
  case "$workspace_endpoint" in
    "$host_gateway":*) workspace_port=${workspace_endpoint#"$host_gateway:"} ;;
  esac
  case "$workspace_port" in
    ''|0|0*|*[!0-9]*) workspace_port="" ;;
  esac
  [ -n "$workspace_port" ] \
    && [ "${#workspace_port}" -le 5 ] \
    && [ "$workspace_port" -le 65535 ] 2>/dev/null \
    || die "The workspace broker returned an invalid endpoint."
  session_job_is_active "$workspace_broker_pid" \
    || die "The workspace broker exited after publishing its endpoint."

  export AGENT_WORKSPACE_ENDPOINT="$workspace_endpoint"
  export AGENT_WORKSPACE_TOKEN="$workspace_token"
  singleton_exec_args=(
    exec
    --interactive
    --uid 0
    --gid 0
    --workdir /
    --env AGENT_WORKSPACE_ENDPOINT
    --env AGENT_WORKSPACE_TOKEN
    --env "HOME=$host_home_dir"
    --env "USER=agent-host"
    --env "LOGNAME=agent-host"
    --env "SHELL=/bin/bash"
    --env "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    --env "GIT_CONFIG_GLOBAL=/run/agent-host/gitconfig"
  )
  if [ -t 0 ] && [ -t 1 ]; then
    singleton_exec_args+=(--tty)
  fi
  [ -n "${TERM:-}" ] \
    && singleton_exec_args+=(--env "TERM=$TERM")
  [ -n "${COLORTERM:-}" ] \
    && singleton_exec_args+=(--env "COLORTERM=$COLORTERM")
  [ -z "$profile_disable_update_env" ] \
    || singleton_exec_args+=(--env "$profile_disable_update_env=1")

  singleton_forwarded_env_names=()
  if [ "$profile_credential_forward_mode" = true ]; then
    [ -n "$profile_api_key_env" ] \
      || die "Profile '$profile_id' does not recognize an API-key environment variable."
    printenv "$profile_api_key_env" >/dev/null 2>&1 \
      || die "--container-forward-api-key is enabled, but no credential recognized for profile '$profile_id' is set and exported."
    singleton_exec_args+=(--env "$profile_api_key_env")
    singleton_forwarded_env_names+=("$profile_api_key_env")
  fi
  if [ "${#explicit_forward_env_names[@]}" -gt 0 ]; then
    for forward_env_name in "${explicit_forward_env_names[@]}"; do
      printenv "$forward_env_name" >/dev/null 2>&1 \
        || die "Explicitly requested environment variable '$forward_env_name' became unavailable before client attach."
      if [ "${#singleton_forwarded_env_names[@]}" -eq 0 ] \
        || ! array_contains_value \
          "$forward_env_name" "${singleton_forwarded_env_names[@]}"; then
        singleton_exec_args+=(--env "$forward_env_name")
        singleton_forwarded_env_names+=("$forward_env_name")
      fi
    done
  fi

  # The persistent VM references only profile-scoped staging. Remove this
  # launcher's live registration before releasing the lifecycle mutex so other
  # clients can attach concurrently while this container exec remains active.
  [ -d "$host_stage_dir" ] && [ ! -L "$host_stage_dir" ] \
    || die "Singleton client staging became unsafe before attach."
  rm -rf -- "$host_stage_dir" \
    || die "Unable to remove singleton client staging before attach."

  # Install client traps before releasing the lifecycle mutex. Signals were
  # intentionally ignored throughout the preceding native critical section;
  # from this point through child-PID publication they are retained and replayed.
  singleton_exec_launching=true
  trap 'handle_singleton_client_signal INT 130' INT
  trap 'handle_singleton_client_signal TERM 143' TERM
  trap 'handle_singleton_client_signal HUP 129' HUP
  release_lifecycle_lock
  complete_singleton_exec_launch
  set +e
  singleton_exec_launching=true
  (
    # The Apple CLI must not keep its own launcher alive by retaining the
    # broker-owner write end after the parent is killed.
    exec 7>&-
    exec "$container_bin" "${singleton_exec_args[@]}" \
      "$singleton_container_name" \
      /usr/local/bin/agent-workspace-session \
      "$mount_root" "$host_workspace" "$host_uid" "$host_gid" \
      "$profile_command" "$@"
  ) <&0 &
  singleton_exec_pid=$!
  complete_singleton_exec_launch
  wait "$singleton_exec_pid"
  run_status=$?
  singleton_exec_pid=""
  set -e
  close_workspace_broker_liveness
  if session_job_is_active "$workspace_broker_pid"; then
    kill -TERM "$workspace_broker_pid" 2>/dev/null || true
  fi
  wait "$workspace_broker_pid" 2>/dev/null || true
  workspace_broker_pid=""
  trap - INT TERM HUP
  exit "$run_status"
}

# A launcher killed with SIGKILL cannot run its EXIT cleanup, and Apple can keep
# an attached auto-remove container alive when its client disappears. Reconcile the
# native resource first, while the lifecycle mutex prevents a new launcher or
# uninstall transaction from publishing another session concurrently.
native_records=$(list_native_agent_containers)
singleton_existing=false
singleton_existing_state=""
singleton_existing_creator_pid=""
singleton_existing_config_hash=""
while IFS=$'\t' read -r \
  native_id native_owned native_profile native_uid native_pid \
  native_mode native_roots_hash native_config_hash native_state; do
  [ -n "$native_id" ] || continue

  if [ "$native_mode" = singleton ] \
    || [ "$native_id" = "$singleton_container_name" ]; then
    validate_singleton_native_record \
      "$native_id" "$native_owned" "$native_profile" "$native_uid" \
      "$native_pid" "$native_mode" "$native_roots_hash" \
      "$native_config_hash"
    if [ "$native_id" != "$singleton_container_name" ]; then
      continue
    fi
    [ "$singleton_requested" = true ] \
      || die "A persistent '$profile_id' singleton is active or stopped. Stop it before using legacy run mode: agent-container singleton stop $profile_id"
    [ "$singleton_existing" = false ] \
      || die "Apple container returned duplicate records for '$singleton_container_name'."
    singleton_existing=true
    singleton_existing_state="$native_state"
    singleton_existing_creator_pid="$native_pid"
    singleton_existing_config_hash="$native_config_hash"
    continue
  fi

  [ "$native_owned" = true ] \
    || die "Container '$native_id' occupies an agent-container session name but lacks project ownership labels."
  valid_profile_id "$native_profile" \
    || die "Managed native container '$native_id' has an invalid profile label."
  [ "$native_uid" = "$host_uid" ] \
    || die "Managed native container '$native_id' has an unexpected host UID label."
  case "$native_pid" in
    ''|0|1|*[!0-9]*)
      die "Managed native container '$native_id' has an invalid launcher PID label."
      ;;
  esac
  [ "$native_id" = "agent-$native_profile-$native_uid-$native_pid" ] \
    || die "Managed native container '$native_id' does not match its provenance labels."

  if kill -0 "$native_pid" 2>/dev/null; then
    if [ "$singleton_requested" = true ]; then
      die "A legacy Agent VM is active; stop it before starting the persistent '$profile_id' singleton."
    elif [ "$concurrent_sessions" != true ]; then
      die "Another managed Agent VM is active (container $native_id, launcher PID $native_pid)."
    fi
    continue
  fi

  warn "Removing orphaned Agent VM '$native_id' left by launcher PID $native_pid."
  "$container_bin" delete --force "$native_id" >/dev/null 2>&1 \
    || die "Unable to remove orphaned managed Agent VM '$native_id'."
done <<EOF
$native_records
EOF

# Remove only complete, dead registrations. Malformed records fail closed
# because their directories may hold opted-in Git or SSH material.
for session_dir in "$sessions_root"/session-*; do
  [ -e "$session_dir" ] || [ -L "$session_dir" ] || continue
  [ -d "$session_dir" ] && [ ! -L "$session_dir" ] \
    || die "Unsafe Agent session registration: $session_dir"
  session_number=${session_dir##*/session-}
  case "$session_number" in
    ''|0|1|*[!0-9]*) die "Invalid Agent session registration name: $session_dir" ;;
  esac
  registered_pid=$(read_single_line "$session_dir/pid" || true)
  [ "$registered_pid" = "$session_number" ] \
    || die "Agent session registration has an invalid PID: $session_dir"
  registered_profile=$(read_single_line "$session_dir/profile" || true)
  valid_profile_id "$registered_profile" \
    || die "Agent session registration has an invalid profile: $session_dir"
  if kill -0 "$registered_pid" 2>/dev/null; then
    if [ "$singleton_requested" = true ]; then
      die "A legacy Agent session is registering or running; stop it before starting the persistent '$profile_id' singleton."
    elif [ "$concurrent_sessions" != true ]; then
      die "Another Agent session is registering or running (PID $registered_pid, profile $registered_profile)."
    fi
    continue
  fi
  warn "Removing stale Agent session staging for PID $registered_pid."
  rm -rf -- "$session_dir"
done

if [ "$singleton_requested" != true ] \
  && [ "$concurrent_sessions" != true ]; then
  if ! mkdir "$lock_dir" 2>/dev/null; then
    [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] \
      || die "Unable to safely inspect the Agent session lock at $lock_dir."
    [ -f "$lock_dir/pid" ] && [ ! -L "$lock_dir/pid" ] \
      || die "The Agent session lock has no trustworthy PID; refusing to steal it."
    existing_pid=$(read_single_line "$lock_dir/pid" || true)
    case "$existing_pid" in
      ''|*[!0-9]*) die "The Agent session lock contains an invalid PID; refusing to steal it." ;;
    esac
    [ "$existing_pid" -gt 1 ] \
      || die "The Agent session lock contains an unsafe PID; refusing to steal it."
    existing_profile=$(read_single_line "$lock_dir/profile" || true)
    valid_profile_id "$existing_profile" \
      || die "The Agent session lock contains an invalid profile; refusing to steal it."
    if kill -0 "$existing_pid" 2>/dev/null; then
      die "Another Agent container session is running (PID $existing_pid). Concurrent sessions are disabled because of Apple container issue #1097."
    fi
    rm -f "$lock_dir/pid" "$lock_dir/profile"
    rmdir "$lock_dir" 2>/dev/null || true
    mkdir "$lock_dir" || die "Unable to acquire native session lock at $lock_dir."
  fi
  global_lock_acquired=true
  printf '%s\n' "$$" > "$lock_dir/pid"
  printf '%s\n' "$profile_id" > "$lock_dir/profile"
fi

# Even after cross-profile concurrency is explicitly accepted, one legacy
# session per profile prevents two builds from racing on its fixed tag. A cold
# singleton launch instead keeps the stronger lifecycle mutex through READY.
if [ "$singleton_requested" != true ] \
  && ! mkdir "$profile_lock_dir" 2>/dev/null; then
  [ -d "$profile_lock_dir" ] && [ ! -L "$profile_lock_dir" ] \
    || die "Unable to safely inspect the profile session lock at $profile_lock_dir."
  [ -f "$profile_lock_dir/pid" ] && [ ! -L "$profile_lock_dir/pid" ] \
    || die "The profile session lock has no trustworthy PID; refusing to steal it."
  profile_lock_pid=$(read_single_line "$profile_lock_dir/pid" || true)
  case "$profile_lock_pid" in
    ''|0|1|*[!0-9]*) die "The profile session lock contains an invalid PID; refusing to steal it." ;;
  esac
  profile_lock_profile=$(read_single_line "$profile_lock_dir/profile" || true)
  [ "$profile_lock_profile" = "$profile_id" ] \
    || die "The profile session lock has mismatched profile provenance; refusing to steal it."
  if kill -0 "$profile_lock_pid" 2>/dev/null; then
    die "Another '$profile_id' Agent session is running (PID $profile_lock_pid). Same-profile sessions are serialized to protect image provenance."
  fi
  rm -f "$profile_lock_dir/pid" "$profile_lock_dir/profile"
  rmdir "$profile_lock_dir" 2>/dev/null || true
  mkdir "$profile_lock_dir" \
    || die "Unable to acquire the '$profile_id' profile session lock."
fi
if [ "$singleton_requested" != true ]; then
  profile_lock_acquired=true
  printf '%s\n' "$$" > "$profile_lock_dir/pid"
  printf '%s\n' "$profile_id" > "$profile_lock_dir/profile"
fi

mkdir "$host_stage_dir"
printf '%s\n' "$$" > "$host_stage_dir/pid"
printf '%s\n' "$profile_id" > "$host_stage_dir/profile"

host_node_bin=""
host_broker_bin=""
if [ "$run_mode" = true ]; then
  host_path_is_agent_writable() {
    local candidate_path=$1
    local writable_index=0
    if path_contains "$mount_root" "$candidate_path" \
      || path_contains "$state_root" "$candidate_path"; then
      return 0
    fi
    if [ -n "$common_git_dir" ] \
      && path_contains "$common_git_dir" "$candidate_path"; then
      return 0
    fi
    while [ "$writable_index" -lt "${#extra_share_paths[@]}" ]; do
      if [ "${extra_share_modes[$writable_index]}" = rw ] \
        && path_contains \
          "${extra_share_paths[$writable_index]}" \
          "$candidate_path"; then
        return 0
      fi
      writable_index=$((writable_index + 1))
    done
    return 1
  }

  # Agent binaries and launcher internals must remain in the verified guest.
  # A user blacklist is additive to this small mandatory set.
  host_exec_denied+=(
    "$profile_command"
    agent-container
    agent-host-exec
    host-exec
    claude-container
    codex-container
    grok-container
    container
    sudo
  )

  if [ -n "${AGENT_CONTAINER_HOST_BROKER_BIN:-}" ]; then
    case "$AGENT_CONTAINER_HOST_BROKER_BIN" in
      /*) ;;
      *) die "--container-host-broker must be an absolute path." ;;
    esac
    host_broker_bin=$(
      /bin/realpath "$AGENT_CONTAINER_HOST_BROKER_BIN" 2>/dev/null || true
    )
    [ -f "$host_broker_bin" ] && [ -x "$host_broker_bin" ] \
      || die "--container-host-broker is not executable: $host_broker_bin"
    ! host_path_is_agent_writable "$host_broker_bin" \
      || die "Refusing to execute the host broker from an Agent-writable root: $host_broker_bin"
  else
    host_node_command="${AGENT_CONTAINER_HOST_NODE_BIN:-$(command -v node || true)}"
    case "$host_node_command" in
      /*) ;;
      *) die "agent-container run requires a host Node.js executable for the host-exec broker." ;;
    esac
    host_node_command=$(
      /bin/realpath "$host_node_command" 2>/dev/null || true
    )
    [ -f "$host_node_command" ] && [ -x "$host_node_command" ] \
      || die "Host Node.js is not executable: $host_node_command"
    ! host_path_is_agent_writable "$host_node_command" \
      || die "Refusing to execute host Node.js from an Agent-writable root: $host_node_command"
    # Resolve version-manager shims while the user's normal shell environment
    # is still present; the broker later starts from an intentionally clean env.
    host_node_bin=$(
      "$host_node_command" -p 'process.execPath' 2>/dev/null || true
    )
    case "$host_node_bin" in
      /*) ;;
      *) die "Host Node.js could not resolve its native executable." ;;
    esac
    host_node_bin=$(/bin/realpath "$host_node_bin" 2>/dev/null || true)
    [ -f "$host_node_bin" ] && [ -x "$host_node_bin" ] \
      || die "Resolved host Node.js is not executable: $host_node_bin"
    ! host_path_is_agent_writable "$host_node_bin" \
      || die "Refusing a resolved host Node.js inside an Agent-writable root: $host_node_bin"
    host_broker_bin="$asset_dir/host-exec-broker.mjs"
  fi

  host_commands_tmp=$(mktemp "$host_stage_dir/.host-commands.XXXXXX") \
    || die "Unable to create the host command manifest."
  host_tool_roots_tmp=$(mktemp "$host_stage_dir/.host-tool-roots.XXXXXX") \
    || die "Unable to create the host tool-root manifest."
  host_seen_dir="$host_stage_dir/.host-command-seen"
  mkdir "$host_seen_dir"

  host_node_runtime_root=""
  if [ -n "$host_node_bin" ]; then
    host_node_runtime_root=$(dirname -- "$host_node_bin")
    if [ "$(basename -- "$host_node_runtime_root")" = bin ]; then
      node_install_prefix=$(dirname -- "$host_node_runtime_root")
      case "$node_install_prefix" in
        /) ;;
        *) host_node_runtime_root="$node_install_prefix" ;;
      esac
    fi
    if path_contains "$host_node_runtime_root" "$host_home_dir"; then
      host_node_runtime_root=$(dirname -- "$host_node_bin")
    fi
    case "$host_node_runtime_root" in
      ''|/|*:*|*$'\n'*|*$'\r'*|*$'\t'*) host_node_runtime_root="" ;;
    esac
    [ -z "$host_node_runtime_root" ] \
      || printf '%s\n' "$host_node_runtime_root" >> "$host_tool_roots_tmp"
  fi

  # Stock macOS developer commands are /usr/bin shims. Freeze common shims
  # (including Git and Python) to the selected Xcode/CommandLineTools
  # executables and admit their containing runtime tree read-only; this avoids
  # xcrun trying to create ambient host cache files inside the sandbox.
  host_developer_path=""
  host_developer_root=""
  if [ -x /usr/bin/xcode-select ]; then
    host_developer_path=$(/usr/bin/xcode-select -p 2>/dev/null || true)
  fi
  case "$host_developer_path" in
    /*)
      host_developer_path=$(resolve_absolute_dir "$host_developer_path" || true)
      ;;
    *) host_developer_path="" ;;
  esac
  case "$host_developer_path" in
    */Contents/Developer)
      host_developer_root=${host_developer_path%/Contents/Developer}
      ;;
    *) host_developer_root="$host_developer_path" ;;
  esac
  case "$host_developer_root" in
    /|*:*|*$'\n'*|*$'\r'*|*$'\t'*) host_developer_root="" ;;
  esac
  if [ -n "$host_developer_root" ] \
    && path_contains "$host_developer_root" "$host_home_dir"; then
    host_developer_root=""
  fi
  [ -z "$host_developer_root" ] \
    || printf '%s\n' "$host_developer_root" >> "$host_tool_roots_tmp"

  IFS=: read -r -a host_path_entries <<EOF
${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}
EOF
  for host_path_entry in "${host_path_entries[@]}"; do
    [ -n "$host_path_entry" ] || continue
    case "$host_path_entry" in
      /*) ;;
      *) continue ;;
    esac
    [ -d "$host_path_entry" ] || continue
    canonical_host_path=$(resolve_absolute_dir "$host_path_entry" || true)
    [ -n "$canonical_host_path" ] || continue
    case "$canonical_host_path" in
      *$'\n'*|*$'\r'*|*$'\t'*) continue ;;
    esac

    host_tool_root="$canonical_host_path"
    case "$canonical_host_path/" in
      "$host_home_dir/.nvm/"*) host_tool_root="$host_home_dir/.nvm" ;;
      "$host_home_dir/.pyenv/"*) host_tool_root="$host_home_dir/.pyenv" ;;
      /opt/homebrew/*) host_tool_root=/opt/homebrew ;;
      /usr/local/*) host_tool_root=/usr/local ;;
    esac
    printf '%s\n' "$host_tool_root" >> "$host_tool_roots_tmp"

    for host_candidate in "$canonical_host_path"/*; do
      [ -e "$host_candidate" ] || [ -L "$host_candidate" ] || continue
      [ -f "$host_candidate" ] || continue
      [ -x "$host_candidate" ] || continue
      host_command_name=$(basename -- "$host_candidate")
      valid_host_command_name "$host_command_name" || continue
      [ ! -e "$host_seen_dir/$host_command_name" ] || continue
      : > "$host_seen_dir/$host_command_name"
      array_contains_value "$host_command_name" "${host_exec_denied[@]}" \
        && continue
      host_command_mode=fallback
      if array_contains_value "$host_command_name" "${host_exec_first[@]}"; then
        host_command_mode=first
      fi
      host_executable="$host_candidate"
      if [ "$host_command_name" = node ] && [ -n "$host_node_bin" ]; then
        candidate_node=$(/bin/realpath "$host_candidate" 2>/dev/null || true)
        if [ "$candidate_node" = "$host_node_command" ] \
          || [ "$candidate_node" = "$host_node_bin" ]; then
          # A version-manager shim was already executed and validated during
          # bootstrap. Freeze direct host `node` calls to its process.execPath
          # so the sandbox does not need mutable shim/cache behavior at runtime.
          host_executable="$host_node_bin"
        fi
      fi
      selected_developer_tool=""
      case "$host_command_name" in
        ar|as|c++|cc|clang|clang++|gcc|git|ld|libtool|lipo|make|nm|otool|pip3|python3|ranlib|size|strings|strip|swift|swiftc|xcodebuild)
          if [ "$host_candidate" = "/usr/bin/$host_command_name" ] \
            && [ -n "$host_developer_path" ]; then
            for developer_tool_candidate in \
              "$host_developer_path/usr/bin/$host_command_name" \
              "$host_developer_path/Toolchains/XcodeDefault.xctoolchain/usr/bin/$host_command_name"; do
              if [ -f "$developer_tool_candidate" ] \
                && [ -x "$developer_tool_candidate" ]; then
                selected_developer_tool="$developer_tool_candidate"
                break
              fi
            done
          fi
          ;;
      esac
      if [ -n "$selected_developer_tool" ]; then
        case "$selected_developer_tool" in
          "$host_developer_root"/*)
            [ -f "$selected_developer_tool" ] \
              && [ -x "$selected_developer_tool" ] \
              && host_executable="$selected_developer_tool"
            ;;
        esac
      fi
      case "$host_executable" in
        *$'\n'*|*$'\r'*|*$'\t'*) continue ;;
      esac
      canonical_host_executable=$(
        /bin/realpath "$host_executable" 2>/dev/null || true
      )
      [ -f "$canonical_host_executable" ] \
        && [ -x "$canonical_host_executable" ] \
        || continue
      executable_in_tool_root=false
      for executable_root in \
        "$host_tool_root" \
        "$host_node_runtime_root" \
        "$host_developer_root" \
        /bin /sbin /usr/bin /usr/sbin; do
        [ -n "$executable_root" ] || continue
        if path_contains "$executable_root" "$canonical_host_executable"; then
          executable_in_tool_root=true
          break
        fi
      done
      # A PATH directory may contain unrelated symlinks into arbitrary trees
      # (pipx/uv layouts are common). Skip only that basename instead of writing
      # a manifest entry that would make the broker reject the entire session.
      [ "$executable_in_tool_root" = true ] || continue
      printf '%s\t%s\t%s\n' \
        "$host_command_mode" "$host_command_name" "$canonical_host_executable" \
        >> "$host_commands_tmp"
    done
  done

  rm -rf "$host_seen_dir"
  mv "$host_commands_tmp" "$host_stage_dir/host-commands.tsv"
  sort -u "$host_tool_roots_tmp" > "$host_stage_dir/host-tool-roots.txt"
  rm -f "$host_tool_roots_tmp"
  chmod 0600 \
    "$host_stage_dir/host-commands.tsv" \
    "$host_stage_dir/host-tool-roots.txt"

  host_roots_tmp=$(mktemp "$host_stage_dir/.host-roots.XXXXXX") \
    || die "Unable to create the host-exec root manifest."
  printf 'rw\t%s\n' "$mount_root" >> "$host_roots_tmp"
  if [ -n "$common_git_dir" ] \
    && ! path_contains "$mount_root" "$common_git_dir"; then
    printf 'rw\t%s\n' "$common_git_dir" >> "$host_roots_tmp"
  fi
  share_index=0
  while [ "$share_index" -lt "${#extra_share_paths[@]}" ]; do
    printf '%s\t%s\n' \
      "${extra_share_modes[$share_index]}" \
      "${extra_share_paths[$share_index]}" \
      >> "$host_roots_tmp"
    share_index=$((share_index + 1))
  done
  mv "$host_roots_tmp" "$host_stage_dir/host-roots.tsv"
  chmod 0600 "$host_stage_dir/host-roots.tsv"

  host_exec_token=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null \
    | od -An -tx1 | tr -d ' \n')
  case "$host_exec_token" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
    *) die "Unable to generate a host-exec session token." ;;
  esac
  [ "${#host_exec_token}" -eq 64 ] \
    || die "Unable to generate a complete host-exec session token."
  atomic_write_line "$host_stage_dir/host-exec-token" "$host_exec_token"
fi

# Legacy registration is now visible to an uninstaller holding the same
# lifecycle mutex. A cold singleton launch has no durable native registration
# yet, so it keeps the gate through verified create, detached start, and READY.
if [ "$singleton_requested" != true ]; then
  release_lifecycle_lock
  trap - INT TERM HUP
fi

rm -f "$host_stage_dir/gitconfig"
gitconfig_tmp=$(mktemp "$host_stage_dir/.gitconfig.XXXXXX") \
  || die "Unable to create temporary Git configuration staging."
if [ "$full_git_config" = true ]; then
  if [ -f "$host_home_dir/.gitconfig" ]; then
    cp "$host_home_dir/.gitconfig" "$gitconfig_tmp"
  fi
  chmod 0600 "$gitconfig_tmp"
else
  # Extract only identity values. Never copy include/includeIf, credential,
  # http, url, or other arbitrary host Git configuration by default.
  git_user_name=""
  git_user_email=""
  if command -v git >/dev/null 2>&1; then
    git_user_name=$(git config --global --get user.name 2>/dev/null || true)
    git_user_email=$(git config --global --get user.email 2>/dev/null || true)
  fi
  if [ -n "$git_user_name" ]; then
    git config --file "$gitconfig_tmp" user.name "$git_user_name"
  fi
  if [ -n "$git_user_email" ]; then
    git config --file "$gitconfig_tmp" user.email "$git_user_email"
  fi
fi
mv "$gitconfig_tmp" "$host_stage_dir/gitconfig"
gitconfig_tmp=""

prepare_singleton_guest_stage() {
  local singleton_gitconfig_tmp singleton_ssh_stage ssh_metadata

  validate_managed_directory "$singleton_root"
  validate_managed_directory "$singleton_guest_stage"
  mkdir -p "$singleton_root" "$singleton_guest_stage"
  validate_managed_directory "$singleton_root"
  validate_managed_directory "$singleton_guest_stage"
  singleton_gitconfig_tmp=$(mktemp \
    "$singleton_guest_stage/.gitconfig.XXXXXX") \
    || die "Unable to stage persistent singleton Git identity."
  cp "$host_stage_dir/gitconfig" "$singleton_gitconfig_tmp"
  chmod 0600 "$singleton_gitconfig_tmp"
  if [ -L "$singleton_guest_stage/gitconfig" ] \
    || { [ -e "$singleton_guest_stage/gitconfig" ] \
      && [ ! -f "$singleton_guest_stage/gitconfig" ]; }; then
    rm -f "$singleton_gitconfig_tmp"
    die "Refusing an unsafe persistent singleton Git configuration path."
  fi
  mv -f "$singleton_gitconfig_tmp" "$singleton_guest_stage/gitconfig"

  singleton_ssh_stage="$singleton_guest_stage/ssh"
  validate_managed_directory "$singleton_ssh_stage"
  if [ "$mount_ssh_config" = true ]; then
    mkdir -p "$singleton_ssh_stage"
    chmod 0700 "$singleton_ssh_stage"
    for ssh_metadata in config known_hosts known_hosts.old allowed_signers; do
      rm -f "$singleton_ssh_stage/$ssh_metadata"
      if [ -f "$host_stage_dir/ssh/$ssh_metadata" ] \
        && [ ! -L "$host_stage_dir/ssh/$ssh_metadata" ]; then
        cp "$host_stage_dir/ssh/$ssh_metadata" \
          "$singleton_ssh_stage/$ssh_metadata"
        chmod 0600 "$singleton_ssh_stage/$ssh_metadata"
      fi
    done
  elif [ -d "$singleton_ssh_stage" ]; then
    rm -f \
      "$singleton_ssh_stage/config" \
      "$singleton_ssh_stage/known_hosts" \
      "$singleton_ssh_stage/known_hosts.old" \
      "$singleton_ssh_stage/allowed_signers"
    rmdir "$singleton_ssh_stage" 2>/dev/null || true
  fi
}

if [ "$mount_ssh_config" = true ]; then
  mkdir "$host_stage_dir/ssh"
  chmod 0700 "$host_stage_dir/ssh"
  for ssh_metadata in config known_hosts known_hosts.old allowed_signers; do
    if [ -f "$host_home_dir/.ssh/$ssh_metadata" ] \
      && [ ! -L "$host_home_dir/.ssh/$ssh_metadata" ]; then
      cp "$host_home_dir/.ssh/$ssh_metadata" "$host_stage_dir/ssh/$ssh_metadata"
      chmod 0600 "$host_stage_dir/ssh/$ssh_metadata"
    fi
  done
fi

requested_agent_version="${AGENT_CONTAINER_VERSION:-$profile_version}"
# A warm singleton is an intentionally pinned runtime. Normal launches reuse
# the version whose image and full configuration were already verified instead
# of turning every attach into an availability-dependent update check. An
# explicit --container-version (including `latest`) or rebuild request retains
# the caller's upgrade intent and follows the regular resolution path below.
if [ "$singleton_requested" = true ] \
  && [ "$singleton_existing" = true ] \
  && [ -z "${AGENT_CONTAINER_VERSION+x}" ] \
  && [ "$requested_agent_version" = latest ] \
  && ! is_true "${AGENT_CONTAINER_REBUILD:-false}"; then
  recorded_singleton_agent_version=$(read_single_line \
    "$singleton_agent_version_file" || true)
  valid_agent_version "$recorded_singleton_agent_version" \
    || die "The existing '$profile_id' singleton has no valid recorded Agent version. Stop it before recovery: agent-container singleton stop $profile_id"
  requested_agent_version="$recorded_singleton_agent_version"
fi
case "$requested_agent_version" in
  latest) version_lookup_required=true ;;
  *)
    valid_agent_version "$requested_agent_version" \
      || die "--container-version must be 'latest' or an exact native CLI version."
    version_lookup_required=false
    ;;
esac

extra_ca_bundle=""
extra_ca_fingerprint="none"
version_ca_bundle=""
if [ -n "$extra_ca_setting" ]; then
  staged_ca_bundle="$host_stage_dir/extra-ca-certificates.pem"
  case "$extra_ca_setting" in
    auto)
      installer_anchor="$host_stage_dir/.installer-anchor.pem"
      extract_macos_verified_anchor \
        "$profile_installer_url" "$installer_anchor" \
        || die "macOS could not verify and export the TLS trust anchor for $profile_installer_url. Pass --container-extra-ca /absolute/path.pem to authorize an explicit PEM bundle."
      mv "$installer_anchor" "$staged_ca_bundle"
      extra_ca_bundle="$staged_ca_bundle"
      if [ "$version_lookup_required" = true ]; then
        version_anchor="$host_stage_dir/.version-anchor.pem"
        extract_macos_verified_anchor \
          "$profile_installer_version_url" "$version_anchor" \
          || die "macOS could not verify and export the TLS trust anchor for $profile_installer_version_url. Pass --container-extra-ca /absolute/path.pem to authorize an explicit PEM bundle."
        version_ca_bundle="$version_anchor"
      fi
      ;;
    *)
      [ -f "$extra_ca_setting" ] && [ ! -L "$extra_ca_setting" ] \
        || die "--container-extra-ca must name a regular, non-symlink PEM file."
      extra_ca_source=$(/bin/realpath "$extra_ca_setting" 2>/dev/null || true)
      [ -n "$extra_ca_source" ] && [ -f "$extra_ca_source" ] \
        && [ ! -L "$extra_ca_source" ] \
        || die "Unable to resolve --container-extra-ca safely: $extra_ca_setting"
      validate_extra_ca_bundle "$extra_ca_source" \
        || die "--container-extra-ca must contain only 1-64 valid, currently-valid CA certificates in PEM form and be no larger than 1 MiB."
      extra_ca_source_fingerprint_before=$(sha256_file "$extra_ca_source")
      cp "$extra_ca_source" "$staged_ca_bundle"
      chmod 0600 "$staged_ca_bundle"
      extra_ca_source_fingerprint_after=$(sha256_file "$extra_ca_source")
      extra_ca_staged_fingerprint=$(sha256_file "$staged_ca_bundle")
      [ "$extra_ca_source_fingerprint_before" = "$extra_ca_source_fingerprint_after" ] \
        && [ "$extra_ca_source_fingerprint_after" = "$extra_ca_staged_fingerprint" ] \
        || die "The --container-extra-ca file changed while it was being frozen for the image build."
      extra_ca_bundle="$staged_ca_bundle"
      if [ "$version_lookup_required" = true ]; then
        version_ca_bundle="$staged_ca_bundle"
      fi
      warn "Extending the Agent image TLS trust store with the explicitly authorized CA bundle."
      ;;
  esac
  validate_extra_ca_bundle "$extra_ca_bundle" \
    || die "The staged extra CA bundle failed validation."
  if [ -n "$version_ca_bundle" ]; then
    validate_extra_ca_bundle "$version_ca_bundle" \
      || die "The staged version-endpoint CA bundle failed validation."
  fi
  extra_ca_fingerprint=$(sha256_file "$extra_ca_bundle")
fi

case "$requested_agent_version" in
  latest)
    curl_bin=$(command -v curl || true)
    [ -n "$curl_bin" ] \
      || die "curl is required to resolve the $profile_display_name latest channel."
    agent_version_response=$(mktemp "$host_stage_dir/.agent-version-response.XXXXXX") \
      || die "Unable to create temporary storage for native CLI version resolution."
    version_curl_args=(
      --disable
      --fail
      --silent
      --show-error
      --location
      --connect-timeout 10
      --max-time 60
      --max-filesize 1048576
      --proto '=https'
      --tlsv1.2
    )
    version_proxy_value=""
    if [ -n "$https_proxy_value" ]; then
      version_proxy_value="$https_proxy_value"
    elif [ -n "$all_proxy_value" ]; then
      version_proxy_value="$all_proxy_value"
    fi
    if [ -n "$version_proxy_value" ]; then
      version_curl_args+=(--proxy "$version_proxy_value")
      if host_proxy_resolve_value=$(
        host_proxy_resolve_override "$version_proxy_value"
      ); then
        version_curl_args+=(--resolve "$host_proxy_resolve_value")
      fi
    else
      # curl otherwise consults ambient upper- and lower-case proxy variables.
      version_curl_args+=(--proxy '')
    fi
    version_curl_args+=(--noproxy "$no_proxy_value")
    if [ -n "$version_ca_bundle" ]; then
      version_curl_args+=(
        --ca-native
        --cacert "$version_ca_bundle"
        --proxy-ca-native
        --proxy-cacert "$version_ca_bundle"
      )
    fi
    version_curl_args+=(
      "$profile_installer_version_url"
      --output "$agent_version_response"
    )
    if ! "$curl_bin" "${version_curl_args[@]}"; then
      rm -f "$agent_version_response"
      die "Unable to resolve the $profile_display_name latest channel from $profile_installer_version_url. Enable the host proxy, pass --container-extra-ca /absolute/path.pem for an explicitly trusted interception CA, or pass --container-version with an exact version to skip the lookup."
    fi
    agent_version_response_size=$(wc -c < "$agent_version_response" | tr -d '[:space:]')
    case "$agent_version_response_size" in
      ''|*[!0-9]*)
        rm -f "$agent_version_response"
        die "The $profile_display_name version channel returned an invalid response size."
        ;;
    esac
    if [ "$agent_version_response_size" -le 0 ] \
      || [ "$agent_version_response_size" -gt 1048576 ]; then
      rm -f "$agent_version_response"
      die "The $profile_display_name version channel returned an unsafe response size."
    fi
    if ! agent_version=$("$osascript_bin" -l JavaScript - \
      "$agent_version_response" "$profile_installer_version_format" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('version response is not readable UTF-8');
  const text = ObjC.unwrap(source);
  const format = argv[1];
  let version;
  if (format === 'plain-semver') {
    if (!/^[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9._-]+)?(?:\+[A-Za-z0-9._-]+)?\n?$/.test(text)) {
      throw new Error('plain version response is not one exact semver');
    }
    version = text.endsWith('\n') ? text.slice(0, -1) : text;
  } else if (format === 'rust-tag-json') {
    const value = JSON.parse(text);
    if (value === null || typeof value !== 'object' || Array.isArray(value)
        || typeof value.tag_name !== 'string' || !value.tag_name.startsWith('rust-v')) {
      throw new Error('release response has no rust-v tag_name');
    }
    version = value.tag_name.slice('rust-v'.length);
  } else {
    throw new Error('unsupported version response format');
  }
  if (!/^[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9._-]+)?(?:\+[A-Za-z0-9._-]+)?$/.test(version)) {
    throw new Error('resolved version is not an exact safe semver');
  }
  return version;
}
JXA
    ); then
      rm -f "$agent_version_response"
      die "The $profile_display_name version channel returned an invalid exact version."
    fi
    rm -f "$agent_version_response"
    printf 'Resolved %s latest channel to %s.\n' "$profile_display_name" "$agent_version" >&2
    ;;
  *)
    agent_version="$requested_agent_version"
    ;;
esac
if [ -n "$version_ca_bundle" ] \
  && [ "$version_ca_bundle" != "$extra_ca_bundle" ]; then
  rm -f -- "$version_ca_bundle"
  version_ca_bundle=""
fi
base_image="${AGENT_CONTAINER_BASE_IMAGE:-$DEFAULT_BASE_IMAGE}"
case "$base_image" in
  ''|*[!A-Za-z0-9._:/@-]*) die "--container-base-image is unsafe: $base_image" ;;
esac
asset_fingerprint=$(
  {
    sha256_file "$asset_dir/Containerfile"
    sha256_file "$asset_dir/Containerfile.dockerignore"
    sha256_file "$asset_dir/entrypoint.sh"
    sha256_file "$asset_dir/host-exec-client"
    sha256_file "$asset_dir/host-exec-broker.mjs"
    sha256_file "$asset_dir/agent-workspace-connect"
    sha256_file "$asset_dir/agent-workspace-session"
    sha256_file "$profile_file"
    printf '%s\n' "$agent_version"
    printf '%s\n' "$base_image"
    printf 'extra-ca-sha256=%s\n' "$extra_ca_fingerprint"
  } | sha256_stream
)
expected_build_id="$image_name:$asset_fingerprint"

inspected_image_identity=""
inspected_image_digest=""
inspect_image_metadata() {
  local inspected_ref="$1"
  local inspect_tmp="$host_stage_dir/.image-inspect.$$"
  local parsed_digest parsed_identity

  inspected_image_identity=""
  inspected_image_digest=""
  if ! "$container_bin" image inspect "$inspected_ref" > "$inspect_tmp" 2>/dev/null; then
    rm -f "$inspect_tmp"
    return 1
  fi
  if [ ! -s "$inspect_tmp" ]; then
    rm -f "$inspect_tmp"
    die "Apple image inspect returned empty metadata for '$inspected_ref'."
  fi

  # Apple container 1.2 emits a JSON array for `image inspect`, even for one
  # requested reference. Resolve exactly one index descriptor digest. The
  # create-before-start verification below proves that this same descriptor
  # was frozen into the stopped container before any Agent entrypoint runs.
  if ! parsed_digest=$("$osascript_bin" -l JavaScript - "$inspect_tmp" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('image inspect is not readable UTF-8');
  const images = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(images) || images.length !== 1) {
    throw new Error('image inspect must contain exactly one image');
  }
  const image = images[0];
  if (image === null || typeof image !== 'object' || Array.isArray(image)) {
    throw new Error('image inspect record must be an object');
  }
  const configuration = image.configuration;
  if (configuration === null || typeof configuration !== 'object'
      || Array.isArray(configuration)) {
    throw new Error('image configuration must be an object');
  }
  const descriptor = configuration.descriptor;
  if (descriptor === null || typeof descriptor !== 'object'
      || Array.isArray(descriptor)) {
    throw new Error('image descriptor must be an object');
  }
  const digest = descriptor.digest;
  if (typeof digest !== 'string' || !/^sha256:[0-9a-f]{64}$/.test(digest)) {
    throw new Error('image descriptor digest must be sha256:64hex');
  }
  return digest;
}
JXA
  ); then
    rm -f "$inspect_tmp"
    die "Apple image inspect returned an invalid or ambiguous descriptor for '$inspected_ref'."
  fi
  if ! parsed_identity=$(sha256_file "$inspect_tmp"); then
    rm -f "$inspect_tmp"
    die "Unable to fingerprint Apple image metadata for '$inspected_ref'."
  fi
  rm -f "$inspect_tmp"
  inspected_image_identity="$parsed_identity"
  inspected_image_digest="$parsed_digest"
}

build_required=false
image_identity=""
image_digest=""
recorded_build_id=""
recorded_image_identity=""
if inspect_image_metadata "$image_name"; then
  image_identity="$inspected_image_identity"
  image_digest="$inspected_image_digest"
else
  build_required=true
fi
recorded_build_id=$(read_single_line "$image_marker" || true)
recorded_image_identity=$(read_single_line "$image_identity_file" || true)
if [ "$build_required" = false ] \
  && { [ "$recorded_build_id" != "$expected_build_id" ] \
    || [ "$recorded_image_identity" != "$image_identity" ]; }; then
  build_required=true
fi
if is_true "${AGENT_CONTAINER_REBUILD:-false}"; then
  build_required=true
fi

if [ "$singleton_requested" = true ] \
  && [ "$singleton_existing" = true ] \
  && [ "$build_required" = true ]; then
  die "The running or stopped '$profile_id' singleton image is stale or a rebuild was requested. Stop the singleton before rebuilding it: agent-container singleton stop $profile_id"
fi

if [ "$build_required" = true ]; then
  if is_true "${AGENT_CONTAINER_SKIP_BUILD:-false}"; then
    die "Image '$image_name' is missing or stale, but image building is disabled."
  fi

  echo "Building $profile_display_name image '$image_name' (version $agent_version)..."
  build_args=(
    build
    --progress plain
    --tag "$image_name"
    --file Containerfile
    --platform linux/arm64
    --cpus "${AGENT_CONTAINER_BUILD_CPUS:-4}"
    --memory "${AGENT_CONTAINER_BUILD_MEMORY:-4g}"
    --label "com.loadchange.agent-container=true"
    --label "com.loadchange.agent-container.profile=$profile_id"
    --label "com.loadchange.agent-container.recipe=$asset_fingerprint"
    --build-arg "BASE_IMAGE=$base_image"
    --build-arg "AGENT_PROFILE=$profile_id"
    --build-arg "AGENT_INSTALLER_URL=$profile_installer_url"
    --build-arg "AGENT_INSTALLER_SHELL=$profile_installer_shell"
    --build-arg "AGENT_INSTALLER_VERSION_ENV=$profile_installer_version_env"
    --build-arg "AGENT_INSTALLER_BIN_DIR_ENV=$profile_installer_bin_dir_env"
    --build-arg "AGENT_INSTALLER_HOME_ENV=$profile_installer_home_env"
    --build-arg "AGENT_INSTALLER_NONINTERACTIVE_ENV=$profile_installer_noninteractive_env"
    --build-arg "AGENT_VERSION=$agent_version"
    --build-arg "AGENT_COMMAND=$profile_command"
    --build-arg "AGENT_PROBE_ARG=$profile_probe_arg"
    --build-arg "AGENT_CA_FINGERPRINT=$extra_ca_fingerprint"
  )

  if [ -n "$extra_ca_bundle" ]; then
    build_args+=(--secret "id=agent_ca_bundle,src=$extra_ca_bundle")
  fi

  [ -n "$http_proxy_value" ] && build_args+=(--build-arg "HTTP_PROXY=$http_proxy_value" --build-arg "http_proxy=$http_proxy_value")
  [ -n "$https_proxy_value" ] && build_args+=(--build-arg "HTTPS_PROXY=$https_proxy_value" --build-arg "https_proxy=$https_proxy_value")
  [ -n "$all_proxy_value" ] && build_args+=(--build-arg "ALL_PROXY=$all_proxy_value" --build-arg "all_proxy=$all_proxy_value")
  if [ -n "$http_proxy_value$https_proxy_value$all_proxy_value" ]; then
    build_args+=(--build-arg "NO_PROXY=$no_proxy_value" --build-arg "no_proxy=$no_proxy_value")
  fi
  [ -n "$dns1_value" ] && build_args+=(--dns "$dns1_value")
  [ -n "$dns2_value" ] && build_args+=(--dns "$dns2_value")
  if is_true "${AGENT_CONTAINER_REBUILD:-false}"; then
    build_args+=(--no-cache --pull)
  fi
  build_args+=(.)

  if ! (
    cd "$asset_dir"
    "$container_bin" "${build_args[@]}"
  ); then
    die "The $profile_display_name image build failed. If curl reported certificate error 60, pass --container-extra-ca /absolute/path.pem for the required CA bundle. The default macOS trust bridge is automatic, and TLS verification is never disabled."
  fi
  inspect_image_metadata "$image_name" \
    || die "The native image build completed, but '$image_name' could not be inspected."
  image_identity="$inspected_image_identity"
  image_digest="$inspected_image_digest"
  atomic_write_line "$image_marker" "$expected_build_id"
  atomic_write_line "$image_identity_file" "$image_identity"
fi
if [ -n "$extra_ca_bundle" ]; then
  rm -f -- "$extra_ca_bundle"
  extra_ca_bundle=""
  version_ca_bundle=""
fi
atomic_write_line "$image_ref_file" "$image_name"

if [ "$singleton_requested" = true ]; then
  valid_image_digest "$image_digest" \
    || die "The resolved '$profile_id' singleton image has an invalid descriptor digest."
  singleton_gitconfig_hash=$(sha256_file "$host_stage_dir/gitconfig")
  singleton_ssh_config_hash=none
  if [ "$mount_ssh_config" = true ]; then
    singleton_ssh_config_hash=$(sha256_tree "$host_stage_dir/ssh")
  fi
  singleton_gh_config_hash=none
  if [ -n "$gh_config_dir" ]; then
    singleton_gh_config_hash=$(sha256_tree "$gh_config_dir")
  fi
  singleton_git_xdg_config_hash=none
  if [ -n "$git_xdg_config_dir" ]; then
    singleton_git_xdg_config_hash=$(sha256_tree "$git_xdg_config_dir")
  fi
  singleton_ssh_agent_socket=none
  if [ "$forward_ssh_agent" = true ]; then
    [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ] \
      || die "--container-forward-ssh-agent requires SSH_AUTH_SOCK to name a live socket."
    singleton_ssh_agent_socket=$(/bin/realpath "$SSH_AUTH_SOCK" 2>/dev/null || true)
    [ -n "$singleton_ssh_agent_socket" ] \
      || die "Unable to resolve the SSH agent socket safely."
    reject_control_characters \
      "SSH agent socket path" "$singleton_ssh_agent_socket"
  fi
  singleton_config_hash=$(
    {
      printf 'runtime=%s\n' "$singleton_runtime_config_hash"
      printf 'recipe=%s\n' "$asset_fingerprint"
      printf 'image=%s\n' "$image_digest"
      printf 'agent-version=%s\n' "$agent_version"
      printf 'extra-ca=%s\n' "$extra_ca_fingerprint"
      printf 'full-git-config=%s\n' "$full_git_config"
      printf 'gitconfig=%s\n' "$singleton_gitconfig_hash"
      printf 'mount-gh=%s\n' "${gh_config_dir:-none}"
      printf 'gh-config=%s\n' "$singleton_gh_config_hash"
      printf 'git-xdg=%s\n' "${git_xdg_config_dir:-none}"
      printf 'git-xdg-config=%s\n' "$singleton_git_xdg_config_hash"
      printf 'mount-ssh-config=%s\n' "$mount_ssh_config"
      printf 'ssh-config=%s\n' "$singleton_ssh_config_hash"
      printf 'forward-ssh-agent=%s\n' "$forward_ssh_agent"
      printf 'ssh-agent-socket=%s\n' "$singleton_ssh_agent_socket"
    } | sha256_stream
  )

  if [ "$singleton_existing" = true ]; then
    [ "$singleton_existing_config_hash" = "$singleton_config_hash" ] \
      || die "Running '$profile_id' singleton configuration or image recipe differs from this launch. Stop it before changing VM, network, CA, or image settings."
    validate_singleton_state "$singleton_config_hash"
    [ "$singleton_existing_creator_pid" = "$singleton_state_creator_pid" ] \
      || die "The '$profile_id' singleton creator PID differs between container labels and managed state."
    [ "$singleton_state_image_digest" = "$image_digest" ] \
      || die "The '$profile_id' singleton image digest differs from the current verified profile image. Stop it before rebuilding."
    [ "$singleton_state_agent_version" = "$agent_version" ] \
      || die "The '$profile_id' singleton Agent version differs from the currently resolved version. Stop it before upgrading."
    singleton_inspect_tmp=$(mktemp \
      "$host_stage_dir/.singleton-inspect.XXXXXX") \
      || die "Unable to allocate singleton inspection storage."
    if ! "$container_bin" inspect "$singleton_container_name" \
      > "$singleton_inspect_tmp" 2>/dev/null; then
      rm -f "$singleton_inspect_tmp"
      die "The '$profile_id' singleton was listed but could not be inspected."
    fi
    case "$singleton_existing_state" in
      running)
        verify_singleton_container_inspect \
          "$singleton_inspect_tmp" running \
          "$singleton_state_image_digest" "$singleton_state_creator_pid" \
          || {
            rm -f "$singleton_inspect_tmp"
            die "The running '$profile_id' singleton failed full provenance verification."
          }
        rm -f "$singleton_inspect_tmp"
        prepare_singleton_guest_stage
        run_singleton_client "$@"
        ;;
      stopped)
        verify_singleton_container_inspect \
          "$singleton_inspect_tmp" stopped \
          "$singleton_state_image_digest" "$singleton_state_creator_pid" \
          || {
            rm -f "$singleton_inspect_tmp"
            die "The stopped '$profile_id' singleton failed full provenance verification and was retained."
          }
        rm -f "$singleton_inspect_tmp"
        warn "Removing a verified stopped '$profile_id' singleton before recreation."
        "$container_bin" delete --force "$singleton_container_name" \
          >/dev/null 2>&1 \
          || die "Unable to delete the verified stopped '$profile_id' singleton."
        clear_singleton_state_files "$singleton_root"
        singleton_existing=false
        ;;
      stopping)
        rm -f "$singleton_inspect_tmp"
        die "The '$profile_id' singleton is stopping; wait for it to become absent before launching again."
        ;;
      *)
        rm -f "$singleton_inspect_tmp"
        die "The '$profile_id' singleton has unsupported runtime state '$singleton_existing_state'."
        ;;
    esac
  fi
fi

if [ "$run_mode" = true ]; then
  host_gateway="${AGENT_CONTAINER_HOST_GATEWAY:-}"
  if [ -z "$host_gateway" ]; then
    network_inspect_tmp="$host_stage_dir/.network-inspect.$$"
    "$container_bin" network inspect default > "$network_inspect_tmp" 2>/dev/null \
      || die "Unable to inspect Apple's default container network for host-exec."
    host_gateway=$(
      "$osascript_bin" -l JavaScript - "$network_inspect_tmp" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('network inspect is not readable UTF-8');
  const networks = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(networks) || networks.length !== 1) {
    throw new Error('network inspect must contain exactly one network');
  }
  const gateway = networks[0]
    && networks[0].status
    && networks[0].status.ipv4Gateway;
  if (typeof gateway !== 'string'
      || !/^(?:[0-9]{1,3}\.){3}[0-9]{1,3}$/.test(gateway)) {
    throw new Error('default network has no IPv4 gateway');
  }
  return gateway;
}
JXA
    ) || {
      rm -f "$network_inspect_tmp"
      die "Apple's default container network returned an invalid host gateway."
    }
    rm -f "$network_inspect_tmp"
  fi
  if ! printf '%s\n' "$host_gateway" \
    | awk -F. 'NF == 4 { for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) exit 1; ok = 1 } END { exit !ok }'; then
    die "Unsafe host-exec gateway address: $host_gateway"
  fi

  rm -f "$host_stage_dir/host-exec-endpoint"
  broker_args=(
    --session-dir "$host_stage_dir"
    --bind-address "$host_gateway"
    --launcher-pid "$$"
    --real-home "$host_home_dir"
    --exec-home "$profile_host_exec_home"
    --sandbox-bin /usr/bin/sandbox-exec
  )
  host_broker_path=""
  broker_path_index=0
  developer_path_inserted=false
  while [ "$broker_path_index" -lt "${#host_path_entries[@]}" ]; do
    broker_path_entry=${host_path_entries[$broker_path_index]}
    broker_path_index=$((broker_path_index + 1))
    case "$broker_path_entry" in
      /*) ;;
      *) continue ;;
    esac
    [ -d "$broker_path_entry" ] || continue
    broker_path_entry=$(resolve_absolute_dir "$broker_path_entry" || true)
    case "$broker_path_entry" in
      ''|*:*|*$'\n'*|*$'\r'*|*$'\t'*) continue ;;
    esac
    if [ "$broker_path_entry" = /usr/bin ] \
      && [ "$developer_path_inserted" = false ] \
      && [ -n "$host_developer_root" ]; then
      for developer_bin_dir in \
        "$host_developer_path/usr/bin" \
        "$host_developer_path/Toolchains/XcodeDefault.xctoolchain/usr/bin"; do
        [ -d "$developer_bin_dir" ] || continue
        if [ -n "$host_broker_path" ]; then
          host_broker_path="$host_broker_path:$developer_bin_dir"
        else
          host_broker_path="$developer_bin_dir"
        fi
      done
      developer_path_inserted=true
    fi
    if [ -n "$host_broker_path" ]; then
      host_broker_path="$host_broker_path:$broker_path_entry"
    else
      host_broker_path="$broker_path_entry"
    fi
  done
  [ -n "$host_broker_path" ] \
    || host_broker_path=/usr/bin:/bin:/usr/sbin:/sbin
  broker_env=(
    "PATH=$host_broker_path"
    "HOME=$host_home_dir"
  )
  [ -n "${LANG:-}" ] && broker_env+=("LANG=$LANG")
  [ -n "${LC_ALL:-}" ] && broker_env+=("LC_ALL=$LC_ALL")
  [ -n "${LC_CTYPE:-}" ] && broker_env+=("LC_CTYPE=$LC_CTYPE")
  [ -n "${LC_MESSAGES:-}" ] && broker_env+=("LC_MESSAGES=$LC_MESSAGES")
  [ -n "${TZ:-}" ] && broker_env+=("TZ=$TZ")
  [ -n "${USER:-}" ] && broker_env+=("USER=$USER")
  [ -n "${LOGNAME:-}" ] && broker_env+=("LOGNAME=$LOGNAME")
  if [ "$forward_ssh_agent" = true ] \
    && [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    broker_env+=("SSH_AUTH_SOCK=$SSH_AUTH_SOCK")
  fi
  if [ -n "${AGENT_CONTAINER_HOST_BROKER_BIN:-}" ]; then
    env -i "${broker_env[@]}" \
      "$host_broker_bin" "${broker_args[@]}" \
      > "$host_stage_dir/host-exec-broker.log" 2>&1 &
  else
    env -i "${broker_env[@]}" \
      "$host_node_bin" "$host_broker_bin" "${broker_args[@]}" \
      > "$host_stage_dir/host-exec-broker.log" 2>&1 &
  fi
  host_broker_pid=$!

  broker_ready_attempt=0
  while [ ! -f "$host_stage_dir/host-exec-endpoint" ] \
    && session_job_is_active "$host_broker_pid" \
    && [ "$broker_ready_attempt" -lt 100 ]; do
    sleep 0.05
    broker_ready_attempt=$((broker_ready_attempt + 1))
  done
  host_exec_endpoint=$(read_single_line "$host_stage_dir/host-exec-endpoint" || true)
  host_exec_port=""
  case "$host_exec_endpoint" in
    "$host_gateway":*) host_exec_port=${host_exec_endpoint#"$host_gateway:"} ;;
  esac
  case "$host_exec_port" in
    ''|0|0*|*[!0-9]*) host_exec_port="" ;;
  esac
  if [ -z "$host_exec_port" ] \
    || [ "${#host_exec_port}" -gt 5 ] \
    || [ "$host_exec_port" -gt 65535 ] 2>/dev/null; then
    stop_host_broker
    die "The host-exec broker did not publish a valid session endpoint."
  fi
  chmod 0600 "$host_stage_dir/host-exec-endpoint" \
    "$host_stage_dir/host-exec-broker.log"
fi

if [ "$singleton_requested" = true ]; then
  prepare_singleton_guest_stage
  atomic_write_line "$singleton_config_hash_file" "$singleton_config_hash"
  atomic_write_line "$singleton_image_digest_file" "$image_digest"
  atomic_write_line "$singleton_agent_version_file" "$agent_version"
  atomic_write_line "$singleton_root/creator-pid" "$$"
  atomic_write_line "$singleton_phase_file" creating
  container_name="$singleton_container_name"
else
  container_name="agent-$profile_id-$host_uid-$$"
fi

create_args=(
  create
  --name "$container_name"
  --init
  --platform linux/arm64
  --cpus "${AGENT_CONTAINER_CPUS:-4}"
  --memory "${AGENT_CONTAINER_MEMORY:-4g}"
  --label "com.loadchange.agent-container=true"
  --label "com.loadchange.agent-container.profile=$profile_id"
  --label "com.loadchange.agent-container.host-uid=$host_uid"
  --label "com.loadchange.agent-container.launcher-pid=$$"
  --env "HOST_UID=$host_uid"
  --env "HOST_GID=$host_gid"
  --env "HOST_HOME=$host_home_dir"
  --env "AGENT_CONTAINER_PROFILE=$profile_id"
  --env "GIT_CONFIG_GLOBAL=/run/agent-host/gitconfig"
  --volume "$profile_home:$host_home_dir"
)

if [ "${#host_aliases[@]}" -gt 0 ] \
  || [ "${#blocked_hosts[@]}" -gt 0 ]; then
  if [ "$singleton_requested" = true ]; then
    resolve_singleton_host_gateway
    container_hosts_file="$singleton_guest_stage/container-hosts"
  else
    container_hosts_file="$host_stage_dir/container-hosts"
  fi
  {
    printf '%s\n' '127.0.0.1 localhost'
    for host_alias in "${host_aliases[@]}"; do
      printf '%s %s\n' "$host_gateway" "$host_alias"
    done
    for blocked_host in "${blocked_hosts[@]}"; do
      printf '0.0.0.0 %s\n' "$blocked_host"
      printf ':: %s\n' "$blocked_host"
    done
  } > "$container_hosts_file"
  chmod 0600 "$container_hosts_file"
  create_args+=(--volume "$container_hosts_file:/etc/hosts:ro")
fi

if [ "$singleton_requested" = true ]; then
  create_args+=(
    --cap-add CAP_SYS_ADMIN
    --label "com.loadchange.agent-container.mode=singleton"
    --label "com.loadchange.agent-container.config-sha256=$singleton_config_hash"
    --volume "$singleton_guest_stage:/run/agent-host:ro"
  )
else
  create_args+=(
    --rm
    --volume "$host_stage_dir:/run/agent-host:ro"
    --volume "$mount_root:$mount_root"
    --workdir "$host_workspace"
  )
  if [ -n "$common_git_dir" ] && [ -d "$common_git_dir" ]; then
    case "$common_git_dir/" in
      "$mount_root/"*) ;;
      *) create_args+=(--volume "$common_git_dir:$common_git_dir") ;;
    esac
  fi
