#!/bin/bash
set -euo pipefail

IMAGE_NAME="claude-code-docker"
VOLUME_NAME="claude-code-local"
CLAUDE_HOME="${CLAUDE_HOME:-$HOME/.claude}"
CONTAINER_CLAUDE_HOME="$HOME/.claude-docker"
CONTAINER_CLAUDE_JSON="$HOME/.claude-docker.json"

# --- Optional Configurations ---
# Global Proxy (e.g., http://192.168.1.100:7890)
CLAUDE_DOCKER_HTTP_PROXY="${CLAUDE_DOCKER_HTTP_PROXY:-}"
CLAUDE_DOCKER_HTTPS_PROXY="${CLAUDE_DOCKER_HTTPS_PROXY:-}"
CLAUDE_DOCKER_ALL_PROXY="${CLAUDE_DOCKER_ALL_PROXY:-}"
CLAUDE_DOCKER_NO_PROXY="${CLAUDE_DOCKER_NO_PROXY:-localhost,127.0.0.1}"

# Custom DNS
# Primary DNS (e.g., 8.8.8.8)
CLAUDE_DOCKER_DNS1="${CLAUDE_DOCKER_DNS1:-}"
# Secondary DNS (e.g., 8.8.4.4)
CLAUDE_DOCKER_DNS2="${CLAUDE_DOCKER_DNS2:-}"

# Timezone (e.g., Asia/Shanghai)
CLAUDE_DOCKER_TZ="${CLAUDE_DOCKER_TZ:-}"

# --- Check if Docker is available ---
if ! command -v docker &> /dev/null; then
  echo "Error: docker is not installed or not in PATH." >&2
  exit 1
fi

if ! docker info &> /dev/null; then
  echo "Error: Docker daemon is not running." >&2
  exit 1
fi

# --- Build Docker image ---
build_image() {
  echo "Building Docker image '$IMAGE_NAME'..."
  local tmpdir
  tmpdir=$(mktemp -d)
  trap "rm -rf '$tmpdir'" EXIT

  cat > "$tmpdir/entrypoint.sh" << 'ENTRYPOINT_EOF'
#!/bin/bash
set -e

# Create symbolic link to host-side path (run with root privileges)
# This is necessary because installed_plugins.json and other files reference absolute paths on the host.
if [ -n "$HOST_CLAUDE_HOME" ] && [ "$HOST_CLAUDE_HOME" != "/home/claude/.claude" ]; then
  mkdir -p "$(dirname "$HOST_CLAUDE_HOME")"
  ln -sfn /home/claude/.claude "$HOST_CLAUDE_HOME"
fi

# Change ownership of .local volume to the 'claude' user
chown -R claude:claude /home/claude/.local

# Install Claude Code if it's not already installed (as the 'claude' user)
if [ ! -x /home/claude/.local/bin/claude ]; then
  echo "Installing Claude Code..."
  su -s /bin/bash claude -c 'curl -fsSL https://claude.ai/install.sh | bash'
fi

# Adjust permissions for the mounted .ssh directory (copied because the mount is read-only)
if [ -d /home/claude/.ssh-host ]; then
  cp -a /home/claude/.ssh-host /home/claude/.ssh
  chown -R claude:claude /home/claude/.ssh
  chmod 700 /home/claude/.ssh
  chmod 600 /home/claude/.ssh/* 2>/dev/null || true
  chmod 644 /home/claude/.ssh/*.pub 2>/dev/null || true
  chmod 644 /home/claude/.ssh/known_hosts 2>/dev/null || true
  chmod 644 /home/claude/.ssh/config 2>/dev/null || true
fi

# Adjust permissions for the mounted .config/gh directory
if [ -d /home/claude/.config/gh ]; then
  chown -R claude:claude /home/claude/.config
fi

# Adjust permissions for the mounted .gitconfig file
if [ -f /home/claude/.gitconfig ]; then
  chown claude:claude /home/claude/.gitconfig
fi

# Change ownership of the workspace to the 'claude' user
chown claude:claude /workspace 2>/dev/null || true

# Execute the command as the 'claude' user
export HOME=/home/claude
exec setpriv --reuid=$(id -u claude) --regid=$(id -g claude) --init-groups env HOME=/home/claude "$@"
ENTRYPOINT_EOF

  cat > "$tmpdir/Dockerfile" << 'DOCKERFILE_EOF'
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl ca-certificates wget openssh-client && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p -m 755 /etc/apt/keyrings && \
    wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      > /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash claude

ENV PATH="/home/claude/.local/bin:${PATH}"

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
# Set ownership of the base directory for symbolic links to the 'claude' user
RUN mkdir -p /Users && chown claude:claude /Users

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
CMD ["claude"]
DOCKERFILE_EOF

  local build_args=()
  if [ -n "$CLAUDE_DOCKER_HTTP_PROXY" ]; then
    build_args+=(--build-arg "HTTP_PROXY=$CLAUDE_DOCKER_HTTP_PROXY" --build-arg "http_proxy=$CLAUDE_DOCKER_HTTP_PROXY")
  fi
  if [ -n "$CLAUDE_DOCKER_HTTPS_PROXY" ]; then
    build_args+=(--build-arg "HTTPS_PROXY=$CLAUDE_DOCKER_HTTPS_PROXY" --build-arg "https_proxy=$CLAUDE_DOCKER_HTTPS_PROXY")
  fi
  if [ -n "$CLAUDE_DOCKER_ALL_PROXY" ]; then
    build_args+=(--build-arg "ALL_PROXY=$CLAUDE_DOCKER_ALL_PROXY" --build-arg "all_proxy=$CLAUDE_DOCKER_ALL_PROXY")
  fi
  if [ -n "$CLAUDE_DOCKER_HTTP_PROXY" ] || [ -n "$CLAUDE_DOCKER_HTTPS_PROXY" ] || [ -n "$CLAUDE_DOCKER_ALL_PROXY" ]; then
    build_args+=(--build-arg "NO_PROXY=$CLAUDE_DOCKER_NO_PROXY" --build-arg "no_proxy=$CLAUDE_DOCKER_NO_PROXY")
  fi

  docker build -t "$IMAGE_NAME" ${build_args[@]+"${build_args[@]}"} "$tmpdir"

  trap - EXIT
  rm -rf "$tmpdir"
  echo "Docker image '$IMAGE_NAME' built successfully."
}

# --- Check if the image exists ---
if ! docker image inspect "$IMAGE_NAME" > /dev/null 2>&1; then
  build_image
fi

# --- Create Docker volume for Claude Code installations ---
docker volume create "$VOLUME_NAME" > /dev/null 2>&1 || true

# --- Prepare ~/.claude-docker/ for the container ---
mkdir -p "$CONTAINER_CLAUDE_HOME"

# Sync host configuration files (ensure latest settings are always reflected)
for f in settings.json CLAUDE.md; do
  if [ -f "$CLAUDE_HOME/$f" ]; then
    cp "$CLAUDE_HOME/$f" "$CONTAINER_CLAUDE_HOME/$f"
  fi
done

for d in hooks plugins commands agents; do
  if [ -d "$CLAUDE_HOME/$d" ]; then
    rm -rf "$CONTAINER_CLAUDE_HOME/$d"
    cp -a "$CLAUDE_HOME/$d" "$CONTAINER_CLAUDE_HOME/$d"
  fi
done

# --- Create ~/.claude.json (onboarding state) if it doesn't exist ---
if [ ! -s "$CONTAINER_CLAUDE_JSON" ]; then
  echo '{}' > "$CONTAINER_CLAUDE_JSON"
fi

# --- Mount host git/gh/ssh configurations ---
HOST_MOUNTS=()
if [ -f "$HOME/.gitconfig" ]; then
  HOST_MOUNTS+=(-v "$HOME/.gitconfig:/home/claude/.gitconfig")
fi
if [ -d "$HOME/.config/gh" ]; then
  HOST_MOUNTS+=(-v "$HOME/.config/gh:/home/claude/.config/gh")
fi
if [ -d "$HOME/.ssh" ]; then
  # Mount to a separate path so entrypoint.sh can copy and adjust permissions
  HOST_MOUNTS+=(-v "$HOME/.ssh:/home/claude/.ssh-host:ro")
fi

# --- Prepare optional Docker run arguments ---
DOCKER_ARGS=()

# Proxy
if [ -n "$CLAUDE_DOCKER_HTTP_PROXY" ]; then
  DOCKER_ARGS+=(-e "HTTP_PROXY=$CLAUDE_DOCKER_HTTP_PROXY" -e "http_proxy=$CLAUDE_DOCKER_HTTP_PROXY")
fi
if [ -n "$CLAUDE_DOCKER_HTTPS_PROXY" ]; then
  DOCKER_ARGS+=(-e "HTTPS_PROXY=$CLAUDE_DOCKER_HTTPS_PROXY" -e "https_proxy=$CLAUDE_DOCKER_HTTPS_PROXY")
fi
if [ -n "$CLAUDE_DOCKER_ALL_PROXY" ]; then
  DOCKER_ARGS+=(-e "ALL_PROXY=$CLAUDE_DOCKER_ALL_PROXY" -e "all_proxy=$CLAUDE_DOCKER_ALL_PROXY")
fi
if [ -n "$CLAUDE_DOCKER_HTTP_PROXY" ] || [ -n "$CLAUDE_DOCKER_HTTPS_PROXY" ] || [ -n "$CLAUDE_DOCKER_ALL_PROXY" ]; then
  DOCKER_ARGS+=(-e "NO_PROXY=$CLAUDE_DOCKER_NO_PROXY" -e "no_proxy=$CLAUDE_DOCKER_NO_PROXY")
fi

# DNS
if [ -n "$CLAUDE_DOCKER_DNS1" ]; then
  DOCKER_ARGS+=(--dns="$CLAUDE_DOCKER_DNS1")
fi
if [ -n "$CLAUDE_DOCKER_DNS2" ]; then
  DOCKER_ARGS+=(--dns="$CLAUDE_DOCKER_DNS2")
fi

# Timezone
if [ -n "$CLAUDE_DOCKER_TZ" ]; then
  DOCKER_ARGS+=(-e "TZ=$CLAUDE_DOCKER_TZ")
fi

# --- Start Claude (Claude will prompt for login if not authenticated) ---
exec docker run -it --rm \
  -e "HOST_CLAUDE_HOME=$CLAUDE_HOME" \
  --add-host host.docker.internal:host-gateway \
  -v "$VOLUME_NAME:/home/claude/.local" \
  -v "$CONTAINER_CLAUDE_HOME:/home/claude/.claude" \
  -v "$CONTAINER_CLAUDE_JSON:/home/claude/.claude.json" \
  -v "$(pwd):/workspace" \
  ${HOST_MOUNTS[@]+"${HOST_MOUNTS[@]}"} \
  ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"} \
  "$IMAGE_NAME" \
  claude "$@"
