share_index=0
while [ "$share_index" -lt "${#extra_share_paths[@]}" ]; do
  share_path="${extra_share_paths[$share_index]}"
  share_mode="${extra_share_modes[$share_index]}"
  if [ "$share_mode" = ro ]; then
    create_args+=(--volume "$share_path:$share_path:ro")
  else
    create_args+=(--volume "$share_path:$share_path")
  fi
  share_index=$((share_index + 1))
done

if [ -n "$gh_config_dir" ]; then
  create_args+=(--volume "$gh_config_dir:$host_home_dir/.config/gh:ro")
fi
if [ -n "$git_xdg_config_dir" ]; then
  create_args+=(--volume "$git_xdg_config_dir:$host_home_dir/.config/git:ro")
fi
if [ "$mount_ssh_config" = true ]; then
  if [ "$singleton_requested" = true ]; then
    create_args+=(--volume "$singleton_guest_stage/ssh:$host_home_dir/.ssh:ro")
  else
    create_args+=(--volume "$host_stage_dir/ssh:$host_home_dir/.ssh:ro")
  fi
fi
if [ "$forward_ssh_agent" = true ]; then
  [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ] \
    || die "--container-forward-ssh-agent is enabled, but SSH_AUTH_SOCK is not a live socket."
  create_args+=(--ssh)
fi

# Apple container 1.2 initializes terminal mode through stdin whenever both
# --interactive and --tty are present. Requiring both ends to be terminals
# avoids ENOTTY for the common `producer | agent-container ...` case where
# stdout is still attached to a terminal.
container_tty=false
if [ "$singleton_requested" != true ] \
  && [ -t 0 ] && [ -t 1 ]; then
  create_args+=(--tty)
  container_tty=true
fi
if [ "$singleton_requested" != true ]; then
  [ -n "${TERM:-}" ] && create_args+=(--env "TERM=$TERM")
  [ -n "${COLORTERM:-}" ] && create_args+=(--env "COLORTERM=$COLORTERM")
  if [ -n "$profile_disable_update_env" ]; then
    create_args+=(--env "$profile_disable_update_env=1")
  fi
fi

forwarded_env_names=()
inherit_host_env() {
  local env_name="$1"
  printenv "$env_name" >/dev/null 2>&1 || return 1
  if [ "${#forwarded_env_names[@]}" -eq 0 ] \
    || ! array_contains_value "$env_name" "${forwarded_env_names[@]}"; then
    # Passing only the name keeps its value out of the Apple CLI argv and the
    # fake-runtime argument logs used by the contract tests.
    create_args+=(--env "$env_name")
    forwarded_env_names+=("$env_name")
  fi
}

if [ "$singleton_requested" != true ]; then
  if [ "$profile_credential_forward_mode" = true ]; then
    [ -n "$profile_api_key_env" ] \
      || die "Profile '$profile_id' does not recognize an API-key environment variable."
    inherit_host_env "$profile_api_key_env" \
      || die "--container-forward-api-key is enabled, but no credential recognized for profile '$profile_id' is set and exported."
  fi

  if [ "${#explicit_forward_env_names[@]}" -gt 0 ]; then
    for forward_env_name in "${explicit_forward_env_names[@]}"; do
      inherit_host_env "$forward_env_name" \
        || die "Explicitly requested environment variable '$forward_env_name' became unavailable before container creation."
    done
  fi
fi

[ -n "$http_proxy_value" ] && create_args+=(--env "HTTP_PROXY=$http_proxy_value" --env "http_proxy=$http_proxy_value")
[ -n "$https_proxy_value" ] && create_args+=(--env "HTTPS_PROXY=$https_proxy_value" --env "https_proxy=$https_proxy_value")
[ -n "$all_proxy_value" ] && create_args+=(--env "ALL_PROXY=$all_proxy_value" --env "all_proxy=$all_proxy_value")
if [ -n "$http_proxy_value$https_proxy_value$all_proxy_value" ]; then
  create_args+=(--env "NO_PROXY=$no_proxy_value" --env "no_proxy=$no_proxy_value")
fi

[ -n "$dns1_value" ] && create_args+=(--dns "$dns1_value")
[ -n "$dns2_value" ] && create_args+=(--dns "$dns2_value")
[ -n "$timezone_value" ] && create_args+=(--env "TZ=$timezone_value")

if [ "$singleton_requested" = true ]; then
  create_args+=("$image_name" /bin/sleep infinity)
else
  create_args+=("$image_name" "$profile_command" "$@")
fi

verify_created_container() {
  local inspect_tmp="$1"
  local require_unstarted="${2:-true}"
  if ! "$osascript_bin" -l JavaScript - \
    "$inspect_tmp" \
    "$container_name" \
    "$profile_id" \
    "$host_uid" \
    "$$" \
    "$image_digest" \
    "$container_tty" \
    "$require_unstarted" \
    "$singleton_requested" \
    "$singleton_config_hash" >/dev/null 2>&1 <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('container inspect is not readable UTF-8');
  const containers = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(containers) || containers.length !== 1) {
    throw new Error('container inspect must contain exactly one container');
  }

  const container = containers[0];
  if (container === null || typeof container !== 'object' || Array.isArray(container)) {
    throw new Error('container inspect record must be an object');
  }
  const expectedID = argv[1];
  if (container.id !== expectedID) throw new Error('container id mismatch');

  const configuration = container.configuration;
  if (configuration === null || typeof configuration !== 'object'
      || Array.isArray(configuration) || configuration.id !== expectedID) {
    throw new Error('container configuration id mismatch');
  }
  const labels = configuration.labels;
  const singletonMode = argv[8] === 'true';
  if (labels === null || typeof labels !== 'object' || Array.isArray(labels)
      || labels['com.loadchange.agent-container'] !== 'true'
      || labels['com.loadchange.agent-container.profile'] !== argv[2]
      || labels['com.loadchange.agent-container.host-uid'] !== argv[3]
      || labels['com.loadchange.agent-container.launcher-pid'] !== argv[4]
      || (singletonMode
        && (labels['com.loadchange.agent-container.mode'] !== 'singleton'
          || labels['com.loadchange.agent-container.config-sha256'] !== argv[9]))) {
    throw new Error('container provenance labels mismatch');
  }

  const status = container.status;
  const requireUnstarted = argv[7] === 'true';
  if (status === null || typeof status !== 'object' || Array.isArray(status)
      || status.state !== 'stopped'
      || (requireUnstarted && status.startedDate != null)) {
    throw new Error('newly created container is not stopped');
  }
  const image = configuration.image;
  const descriptor = image && typeof image === 'object' && !Array.isArray(image)
    ? image.descriptor
    : null;
  const digest = descriptor && typeof descriptor === 'object' && !Array.isArray(descriptor)
    ? descriptor.digest
    : null;
  if (typeof digest !== 'string' || !/^sha256:[0-9a-f]{64}$/.test(digest)
      || digest !== argv[5]) {
    throw new Error('created container image digest mismatch');
  }

  const initProcess = configuration.initProcess;
  const expectedTTY = argv[6] === 'true';
  if (initProcess === null || typeof initProcess !== 'object' || Array.isArray(initProcess)
      || typeof initProcess.terminal !== 'boolean'
      || initProcess.terminal !== expectedTTY) {
    throw new Error('created container terminal configuration mismatch');
  }
  return 'verified';
}
JXA
  then
    return 1
  fi
}

created_container_provenance_matches() {
  local inspect_tmp="$1"
  "$osascript_bin" -l JavaScript - \
    "$inspect_tmp" \
    "$container_name" \
    "$profile_id" \
    "$host_uid" \
    "$$" \
    "$singleton_requested" \
    "$singleton_config_hash" >/dev/null 2>&1 <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('container inspect is not readable UTF-8');
  const containers = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(containers) || containers.length !== 1) {
    throw new Error('container inspect must contain exactly one container');
  }
  const container = containers[0];
  if (container === null || typeof container !== 'object' || Array.isArray(container)
      || container.id !== argv[1]) {
    throw new Error('container id mismatch');
  }
  const configuration = container.configuration;
  if (configuration === null || typeof configuration !== 'object'
      || Array.isArray(configuration) || configuration.id !== argv[1]) {
    throw new Error('container configuration id mismatch');
  }
  const labels = configuration.labels;
  const singletonMode = argv[5] === 'true';
  if (labels === null || typeof labels !== 'object' || Array.isArray(labels)
      || labels['com.loadchange.agent-container'] !== 'true'
      || labels['com.loadchange.agent-container.profile'] !== argv[2]
      || labels['com.loadchange.agent-container.host-uid'] !== argv[3]
      || labels['com.loadchange.agent-container.launcher-pid'] !== argv[4]
      || (singletonMode
        && (labels['com.loadchange.agent-container.mode'] !== 'singleton'
          || labels['com.loadchange.agent-container.config-sha256'] !== argv[6]))) {
    throw new Error('container provenance labels mismatch');
  }
  return 'owned';
}
JXA
}

reconcile_failed_singleton_create() {
  local failed_create_inspect

  failed_create_inspect="$host_stage_dir/.singleton-failed-create.$$"
  if "$container_bin" inspect "$singleton_container_name" \
    > "$failed_create_inspect" 2>/dev/null; then
    if ! verify_created_container "$failed_create_inspect"; then
      rm -f "$failed_create_inspect"
      atomic_write_line "$singleton_phase_file" broken
      return 1
    fi
    rm -f "$failed_create_inspect"
    "$container_bin" delete --force "$singleton_container_name" \
      >/dev/null 2>&1 \
      || native_container_name_is_absent "$singleton_container_name" \
      || {
        atomic_write_line "$singleton_phase_file" broken
        return 1
      }
  else
    rm -f "$failed_create_inspect"
  fi

  if native_container_name_is_absent "$singleton_container_name"; then
    clear_singleton_state_files "$singleton_root"
    return 0
  fi
  atomic_write_line "$singleton_phase_file" broken
  return 1
}

if ! "$container_bin" "${create_args[@]}" >/dev/null; then
  if [ "$singleton_requested" = true ]; then
    if reconcile_failed_singleton_create; then
      die "Apple container could not create the '$profile_id' singleton; no native resource was retained."
    fi
    die "Apple container create was ambiguous and the reserved '$profile_id' singleton name could not be proven safe; the resource and broken state were retained."
  fi
  die "Apple container could not create the verified Agent container '$container_name'."
fi
created_inspect_tmp="$host_stage_dir/.container-inspect.$$"
if ! "$container_bin" inspect "$container_name" > "$created_inspect_tmp" 2>/dev/null; then
  rm -f "$created_inspect_tmp"
  die "Created Agent container could not be inspected; refusing to delete an unverified resource."
fi
if ! verify_created_container "$created_inspect_tmp"; then
  if created_container_provenance_matches "$created_inspect_tmp"; then
    rm -f "$created_inspect_tmp"
    if ! "$container_bin" delete --force "$container_name" >/dev/null 2>&1; then
      die "Created Agent container verification failed, and the proven project-owned '$container_name' could not be deleted. Recover it with: container delete --force $container_name"
    fi
    die "Created project-owned Agent container failed image, state, or terminal verification and was deleted."
  fi
  rm -f "$created_inspect_tmp"
  die "Created container provenance could not be proven; refusing to delete or start '$container_name'."
fi
rm -f "$created_inspect_tmp"

cleanup_failed_singleton_start() {
  local failed_inspect="$host_stage_dir/.singleton-failed-start.$$"

  "$container_bin" stop --signal KILL --time 0 \
    "$singleton_container_name" >/dev/null 2>&1 || true
  if "$container_bin" inspect "$singleton_container_name" \
    > "$failed_inspect" 2>/dev/null; then
    if verify_created_container "$failed_inspect" false; then
      "$container_bin" delete --force "$singleton_container_name" \
        >/dev/null 2>&1 || true
    fi
  fi
  rm -f "$failed_inspect"
  if native_container_name_is_absent "$singleton_container_name"; then
    clear_singleton_state_files "$singleton_root"
  else
    atomic_write_line "$singleton_phase_file" broken
    warn "Failed '$profile_id' singleton '$singleton_container_name' was retained because safe absence could not be proven; inspect it before using singleton stop."
  fi
}

if [ "$singleton_requested" = true ]; then
  atomic_write_line "$singleton_phase_file" starting
  if ! "$container_bin" start "$singleton_container_name" >/dev/null; then
    cleanup_failed_singleton_start
    die "Apple container could not start the persistent '$profile_id' singleton."
  fi

  singleton_running_inspect="$host_stage_dir/.singleton-running.$$"
  if ! "$container_bin" inspect "$singleton_container_name" \
    > "$singleton_running_inspect" 2>/dev/null \
    || ! verify_singleton_container_inspect \
      "$singleton_running_inspect" running "$image_digest" "$$"; then
    rm -f "$singleton_running_inspect"
    cleanup_failed_singleton_start
    die "The started '$profile_id' singleton failed running-state provenance verification."
  fi
  rm -f "$singleton_running_inspect"
  atomic_write_line "$singleton_phase_file" ready
  run_singleton_client "$@"
fi

start_args=(start --attach --interactive "$container_name")

child_pid=""
watchdog_pid=""
legacy_background_launching=false
legacy_pending_signal_name=""
legacy_pending_signal_status=""

legacy_job_is_active() {
  local wanted_pid="$1"
  local job_pid job_state

  [ -n "$wanted_pid" ] || return 1
  for job_state in -pr -ps; do
    while IFS= read -r job_pid; do
      [ "$job_pid" = "$wanted_pid" ] && return 0
    done < <(jobs "$job_state" 2>/dev/null)
  done
  return 1
}

stop_native_container() {
  local emergency="${1:-false}"
  local stopped=false
  if [ "$emergency" = true ]; then
    "$container_bin" stop --signal KILL --time 0 "$container_name" >/dev/null 2>&1 \
      && stopped=true
  else
    "$container_bin" stop --time 1 "$container_name" >/dev/null 2>&1 \
      && stopped=true
  fi
  if legacy_job_is_active "$child_pid"; then
    kill -TERM "$child_pid" >/dev/null 2>&1 || true
  fi
  # If the threshold raced container registration, terminate the attaching CLI
  # and retry the named stop briefly so a late-created VM is not left running.
  if [ "$stopped" = false ]; then
    for stop_retry in 1 2 3; do
      sleep 0.2
      if "$container_bin" stop --signal KILL --time 0 "$container_name" >/dev/null 2>&1; then
        break
      fi
    done
  fi
}

stop_fd_watchdog() {
  [ -n "$watchdog_pid" ] || return 0
  if legacy_job_is_active "$watchdog_pid"; then
    kill -TERM "$watchdog_pid" >/dev/null 2>&1 || true
  fi
  wait "$watchdog_pid" >/dev/null 2>&1 || true
  watchdog_pid=""
}

handle_legacy_signal() {
  local signal_name="$1"
  local signal_status="$2"

  if [ "$legacy_background_launching" = true ]; then
    if [ -z "$legacy_pending_signal_status" ]; then
      legacy_pending_signal_name=$signal_name
      legacy_pending_signal_status=$signal_status
    fi
    return 0
  fi
  if [ -n "$legacy_pending_signal_status" ]; then
    signal_name=$legacy_pending_signal_name
    signal_status=$legacy_pending_signal_status
    legacy_pending_signal_name=""
    legacy_pending_signal_status=""
  fi

  trap '' INT TERM HUP
  set +e
  stop_fd_watchdog
  stop_native_container false
  if [ -n "$child_pid" ]; then
    wait "$child_pid" >/dev/null 2>&1 || true
  fi
  child_pid=""
  exit "$signal_status"
}

complete_legacy_background_launch() {
  legacy_background_launching=false
  if [ -n "$legacy_pending_signal_status" ]; then
    handle_legacy_signal \
      "$legacy_pending_signal_name" \
      "$legacy_pending_signal_status"
  fi
}

trap 'handle_legacy_signal INT 130' INT
trap 'handle_legacy_signal TERM 143' TERM
trap 'handle_legacy_signal HUP 129' HUP

fd_watchdog() {
  local current_files max_files max_files_per_proc max_vnodes free_vnodes
  local session_file_growth used_vnodes
  while kill -0 "$child_pid" 2>/dev/null; do
    current_files=$(sysctl -n kern.num_files 2>/dev/null || true)
    max_files=$(sysctl -n kern.maxfiles 2>/dev/null || true)
    max_files_per_proc=$(sysctl -n kern.maxfilesperproc 2>/dev/null || true)
    max_vnodes=$(sysctl -n kern.maxvnodes 2>/dev/null || true)
    free_vnodes=$(sysctl -n kern.free_vnodes 2>/dev/null || true)
    case "$current_files:$max_files:$max_files_per_proc:$max_vnodes:$free_vnodes" in
      *[!0-9:]*)
        warn "Host file-table counters became unavailable; the live VirtioFS watchdog stopped monitoring."
        return
        ;;
    esac
    if [ -z "$current_files" ] \
      || [ -z "$max_files" ] \
      || [ -z "$max_files_per_proc" ] \
      || [ -z "$max_vnodes" ] \
      || [ -z "$free_vnodes" ] \
      || [ "$max_files" -le 0 ] \
      || [ "$max_files_per_proc" -le 0 ] \
      || [ "$max_vnodes" -le 0 ] \
      || [ "$free_vnodes" -gt "$max_vnodes" ]; then
      warn "Host file-table counters became unavailable; the live VirtioFS watchdog stopped monitoring."
      return
    fi
    session_file_growth=$((current_files - host_num_files))
    [ "$session_file_growth" -ge 0 ] || session_file_growth=0
    used_vnodes=$((max_vnodes - free_vnodes))
    if [ "$current_files" -ge "$((max_files * fd_stop_percent / 100))" ] \
      || [ "$session_file_growth" -ge "$((max_files_per_proc * fd_stop_percent / 100))" ] \
      || [ "$used_vnodes" -ge "$((max_vnodes * fd_stop_percent / 100))" ]; then
      warn "Stopping $container_name: host file/vnode use reached the $fd_stop_percent% safety threshold. See $VIRTIOFS_ISSUE_URL"
      stop_native_container true
      return
    fi
    sleep 2
  done
}

set +e
# The child must be waitable so TERM/HUP sent only to this launcher can run the
# trap immediately. Explicitly preserving fd 0 prevents Bash from replacing a
# background command's stdin with /dev/null, including under a real PTY.
legacy_background_launching=true
"$container_bin" "${start_args[@]}" <&0 &
child_pid=$!
complete_legacy_background_launch
if ! is_true "${AGENT_CONTAINER_DISABLE_FD_WATCHDOG:-false}"; then
  legacy_background_launching=true
  fd_watchdog &
  watchdog_pid=$!
  complete_legacy_background_launch
fi
wait "$child_pid"
run_status=$?
child_pid=""
stop_fd_watchdog
set -e

# A normal --rm workload is already absent here. ContainerStart differs from
# ContainerRun when bootstrap fails, however: it can leave a stopped auto-remove
# record behind. Reinspect and delete only the exact, still-stopped container
# whose IDs, labels, image digest, and terminal configuration we already proved.
# Any absence is normal; any ambiguous replacement is retained fail-closed for
# the next lifecycle reconciliation instead of being deleted by name alone.
post_start_inspect="$host_stage_dir/.container-post-start.$$"
if "$container_bin" inspect "$container_name" \
  > "$post_start_inspect" 2>/dev/null; then
  if verify_created_container "$post_start_inspect" false; then
    if ! "$container_bin" delete --force "$container_name" >/dev/null 2>&1; then
      # With --rm, Apple container can remove the stopped record between the
      # successful inspect above and this explicit delete. Treat that race as
      # the normal absent state; warn only when the name still resolves.
      if ! native_container_name_is_absent "$container_name"; then
        warn "Could not remove stopped project-owned container '$container_name'; the next launch will retry provenance-checked recovery."
      fi
    fi
  else
    warn "Container '$container_name' still exists after start but no longer matches its verified stopped state; it was retained for provenance-checked recovery."
  fi
elif ! native_container_name_is_absent "$container_name"; then
  warn "Could not determine whether '$container_name' was auto-removed; the next launch will perform provenance-checked recovery."
fi
rm -f "$post_start_inspect"

exit "$run_status"
