#!/bin/bash
set -euo pipefail

# Internal hardened runtime. The public commands are the Rust launcher and its
# profile aliases; this script owns cold image preparation and container state.

readonly PROGRAM_NAME="agent-container"
readonly MIN_CONTAINER_VERSION="1.2.0"
readonly MAX_PROFILE_ID_LENGTH=32
readonly VIRTIOFS_ISSUE_URL="https://github.com/apple/container/issues/1097"
readonly OWNERSHIP_MARKER_TEXT="managed by agent-container"
readonly DEFAULT_BASE_IMAGE="mirror.gcr.io/library/debian:bookworm-slim@sha256:9b67294679b30e5d6ab257b40594feeb4a4b81f7fcf4131f4decf0d6a212a9b0"
# An installed Mach-O may remain in dyld/security validation for several
# seconds before Rust reaches main. A separate watchdog bounds wall time even
# when launching each 50 ms polling sleep is itself delayed.
readonly WORKSPACE_BROKER_READY_TIMEOUT_SECONDS=30

die() {
  echo "Error: $*" >&2
  exit 1
}

warn() {
  echo "Warning: $*" >&2
}

is_true() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

reject_control_characters() {
  local setting_name="$1"
  local setting_value="$2"

  # Environment values are later used as native CLI arguments and persistent
  # configuration fields. Reject every representable ASCII control character
  # up front so neither interface can be split or made ambiguous. Shell
  # environment variables cannot contain NUL.
  case "$setting_value" in
    *$'\n'*|*$'\r'*|*$'\t'*)
      die "$setting_name contains unsupported control characters."
      ;;
  esac
  if printf '%s' "$setting_value" \
    | LC_ALL=C grep '[[:cntrl:]]' >/dev/null; then
    die "$setting_name contains unsupported control characters."
  fi
}

# Apple's optional host.container.internal bridge is reachable from builder and
# guest VMs, but its documentation-only address is not a host-side route to a
# loopback listener. Keep the proxy URL unchanged (including HTTPS proxy SNI)
# and give only host curl a DNS-cache override for that exact authority.
host_proxy_resolve_override() {
  local authority host_port lower_host_port port proxy_rest proxy_url

  proxy_url="$1"
  [ -n "$proxy_url" ] || return 1
  case "$proxy_url" in
    *://*) proxy_rest=${proxy_url#*://} ;;
    *) proxy_rest=$proxy_url ;;
  esac
  authority=${proxy_rest%%/*}
  case "$authority" in
    *'?'*|*'#'*) return 1 ;;
  esac
  # Proxy credentials may contain colons; the final @ separates userinfo from
  # the host authority. Percent-encoded @ remains unambiguous.
  host_port=${authority##*@}
  lower_host_port=$(printf '%s' "$host_port" | tr '[:upper:]' '[:lower:]')
  case "$lower_host_port" in
    host.container.internal)
      # curl's proxy default is port 1080 when no explicit port is present.
      port=1080
      ;;
    host.container.internal:*)
      port=${host_port#*:}
      case "$port" in
        ''|*[!0-9]*) return 1 ;;
      esac
      [ "${#port}" -le 5 ] \
        && [ "$port" -ge 1 ] 2>/dev/null \
        && [ "$port" -le 65535 ] 2>/dev/null \
        || return 1
      ;;
    *) return 1 ;;
  esac
  printf 'host.container.internal:%s:127.0.0.1\n' "$port"
}

version_at_least() {
  local actual="$1"
  local required="$2"
  local actual_major actual_minor actual_patch
  local required_major required_minor required_patch

  IFS=. read -r actual_major actual_minor actual_patch <<EOF
$actual
EOF
  IFS=. read -r required_major required_minor required_patch <<EOF
$required
EOF

  [ "${actual_major:-0}" -gt "${required_major:-0}" ] && return 0
  [ "${actual_major:-0}" -lt "${required_major:-0}" ] && return 1
  [ "${actual_minor:-0}" -gt "${required_minor:-0}" ] && return 0
  [ "${actual_minor:-0}" -lt "${required_minor:-0}" ] && return 1
  [ "${actual_patch:-0}" -ge "${required_patch:-0}" ]
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    die "shasum or sha256sum is required."
  fi
}

sha256_stream() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  else
    sha256sum | awk '{print $1}'
  fi
}

sha256_tree() {
  local root="$1"
  [ -d "$root" ] && [ ! -L "$root" ] \
    || die "Cannot fingerprint an unsafe directory tree: $root"
  (
    cd "$root"
    LC_ALL=C /usr/bin/tar -cf - .
  ) | sha256_stream
}

bounded_file_count() {
  local root="$1"
  local limit="$2"
  local count error_file first_error

  error_file=$(mktemp "${TMPDIR:-/tmp}/agent-container-find.XXXXXX") \
    || die "Unable to create a temporary file for the workspace safety scan."

  # Stop after limit+1 NUL-delimited paths. Temporarily disable pipefail because
  # find is expected to receive SIGPIPE once the bounded reader exits. Any real
  # traversal error is captured separately and fails closed.
  set +o pipefail
  count=$(
    find "$root" -mindepth 1 -print0 2>"$error_file" \
      | (
          bounded_count=0
          while IFS= read -r -d '' ignored_path; do
            bounded_count=$((bounded_count + 1))
            [ "$bounded_count" -gt "$limit" ] && break
          done
          printf '%s\n' "$bounded_count"
        )
  )
  set -o pipefail

  if [ -s "$error_file" ]; then
    first_error=$(sed -n '1p' "$error_file")
    rm -f "$error_file"
    die "Unable to safely scan workspace '$root': $first_error"
  fi
  rm -f "$error_file"
  case "$count" in
    ''|*[!0-9]*) die "Workspace safety scan returned an invalid file count." ;;
  esac
  printf '%s\n' "$count"
}

resolve_absolute_dir() {
  (CDPATH= cd -- "$1" 2>/dev/null && pwd -P)
}

canonical_data_dir() {
  local target="$1"
  local parent base canonical_parent
  if [ -L "$target" ] && [ ! -e "$target" ]; then
    die "Refusing a broken symlink as a writable data path: $target"
  fi
  if [ -e "$target" ]; then
    [ -d "$target" ] || die "Expected a directory path, found a file: $target"
    resolve_absolute_dir "$target"
    return
  fi
  parent=$(dirname -- "$target")
  base=$(basename -- "$target")
  [ -d "$parent" ] \
    || die "Parent directory must already exist for custom data path: $parent"
  canonical_parent=$(resolve_absolute_dir "$parent")
  printf '%s/%s\n' "$canonical_parent" "$base"
}

path_contains() {
  local parent="$1"
  local child="$2"
  if [ "$parent" = / ]; then
    case "$child" in
      /*) return 0 ;;
      *) return 1 ;;
    esac
  fi
  case "$child/" in
    "$parent/"*) return 0 ;;
    *) return 1 ;;
  esac
}

paths_overlap() {
  path_contains "$1" "$2" || path_contains "$2" "$1"
}

array_contains_value() {
  local wanted="$1"
  shift
  local candidate
  for candidate in "$@"; do
    [ "$candidate" = "$wanted" ] && return 0
  done
  return 1
}

is_empty_dir() {
  local first_entry
  [ -d "$1" ] || return 0
  if ! first_entry=$(find "$1" -mindepth 1 -maxdepth 1 -print -quit 2>&1); then
    return 1
  fi
  [ -z "$first_entry" ]
}

ownership_marker_valid() {
  local marker="$1"
  [ -f "$marker" ] \
    && [ ! -L "$marker" ] \
    && cmp -s "$marker" <(printf '%s\n' "$OWNERSHIP_MARKER_TEXT")
}

validate_marker_path() {
  local marker="$1"
  if [ -L "$marker" ] || { [ -e "$marker" ] && [ ! -f "$marker" ]; }; then
    die "Refusing an unsafe agent-container ownership marker: $marker"
  fi
  if [ -f "$marker" ] && ! ownership_marker_valid "$marker"; then
    die "Refusing an invalid agent-container ownership marker: $marker"
  fi
}

validate_managed_directory() {
  local directory="$1"
  if [ -L "$directory" ]; then
    die "Refusing a symlink as a managed directory: $directory"
  fi
  if [ -e "$directory" ] && [ ! -d "$directory" ]; then
    die "Expected a managed directory, found another file type: $directory"
  fi
}

validate_volume_source_path() {
  local source="$1"
  case "$source" in
    *:*)
      die "Apple container 1.2 cannot bind-mount a macOS path containing ':': $source"
      ;;
  esac
}

atomic_write_line() {
  local destination="$1"
  local value="$2"
  local parent temporary
  if [ -L "$destination" ] \
    || { [ -e "$destination" ] && [ ! -f "$destination" ]; }; then
    die "Refusing to replace an unsafe state file: $destination"
  fi
  parent=$(dirname -- "$destination")
  temporary=$(mktemp "$parent/.agent-container-write.XXXXXX") \
    || die "Unable to create a temporary file in $parent."
  if ! printf '%s\n' "$value" > "$temporary"; then
    rm -f "$temporary"
    die "Unable to write temporary state in $parent."
  fi
  chmod 0600 "$temporary"
  # Recheck immediately before rename. A same-directory mv atomically replaces
  # an existing regular file, so readers never observe an absent destination.
  if [ -L "$destination" ] \
    || { [ -e "$destination" ] && [ ! -f "$destination" ]; }; then
    rm -f "$temporary"
    die "Refusing to replace an unsafe state file: $destination"
  fi
  if ! mv -f "$temporary" "$destination"; then
    rm -f "$temporary"
    die "Unable to atomically publish state at $destination."
  fi
}

read_single_line() {
  local file="$1"
  local value
  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  IFS= read -r value < "$file" || return 1
  [ -n "$value" ] || return 1
  cmp -s "$file" <(printf '%s\n' "$value") || return 1
  printf '%s\n' "$value"
}

lifecycle_lock_acquired=false
lifecycle_lock=""
lifecycle_lock_owner=""
lifecycle_kernel_lock_acquired=false

valid_lock_owner() {
  [ -n "$1" ] && [ "${#1}" -le 128 ] || return 1
  case "$1" in
    *[!A-Za-z0-9._:-]*) return 1 ;;
    *) return 0 ;;
  esac
}

lock_directory_has_only() {
  local lock_root="$1"
  local allowed_names="$2"
  local lock_entry lock_name

  for lock_entry in \
    "$lock_root"/* \
    "$lock_root"/.[!.]* \
    "$lock_root"/..?*; do
    [ -e "$lock_entry" ] || [ -L "$lock_entry" ] || continue
    lock_name=${lock_entry##*/}
    case " $allowed_names " in
      *" $lock_name "*) ;;
      *) return 1 ;;
    esac
  done
}

release_lifecycle_lock() {
  local current_pid current_owner
  if [ "$lifecycle_lock_acquired" = true ] \
    && [ -n "$lifecycle_lock" ] \
    && [ -d "$lifecycle_lock" ] \
    && [ ! -L "$lifecycle_lock" ]; then
    current_pid=$(read_single_line "$lifecycle_lock/pid" || true)
    current_owner=$(read_single_line "$lifecycle_lock/owner" || true)
    if [ "$current_pid" = "$$" ] \
      && [ -n "$lifecycle_lock_owner" ] \
      && [ "$current_owner" = "$lifecycle_lock_owner" ] \
      && lock_directory_has_only "$lifecycle_lock" "pid owner"; then
      rm -f "$lifecycle_lock/pid" "$lifecycle_lock/owner"
      rmdir "$lifecycle_lock" 2>/dev/null || true
    fi
  fi
  lifecycle_lock_acquired=false
  if [ "$lifecycle_kernel_lock_acquired" = true ]; then
    exec 9<&-
    lifecycle_kernel_lock_acquired=false
  fi
}

acquire_lifecycle_lock() {
  local wait_for_lock="${1:-false}"
  local local_root_input local_root share_dir_input share_dir lifecycle_pid
  local lifecycle_owner lifecycle_owner_present lifecycle_reap
  local lifecycle_reap_pid lifecycle_reap_owner lifecycle_quarantine
  local lifecycle_retry

  [ "$lifecycle_lock_acquired" = false ] || return 0

  # Install/uninstall hold this mutex for their complete transaction. A normal
  # launcher releases it after durable PID registration. Singleton creation
  # deliberately keeps it until the stable service has reached READY.
  [ -x /usr/bin/lockf ] \
    || die "macOS /usr/bin/lockf is required for lifecycle serialization."
  # Lock the canonical HOME inode rather than a removable state directory.
  # Child processes intentionally inherit this descriptor: if the launcher is
  # killed during a synchronous native mutation, recovery waits until that
  # mutation also exits. The project never removes or renames HOME, so every
  # launcher/install/uninstall observes the same kernel lock generation.
  exec 9< "$host_home_dir" \
    || die "Unable to open the host home directory for lifecycle locking."
  if ! /usr/bin/lockf -t 0 9 2>/dev/null; then
    if [ "$wait_for_lock" != true ]; then
      exec 9<&-
      die "Another agent-container session, install, or uninstall is running."
    fi
    warn "Another agent-container lifecycle transaction is starting; waiting for it to finish."
    if ! /usr/bin/lockf -s 9; then
      exec 9<&-
      die "Unable to acquire the agent-container lifecycle lock."
    fi
  fi
  lifecycle_kernel_lock_acquired=true
  trap '' INT TERM HUP
  trap release_lifecycle_lock EXIT

  local_root_input="$host_home_dir/.local"
  if [ ! -e "$local_root_input" ] && [ ! -L "$local_root_input" ]; then
    mkdir "$local_root_input" 2>/dev/null \
      || { [ -d "$local_root_input" ] && [ ! -L "$local_root_input" ]; } \
      || die "Unable to create the local data root: $local_root_input"
  fi
  [ -d "$local_root_input" ] \
    || die "Local data root is not a directory: $local_root_input"
  local_root=$(resolve_absolute_dir "$local_root_input")
  path_contains "$host_home_dir" "$local_root" \
    || die "Local data root resolves outside the host home: $local_root_input"

  share_dir_input="$host_home_dir/.local/share"
  if [ ! -e "$share_dir_input" ] && [ ! -L "$share_dir_input" ]; then
    mkdir "$share_dir_input" 2>/dev/null \
      || { [ -d "$share_dir_input" ] && [ ! -L "$share_dir_input" ]; } \
      || die "Unable to create the local share path: $share_dir_input"
  fi
  [ -d "$share_dir_input" ] \
    || die "Local share path is not a directory: $share_dir_input"
  share_dir=$(resolve_absolute_dir "$share_dir_input")
  path_contains "$host_home_dir" "$share_dir" \
    || die "Local share path resolves outside the host home: $share_dir_input"

  lifecycle_lock="$share_dir/.agent-container.install.lock"
  lifecycle_lock_owner="$$.$RANDOM.$RANDOM"
  valid_lock_owner "$lifecycle_lock_owner" \
    || die "Unable to generate a safe lifecycle lock owner token."
  lifecycle_retry=0
  while ! mkdir "$lifecycle_lock" 2>/dev/null; do
    lifecycle_retry=$((lifecycle_retry + 1))
    [ "$lifecycle_retry" -le 20 ] \
      || die "Unable to acquire the agent-container lifecycle lock after repeated concurrent changes."
    if [ ! -e "$lifecycle_lock" ] && [ ! -L "$lifecycle_lock" ]; then
      continue
    fi
    [ -d "$lifecycle_lock" ] && [ ! -L "$lifecycle_lock" ] \
      || die "Unsafe agent-container lifecycle lock: $lifecycle_lock"
    [ -f "$lifecycle_lock/pid" ] && [ ! -L "$lifecycle_lock/pid" ] \
      || die "The agent-container lifecycle lock has no trustworthy PID; refusing to steal it."
    lifecycle_pid=$(read_single_line "$lifecycle_lock/pid" || true)
    case "$lifecycle_pid" in
      ''|0|*[!0-9]*) die "The agent-container lifecycle lock has an invalid PID; refusing to steal it." ;;
    esac
    if kill -0 "$lifecycle_pid" 2>/dev/null; then
      die "Another agent-container session, install, or uninstall is running (PID $lifecycle_pid)."
    fi

    lifecycle_owner=""
    lifecycle_owner_present=false
    if [ -e "$lifecycle_lock/owner" ] || [ -L "$lifecycle_lock/owner" ]; then
      [ -f "$lifecycle_lock/owner" ] && [ ! -L "$lifecycle_lock/owner" ] \
        || die "The stale agent-container lifecycle lock has an unsafe owner record."
      lifecycle_owner=$(read_single_line "$lifecycle_lock/owner" || true)
      valid_lock_owner "$lifecycle_owner" \
        || die "The stale agent-container lifecycle lock has an invalid owner record."
      lifecycle_owner_present=true
    fi
    [ "$lifecycle_owner_present" = true ] \
      || die "A stale legacy lifecycle lock cannot be reclaimed safely while older launchers may still be running. Verify PID $lifecycle_pid is dead, then remove only: $lifecycle_lock"

    lifecycle_reap="$lifecycle_lock/.reap"
    if ! mkdir "$lifecycle_reap" 2>/dev/null; then
      if [ ! -e "$lifecycle_lock" ] && [ ! -L "$lifecycle_lock" ]; then
        continue
      fi
      [ -d "$lifecycle_reap" ] && [ ! -L "$lifecycle_reap" ] \
        || die "The stale lifecycle lock has an unsafe recovery claim; refusing to steal it."
      lock_directory_has_only "$lifecycle_reap" "pid owner" \
        || die "The stale lifecycle lock recovery claim contains unexpected entries."
      lifecycle_reap_pid=$(read_single_line "$lifecycle_reap/pid" || true)
      lifecycle_reap_owner=$(read_single_line "$lifecycle_reap/owner" || true)
      if case "$lifecycle_reap_pid" in
          ''|0|*[!0-9]*) false ;;
          *) true ;;
        esac \
        && valid_lock_owner "$lifecycle_reap_owner" \
        && kill -0 "$lifecycle_reap_pid" 2>/dev/null; then
        die "Another agent-container transaction is reclaiming a stale lifecycle lock (PID $lifecycle_reap_pid)."
      fi
      # A process that owned this recovery claim cannot still hold the kernel
      # lock: lockf released it automatically when that process exited or was
      # killed. Remove only the exact claim records, then publish our claim.
      rm -f "$lifecycle_reap/pid" "$lifecycle_reap/owner"
      rmdir "$lifecycle_reap" 2>/dev/null \
        || die "Could not clear an abandoned lifecycle recovery claim."
      mkdir "$lifecycle_reap" \
        || die "Could not replace an abandoned lifecycle recovery claim."
    fi
    chmod 0700 "$lifecycle_reap"
    if ! printf '%s\n' "$$" > "$lifecycle_reap/pid" \
      || ! printf '%s\n' "$lifecycle_lock_owner" > "$lifecycle_reap/owner"; then
      rm -f "$lifecycle_reap/pid" "$lifecycle_reap/owner"
      rmdir "$lifecycle_reap" 2>/dev/null || true
      die "Unable to publish the lifecycle lock recovery claim."
    fi

    # Revalidate the stale directory after winning its in-directory recovery
    # claim.  This prevents two launchers that observed the same dead PID from
    # deleting a replacement lock created by the other launcher.
    [ "$(read_single_line "$lifecycle_lock/pid" || true)" = "$lifecycle_pid" ] \
      || die "The stale lifecycle lock changed while it was being reclaimed."
    if [ "$lifecycle_owner_present" = true ]; then
      [ "$(read_single_line "$lifecycle_lock/owner" || true)" = "$lifecycle_owner" ] \
        || die "The stale lifecycle lock owner changed while it was being reclaimed."
    else
      [ ! -e "$lifecycle_lock/owner" ] && [ ! -L "$lifecycle_lock/owner" ] \
        || die "The stale lifecycle lock gained an owner while it was being reclaimed."
    fi
    if kill -0 "$lifecycle_pid" 2>/dev/null; then
      rm -f "$lifecycle_reap/pid" "$lifecycle_reap/owner"
      rmdir "$lifecycle_reap" 2>/dev/null || true
      die "The lifecycle lock owner PID $lifecycle_pid became active during recovery."
    fi
    lock_directory_has_only "$lifecycle_lock" "pid owner .reap" \
      && lock_directory_has_only "$lifecycle_reap" "pid owner" \
      || die "The stale lifecycle lock contains unexpected entries; refusing to reclaim it."

    lifecycle_quarantine="$lifecycle_lock.reaped.$lifecycle_lock_owner"
    [ ! -e "$lifecycle_quarantine" ] && [ ! -L "$lifecycle_quarantine" ] \
      || die "The lifecycle lock recovery quarantine already exists: $lifecycle_quarantine"
    mv "$lifecycle_lock" "$lifecycle_quarantine" \
      || die "Could not atomically quarantine the stale lifecycle lock: $lifecycle_lock"
    [ "$(read_single_line "$lifecycle_quarantine/.reap/pid" || true)" = "$$" ] \
      && [ "$(read_single_line "$lifecycle_quarantine/.reap/owner" || true)" = "$lifecycle_lock_owner" ] \
      || die "Lifecycle lock recovery ownership changed after quarantine."
    rm -f \
      "$lifecycle_quarantine/pid" \
      "$lifecycle_quarantine/owner" \
      "$lifecycle_quarantine/.reap/pid" \
      "$lifecycle_quarantine/.reap/owner"
    rmdir "$lifecycle_quarantine/.reap" \
      && rmdir "$lifecycle_quarantine" \
      || die "Could not clear the quarantined stale lifecycle lock: $lifecycle_quarantine"
  done
  chmod 0700 "$lifecycle_lock"
  if ! printf '%s\n' "$$" > "$lifecycle_lock/pid" \
    || ! printf '%s\n' "$lifecycle_lock_owner" > "$lifecycle_lock/owner"; then
    rm -f "$lifecycle_lock/pid" "$lifecycle_lock/owner"
    rmdir "$lifecycle_lock" 2>/dev/null || true
    die "Unable to publish lifecycle lock ownership."
  fi
  lifecycle_lock_acquired=true
}

certificate_not_before_is_current() {
  local openssl_bin="$1"
  local certificate_file="$2"
  local startdate_output not_before_value not_before_epoch current_epoch

  startdate_output=$(
    "$openssl_bin" x509 -in "$certificate_file" -startdate -noout 2>/dev/null
  ) || return 1
  case "$startdate_output" in
    notBefore=*) not_before_value=${startdate_output#notBefore=} ;;
    *) return 1 ;;
  esac
  case "$not_before_value" in
    ''|*$'\n'*|*$'\r'*) return 1 ;;
  esac

  # The supported host is macOS, whose date(1) uses -j/-f.  Keep the GNU form
  # as a portability fallback for the shell regression suite.
  not_before_epoch=$(
    LC_ALL=C /bin/date -j -f '%b %e %T %Y %Z' \
      "$not_before_value" '+%s' 2>/dev/null
  ) || not_before_epoch=$(
    LC_ALL=C /bin/date -u -d "$not_before_value" '+%s' 2>/dev/null
  ) || return 1
  current_epoch=$(/bin/date -u '+%s') || return 1
  [ "$not_before_epoch" -le "$current_epoch" ]
}

certificate_has_ca_basic_constraint() {
  local openssl_bin="$1"
  local certificate_file="$2"
  local extension_text certificate_text

  # OpenSSL supports selecting this extension directly.  The macOS system
  # LibreSSL does not, so fall back to parsing only the immediate value of the
  # named Basic Constraints extension rather than searching the full dump.
  extension_text=$(
    "$openssl_bin" x509 -in "$certificate_file" -noout \
      -ext basicConstraints 2>/dev/null
  ) || extension_text=""
  if printf '%s\n' "$extension_text" \
    | grep -Eq '^[[:space:]]*CA:TRUE([,[:space:]].*)?$'; then
    return 0
  fi

  certificate_text=$(
    "$openssl_bin" x509 -in "$certificate_file" -text -noout 2>/dev/null
  ) || return 1
  printf '%s\n' "$certificate_text" | LC_ALL=C awk '
    /^[[:space:]]*X509v3 Basic Constraints:[^[:cntrl:]]*$/ {
      headings += 1
      if ((getline value) <= 0) exit 1
      if (value ~ /^[[:space:]]*CA:TRUE([,[:space:]].*)?$/) valid = 1
      next
    }
    END { exit !(headings == 1 && valid) }
  '
}

validate_extra_ca_bundle() {
  local bundle="$1"
  local bundle_size openssl_bin certificate_count validation_dir
  local certificate_file validation_failed

  [ -f "$bundle" ] && [ ! -L "$bundle" ] || return 1
  bundle_size=$(wc -c < "$bundle" | tr -d '[:space:]')
  case "$bundle_size" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$bundle_size" -gt 0 ] && [ "$bundle_size" -le 1048576 ] || return 1

  # Accept only one or more complete PEM CERTIFICATE blocks.  In particular,
  # reject private keys, prose, and partially parsed bundles before they become
  # trusted by every TLS client in the image.
  LC_ALL=C awk '
    BEGIN { inside = 0; count = 0; valid = 1 }
    /^-----BEGIN CERTIFICATE-----$/ {
      if (inside) valid = 0
      inside = 1
      count += 1
      next
    }
    /^-----END CERTIFICATE-----$/ {
      if (!inside) valid = 0
      inside = 0
      next
    }
    inside && /^[A-Za-z0-9+\/=]+$/ { next }
    !inside && /^[[:space:]]*$/ { next }
    { valid = 0 }
    END { exit !(valid && !inside && count > 0) }
  ' "$bundle" || return 1

  openssl_bin="${AGENT_CONTAINER_OPENSSL_BIN:-/usr/bin/openssl}"
  [ -x "$openssl_bin" ] || return 1
  certificate_count=$(grep -c '^-----BEGIN CERTIFICATE-----$' "$bundle")
  [ "$certificate_count" -gt 0 ] && [ "$certificate_count" -le 64 ] \
    || return 1

  # Validate each block independently.  Counting `CA:TRUE` strings in an
  # aggregate OpenSSL dump can let one certificate satisfy another and does
  # not prove that every admitted CA is still within its validity period.
  validation_dir=$(mktemp -d \
    "${TMPDIR:-/tmp}/agent-container-ca.XXXXXX") || return 1
  if ! LC_ALL=C awk -v output_dir="$validation_dir" '
    /^-----BEGIN CERTIFICATE-----$/ {
      count += 1
      output = sprintf("%s/certificate-%03d.pem", output_dir, count)
      inside = 1
    }
    inside { print > output }
    /^-----END CERTIFICATE-----$/ { close(output); inside = 0 }
    END { if (inside || count == 0) exit 1 }
  ' "$bundle"; then
    rm -f -- "$validation_dir"/certificate-*.pem
    rmdir "$validation_dir" 2>/dev/null || true
    return 1
  fi

  validation_failed=false
  for certificate_file in "$validation_dir"/certificate-*.pem; do
    if ! "$openssl_bin" x509 -in "$certificate_file" -noout \
      >/dev/null 2>&1 \
      || ! "$openssl_bin" x509 -in "$certificate_file" -checkend 0 \
        -noout >/dev/null 2>&1 \
      || ! certificate_not_before_is_current \
        "$openssl_bin" "$certificate_file" \
      || ! certificate_has_ca_basic_constraint \
        "$openssl_bin" "$certificate_file"; then
      validation_failed=true
      break
    fi
  done
  rm -f -- "$validation_dir"/certificate-*.pem
  rmdir "$validation_dir" 2>/dev/null || validation_failed=true
  [ "$validation_failed" = false ]
}

extract_macos_verified_anchor() {
  local url="$1"
  local destination="$2"
  local security_bin openssl_bin chain_file chain_size candidate_dir
  local curl_bin proxy_value resolve_value url_authority tls_host fetch_dir
  local fetched_chain fetched_count fetched_file
  local -a candidate_files
  local -a fetch_args verify_args
  local candidate_index candidate_file selected

  security_bin="${AGENT_CONTAINER_SECURITY_BIN:-/usr/bin/security}"
  openssl_bin="${AGENT_CONTAINER_OPENSSL_BIN:-/usr/bin/openssl}"
  [ -x "$security_bin" ] && [ -x "$openssl_bin" ] || return 1
  chain_file="$destination.chain"
  if ! "$security_bin" verify-cert -P "$url" \
    > "$chain_file" 2>/dev/null; then
    # Security.framework does not honor the launcher's explicit shell proxy.
    # When direct URL evaluation cannot reach the endpoint, let curl perform
    # only the proxied TLS handshake and export its peer chain. Security still
    # performs the authoritative hostname and Keychain trust evaluation over
    # those local certificates; TLS verification is never disabled.
    curl_bin="${AGENT_CONTAINER_CURL_BIN:-curl}"
    command -v "$curl_bin" >/dev/null 2>&1 || return 1
    url_authority=${url#https://}
    url_authority=${url_authority%%/*}
    tls_host=${url_authority%%:*}
    case "$tls_host" in
      ''|*[!A-Za-z0-9.-]*) return 1 ;;
    esac
    fetch_dir=$(mktemp -d "${destination}.fetch.XXXXXX") || return 1
    fetched_chain="$fetch_dir/curl-certs"
    fetch_args=(
      --disable
      --proto '=https'
      --tlsv1.2
      --fail
      --silent
      --show-error
      --output /dev/null
      --write-out '%{certs}'
    )
    proxy_value=${https_proxy_value:-$all_proxy_value}
    if [ -n "$proxy_value" ]; then
      fetch_args+=(--proxy "$proxy_value")
      if resolve_value=$(host_proxy_resolve_override "$proxy_value"); then
        fetch_args+=(--resolve "$resolve_value")
      fi
    else
      fetch_args+=(--proxy '')
    fi
    fetch_args+=(--noproxy "$no_proxy_value" "$url")
    if ! "$curl_bin" "${fetch_args[@]}" > "$fetched_chain"; then
      rm -f -- "$fetched_chain"
      rmdir "$fetch_dir" 2>/dev/null || true
      return 1
    fi
    if ! LC_ALL=C awk -v output_dir="$fetch_dir" '
      /^-----BEGIN CERTIFICATE-----$/ {
        if (inside || count >= 64) invalid = 1
        count += 1
        output = sprintf("%s/certificate-%03d.pem", output_dir, count)
        inside = 1
      }
      inside { print > output }
      /^-----END CERTIFICATE-----$/ { close(output); inside = 0 }
      END { if (invalid || inside || count == 0 || count > 64) exit 1 }
    ' "$fetched_chain"; then
      rm -f -- "$fetch_dir"/certificate-*.pem "$fetched_chain"
      rmdir "$fetch_dir" 2>/dev/null || true
      return 1
    fi
    verify_args=()
    fetched_count=0
    for fetched_file in "$fetch_dir"/certificate-*.pem; do
      verify_args+=(-c "$fetched_file")
      fetched_count=$((fetched_count + 1))
    done
    if [ "$fetched_count" -le 0 ] \
      || ! "$security_bin" verify-cert "${verify_args[@]}" \
        -p ssl -n "$tls_host" -P > "$chain_file" 2>/dev/null; then
      rm -f -- "$fetch_dir"/certificate-*.pem "$fetched_chain" "$chain_file"
      rmdir "$fetch_dir" 2>/dev/null || true
      return 1
    fi
    rm -f -- "$fetch_dir"/certificate-*.pem "$fetched_chain"
    rmdir "$fetch_dir" 2>/dev/null || {
      rm -f "$chain_file"
      return 1
    }
  fi

  chain_size=$(wc -c < "$chain_file" | tr -d '[:space:]')
  case "$chain_size" in
    ''|*[!0-9]*) rm -f "$chain_file"; return 1 ;;
  esac
  if [ "$chain_size" -le 0 ] || [ "$chain_size" -gt 1048576 ]; then
    rm -f "$chain_file"
    return 1
  fi

  candidate_dir=$(mktemp -d "${destination}.candidates.XXXXXX") || {
    rm -f "$chain_file"
    return 1
  }

  # `security verify-cert -P` prints a macOS-validated leaf-to-anchor chain.
  # Security.framework may terminate PEM records with CR/NUL and append the
  # next chain label on that same physical line, so convert NUL to a record
  # boundary before stripping CR.  Split every certificate and then select the
  # first currently-valid issuer from leaf toward anchor that explicitly
  # carries Basic Constraints CA:TRUE.  This avoids widening trust to a root
  # when a narrower, endpoint-specific intermediate is available.
  if ! tr '\000' '\n' < "$chain_file" \
    | tr -d '\r' \
    | LC_ALL=C awk -v output_dir="$candidate_dir" '
    /^-----BEGIN CERTIFICATE-----$/ {
      if (inside || count >= 64) invalid = 1
      count += 1
      output = sprintf("%s/certificate-%03d.pem", output_dir, count)
      inside = 1
      print > output
      next
    }
    inside && /^[A-Za-z0-9+\/=]+$/ { print > output; next }
    /^-----END CERTIFICATE-----$/ {
      if (!inside) invalid = 1
      if (inside) { print > output; close(output) }
      inside = 0
      next
    }
    END {
      if (invalid || inside || count == 0 || count > 64) exit 1
    }
  '; then
    rm -f -- "$candidate_dir"/certificate-*.pem
    rmdir "$candidate_dir" 2>/dev/null || true
    rm -f "$chain_file" "$destination"
    return 1
  fi
  rm -f "$chain_file"

  candidate_files=("$candidate_dir"/certificate-*.pem)
  selected=false
  candidate_index=0
  while [ "$candidate_index" -lt "${#candidate_files[@]}" ]; do
    candidate_file="${candidate_files[$candidate_index]}"
    if "$openssl_bin" x509 -in "$candidate_file" -noout \
      >/dev/null 2>&1 \
      && "$openssl_bin" x509 -in "$candidate_file" -checkend 0 \
        -noout >/dev/null 2>&1 \
      && certificate_not_before_is_current \
        "$openssl_bin" "$candidate_file" \
      && certificate_has_ca_basic_constraint \
        "$openssl_bin" "$candidate_file"; then
      cp "$candidate_file" "$destination"
      selected=true
      break
    fi
    candidate_index=$((candidate_index + 1))
  done
  rm -f -- "$candidate_dir"/certificate-*.pem
  rmdir "$candidate_dir" 2>/dev/null || selected=false
  [ "$selected" = true ] || {
    rm -f "$destination"
    return 1
  }
  chmod 0600 "$destination"
  validate_extra_ca_bundle "$destination" || {
    rm -f "$destination"
    return 1
  }
}

usage() {
  cat <<'EOF'
Usage:
  agent-container [container options...] <profile> [agent arguments...]
  agent-container [container options...] run <profile> [runtime options...] [-- agent arguments...]
  agent-container [container options...] singleton status <profile>
  agent-container [container options...] singleton stop <profile>
  agent-container [container options...] profiles

Built-in compatibility commands:
  claude-container [container options...] [arguments...]
  codex-container [container options...] [arguments...]
  grok-container [container options...] [arguments...]

The host must be Apple silicon running macOS 26 or newer. Each profile runs
inside an arm64 Linux Micro-VM with an isolated, persistent shadow HOME.
Ordinary launches reuse one persistent container per profile; `run` creates
one legacy container for that invocation only.

Runtime options for `run`:
  --share-ro PATH          Share one additional directory read-only
  --share-rw PATH          Share one additional directory read-write
  --no-host-exec COMMAND   Do not expose one host command (may be repeated)
  --host-first COMMAND     Prefer one host command over the guest copy

Container launcher options (must precede the profile or Agent arguments):
  --container-cpus N              VM CPU count
  --container-memory SIZE         VM memory, for example 4g
  --container-build-cpus N        image-build CPU count
  --container-build-memory SIZE   image-build memory
  --container-version VERSION     latest or an exact native CLI version
  --container-base-image IMAGE    pinned base image reference
  --container-http-proxy URL      HTTP proxy
  --container-https-proxy URL     HTTPS proxy
  --container-all-proxy URL       all-protocol proxy
  --container-no-proxy LIST       proxy exclusion list
  --container-extra-ca auto|PATH  host trust bridge or an explicit CA bundle
  --container-dns1 ADDRESS        primary DNS server
  --container-dns2 ADDRESS        secondary DNS server
  --container-timezone ZONE       guest timezone
  --container-forward-env NAMES   exact exported names, comma-separated
  --container-max-files N         legacy VirtioFS file budget
  --container-fd-stop-percent N   legacy file-descriptor stop threshold
  --container-assets PATH         release asset directory
  --container-bin PATH            Apple container CLI override
  --container-host-broker PATH    host-exec broker override
  --container-host-node PATH      host Node.js override
  --container-host-gateway IP     default-network host gateway override
  --container-host-alias HOSTS    comma-separated guest names mapped to the host gateway
  --container-block-host HOSTS    comma-separated guest names mapped to IPv4/IPv6 blackholes
  --container-openssl PATH        host OpenSSL override
  --container-security PATH       macOS security tool override

Boolean container options:
  --container-enable-experimental
  --container-rebuild
  --container-skip-build
  --container-full-git-config
  --container-mount-gh
  --container-forward-api-key
  --container-forward-ssh-agent
  --container-mount-ssh-config
  --container-accept-virtiofs-risk
  --container-allow-concurrent
  --container-disable-fd-watchdog

Each boolean also accepts --no-container-NAME. Configuration through
AGENT_CONTAINER_* environment variables is no longer a public interface.
EOF
}

valid_host_command_name() {
  case "$1" in
    ''|.|..|[!A-Za-z0-9]*|*[!A-Za-z0-9._+-]*) return 1 ;;
  esac
  [ "${#1}" -le 64 ]
}

validate_env_name() {
  local name="$1"
  [ -z "$name" ] && return 0
  case "$name" in
    [A-Z_]* ) ;;
    *) return 1 ;;
  esac
  case "$name" in
    *[!A-Z0-9_]*) return 1 ;;
  esac
}

validate_profile_env_name() {
  local name="$1"
  [ -n "$name" ] && validate_env_name "$name" || return 1
  case "$name" in
    AGENT_CONTAINER|AGENT_CONTAINER_HOST_EXEC|AGENT_CONTAINER_*|AGENT_WORKSPACE|AGENT_WORKSPACE_*)
      return 1
      ;;
    AGENT_PROFILE|AGENT_VERSION|AGENT_COMMAND|AGENT_PROBE_ARG|AGENT_CA_FINGERPRINT|AGENT_INSTALLER_URL|AGENT_INSTALLER_SHELL|AGENT_INSTALLER_VERSION_ENV|AGENT_INSTALLER_BIN_DIR_ENV|AGENT_INSTALLER_HOME_ENV|AGENT_INSTALLER_NONINTERACTIVE_ENV)
      return 1
      ;;
    HOST_UID|HOST_GID|HOST_HOME|XDG_RUNTIME_DIR|IS_SANDBOX|BASE_IMAGE|DEFAULT_BASE_IMAGE)
      return 1
      ;;
    HOME|USER|LOGNAME|SHELL|PATH|PWD|OLDPWD|SHLVL|_|GIT_CONFIG_GLOBAL|TERM|COLORTERM|TZ|SSH_AUTH_SOCK)
      return 1
      ;;
    HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|FTP_PROXY)
      return 1
      ;;
    BASH_*|BASHOPTS|SHELLOPTS|ENV|POSIXLY_CORRECT|CDPATH|GLOBIGNORE|IFS|PS4|PROMPT_COMMAND)
      return 1
      ;;
    CURL_*|GIT_*|OPENSSL_*|SSL_*|SSLKEYLOGFILE|LD_*|DYLD_*|XDG_CONFIG_HOME|SSH_ASKPASS*)
      return 1
      ;;
  esac
}

validate_forward_env_name() {
  local name="$1"
  validate_profile_env_name "$name" || return 1
  if [ -n "${profile_disable_update_env:-}" ] \
    && [ "$name" = "$profile_disable_update_env" ]; then
    return 1
  fi
}

valid_agent_version() {
  printf '%s\n' "$1" \
    | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9._-]*)?(\+[A-Za-z0-9][A-Za-z0-9._-]*)?$'
}

valid_profile_id() {
  [ "${#1}" -le "$MAX_PROFILE_ID_LENGTH" ] || return 1
  case "$1" in
    ''|*[!a-z0-9-]*|[0-9-]*) return 1 ;;
    *) return 0 ;;
  esac
}

load_profile() {
  local requested_id="$1"
  local allow_experimental="${2:-false}"
  local profile_record

  valid_profile_id "$requested_id" \
    || die "Invalid profile id '$requested_id'. Use '$PROGRAM_NAME profiles' to list profiles."
  profile_id="$requested_id"
  profile_file="$asset_dir/profiles/$profile_id.json"
  [ -f "$profile_file" ] && [ ! -L "$profile_file" ] \
    || die "Unknown or unsafe Agent profile '$profile_id'. Use '$PROGRAM_NAME profiles' to list profiles."

  # Parse once with macOS JavaScriptCore instead of spawning plutil for every
  # field. The constant parser enforces an exact typed key set and emits one
  # unit-separator-delimited record; profile data is never evaluated as code.
  # Unlike a whitespace IFS delimiter, unit separator preserves empty fields.
  profile_record=$("$osascript_bin" -l JavaScript - "$profile_file" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const keys = [
    'schema',
    'id',
    'displayName',
    'status',
    'installerKind',
    'installerUrl',
    'installerShell',
    'installerVersionUrl',
    'installerVersionFormat',
    'installerVersionEnv',
    'installerBinDirEnv',
    'installerHomeEnv',
    'installerNonInteractiveEnv',
    'version',
    'command',
    'probeArg',
    'apiKeyEnv',
    'disableAutoUpdateEnv'
  ];
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('profile is not readable UTF-8');
  const value = JSON.parse(ObjC.unwrap(source));
  if (value === null || Array.isArray(value) || typeof value !== 'object') {
    throw new Error('profile root must be an object');
  }
  const actualKeys = Object.keys(value).sort();
  const expectedKeys = keys.slice().sort();
  if (actualKeys.length !== expectedKeys.length
      || actualKeys.some((key, index) => key !== expectedKeys[index])) {
    throw new Error('profile keys do not match schema 2');
  }
  if (!Number.isInteger(value.schema)) {
    throw new Error('schema must be an integer');
  }
  for (const key of keys.slice(1)) {
    if (typeof value[key] !== 'string' || /[\u0000-\u001f\u007f]/.test(value[key])) {
      throw new Error(key + ' must not contain control characters');
    }
  }
  return keys.map((key) => String(value[key])).join('\u001f');
}
JXA
  ) || die "Agent profile '$profile_id' is not valid schema-2 JSON."

  IFS=$'\037' read -r \
    profile_schema \
    profile_declared_id \
    profile_display_name \
    profile_status \
    profile_installer_kind \
    profile_installer_url \
    profile_installer_shell \
    profile_installer_version_url \
    profile_installer_version_format \
    profile_installer_version_env \
    profile_installer_bin_dir_env \
    profile_installer_home_env \
    profile_installer_noninteractive_env \
    profile_version \
    profile_command \
    profile_probe_arg \
    profile_api_key_env \
    profile_disable_update_env <<EOF
$profile_record
EOF

  [ "$profile_schema" = 2 ] \
    || die "Unsupported schema '$profile_schema' in profile '$profile_id'."
  [ "$profile_declared_id" = "$profile_id" ] \
    || die "Profile id '$profile_declared_id' does not match filename '$profile_id.json'."
  [ -n "$profile_display_name" ] \
    && printf '%s\n' "$profile_display_name" \
      | grep -Eq '^[A-Za-z0-9 ._+()/-]+$' \
    || die "Profile '$profile_id' has an unsafe displayName."
  case "$profile_status" in
    stable|preview) ;;
    experimental)
      if [ "$allow_experimental" != true ] \
        && ! is_true "${AGENT_CONTAINER_ENABLE_EXPERIMENTAL:-false}"; then
        die "Profile '$profile_id' is experimental. Pass --container-enable-experimental before the profile name to enable it explicitly."
      fi
      ;;
    *) die "Profile '$profile_id' has unsupported status '$profile_status'." ;;
  esac
  [ "$profile_installer_kind" = native-script ] \
    || die "Profile '$profile_id' uses unsupported installerKind '$profile_installer_kind'."
  case "$profile_installer_url" in
    https://*) ;;
    *) die "Profile '$profile_id' must use an HTTPS native installer URL." ;;
  esac
  case "$profile_installer_url" in
    *[!A-Za-z0-9._:/-]*) die "Profile '$profile_id' has an unsafe installerUrl." ;;
  esac
  case "$profile_installer_shell" in
    bash|sh) ;;
    *) die "Profile '$profile_id' has an unsupported installerShell." ;;
  esac
  case "$profile_installer_version_url" in
    https://*) ;;
    *) die "Profile '$profile_id' must use an HTTPS installerVersionUrl." ;;
  esac
  case "$profile_installer_version_url" in
    *[!A-Za-z0-9._:/-]*) die "Profile '$profile_id' has an unsafe installerVersionUrl." ;;
  esac
  case "$profile_installer_version_format" in
    plain-semver|rust-tag-json) ;;
    *) die "Profile '$profile_id' has an unsupported installerVersionFormat." ;;
  esac
  [ -z "$profile_installer_version_env" ] \
    || validate_profile_env_name "$profile_installer_version_env" \
    || die "Profile '$profile_id' has an unsafe installerVersionEnv."
  [ -z "$profile_installer_bin_dir_env" ] \
    || validate_profile_env_name "$profile_installer_bin_dir_env" \
    || die "Profile '$profile_id' has an unsafe installerBinDirEnv."
  [ -z "$profile_installer_home_env" ] \
    || validate_profile_env_name "$profile_installer_home_env" \
    || die "Profile '$profile_id' has an unsafe installerHomeEnv."
  [ -z "$profile_installer_noninteractive_env" ] \
    || validate_profile_env_name "$profile_installer_noninteractive_env" \
    || die "Profile '$profile_id' has an unsafe installerNonInteractiveEnv."
  if [ "$profile_version" != latest ]; then
    valid_agent_version "$profile_version" \
      || die "Profile '$profile_id' must select 'latest' or an exact native CLI version."
  fi
  case "$profile_command" in
    ''|*[!A-Za-z0-9._-]*) die "Profile '$profile_id' has an unsafe command." ;;
  esac
  case "$profile_probe_arg" in
    --version|-V|version) ;;
    *) die "Profile '$profile_id' has an unsupported probe argument." ;;
  esac
  [ -z "$profile_api_key_env" ] \
    || validate_profile_env_name "$profile_api_key_env" \
    || die "Profile '$profile_id' has an unsafe apiKeyEnv."
  [ -z "$profile_disable_update_env" ] \
    || validate_profile_env_name "$profile_disable_update_env" \
    || die "Profile '$profile_id' has an unsafe disableAutoUpdateEnv."
  if [ -n "$profile_api_key_env" ] \
    && [ "$profile_api_key_env" = "$profile_disable_update_env" ]; then
    die "Profile '$profile_id' reuses one environment name for credentials and update control."
  fi
}

host_home_dir="${HOME:?HOME is not set}"
script_dir=$(resolve_absolute_dir "$(dirname -- "$0")")
asset_dir="${AGENT_CONTAINER_ASSET_DIR:-$script_dir}"
if [ ! -f "$asset_dir/Containerfile" ] \
  || [ ! -f "$asset_dir/Containerfile.dockerignore" ] \
  || [ ! -f "$asset_dir/entrypoint.sh" ] \
  || [ ! -f "$asset_dir/host-exec-client" ] \
  || [ ! -f "$asset_dir/host-exec-broker.mjs" ] \
  || [ ! -f "$asset_dir/agent-workspace-connect" ] \
  || [ ! -f "$asset_dir/agent-workspace-session" ] \
  || [ ! -d "$asset_dir/profiles" ]; then
  asset_dir="${AGENT_CONTAINER_ASSET_DIR:-$host_home_dir/.local/share/agent-container/current}"
fi
asset_dir=$(resolve_absolute_dir "$asset_dir") \
  || die "Unable to resolve Agent container assets: $asset_dir"
[ -f "$asset_dir/Containerfile" ] && [ ! -L "$asset_dir/Containerfile" ] \
  || die "Containerfile not found. Re-run install.sh or pass --container-assets PATH."
[ -f "$asset_dir/Containerfile.dockerignore" ] \
  && [ ! -L "$asset_dir/Containerfile.dockerignore" ] \
  || die "Containerfile.dockerignore not found. Re-run install.sh or pass --container-assets PATH."
[ -f "$asset_dir/entrypoint.sh" ] && [ ! -L "$asset_dir/entrypoint.sh" ] \
  || die "entrypoint.sh not found. Re-run install.sh or pass --container-assets PATH."
[ -f "$asset_dir/host-exec-client" ] && [ ! -L "$asset_dir/host-exec-client" ] \
  || die "host-exec-client not found. Re-run install.sh or pass --container-assets PATH."
[ -f "$asset_dir/host-exec-broker.mjs" ] && [ ! -L "$asset_dir/host-exec-broker.mjs" ] \
  || die "host-exec-broker.mjs not found. Re-run install.sh or pass --container-assets PATH."
[ -f "$asset_dir/agent-workspace-connect" ] && [ ! -L "$asset_dir/agent-workspace-connect" ] \
  && [ -x "$asset_dir/agent-workspace-connect" ] \
  || die "agent-workspace-connect not found. Re-run install.sh or pass --container-assets PATH."
[ -f "$asset_dir/agent-workspace-session" ] && [ ! -L "$asset_dir/agent-workspace-session" ] \
  && [ -x "$asset_dir/agent-workspace-session" ] \
  || die "agent-workspace-session not found. Re-run install.sh or pass --container-assets PATH."
[ -d "$asset_dir/profiles" ] \
  || die "Profiles directory not found. Re-run install.sh or pass --container-assets PATH."

osascript_bin=$(command -v osascript || true)
[ -n "$osascript_bin" ] \
  || die "macOS osascript/JavaScriptCore is required to validate Agent profiles."

run_mode=false
singleton_control_action=""
extra_share_inputs=()
extra_share_input_modes=()
host_exec_denied=()
host_exec_first=(git)

requested_profile="${1:-}"
case "$requested_profile" in
  -h|--help|'')
    usage
    [ -n "$requested_profile" ] && exit 0
    exit 64
    ;;
  profiles)
    found_profile=false
    for profile_path in "$asset_dir"/profiles/*.json; do
      [ -f "$profile_path" ] || continue
      found_profile=true
      listed_id=$(basename -- "$profile_path" .json)
      load_profile "$listed_id" true
      printf '%-12s %-14s %s\n' "$profile_id" "$profile_status" "$profile_display_name"
    done
    [ "$found_profile" = true ] || die "No Agent profiles are installed."
    exit 0
    ;;
  singleton)
    shift
    singleton_control_action="${1:-}"
    case "$singleton_control_action" in
      status|stop) ;;
      -h|--help|'') usage; [ -n "$singleton_control_action" ] && exit 0; exit 64 ;;
      *) die "Unknown singleton action '$singleton_control_action'; expected status or stop." ;;
    esac
    shift
    requested_profile="${1:-}"
    case "$requested_profile" in
      claude|codex|grok) ;;
      *) die "The singleton control command requires the claude, codex, or grok profile." ;;
    esac
    shift
    [ "$#" -eq 0 ] \
      || die "The singleton control command does not accept additional arguments."
    ;;
  run)
    run_mode=true
    shift
    requested_profile="${1:-}"
    case "$requested_profile" in
      -h|--help) usage; exit 0 ;;
      '') die "The run command requires an Agent profile." ;;
    esac
    shift
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --share-ro|--share-rw)
          share_option="$1"
          [ "$#" -ge 2 ] \
            || die "$share_option requires a directory path."
          extra_share_inputs+=("$2")
          if [ "$share_option" = --share-ro ]; then
            extra_share_input_modes+=(ro)
          else
            extra_share_input_modes+=(rw)
          fi
          shift 2
          ;;
        --no-host-exec)
          [ "$#" -ge 2 ] \
            || die "$1 requires a command name."
          valid_host_command_name "$2" \
            || die "Unsafe host command name '$2'."
          host_exec_denied+=("$2")
          shift 2
          ;;
        --host-first)
          [ "$#" -ge 2 ] \
            || die "--host-first requires a command name."
          valid_host_command_name "$2" \
            || die "Unsafe host command name '$2'."
          host_exec_first+=("$2")
          shift 2
          ;;
        --)
          shift
          break
          ;;
        -h|--help)
          usage
          exit 0
          ;;
        *)
          die "Unknown agent-container run option '$1'. Place Agent arguments after --."
          ;;
      esac
    done
    ;;
esac
if [ "$run_mode" = false ] && [ -z "$singleton_control_action" ]; then
  shift
fi
if [ -n "$singleton_control_action" ]; then
  # Singleton recovery is a fixed management-plane operation, not a profile
  # launch. Keep it available after an installer selection removes a wrapper
  # and declarative profile: the reserved container name plus the complete
  # ownership/provenance labels below are the authority for status and stop.
  # No executable command or image setting is taken from a missing record.
  profile_id="$requested_profile"
  profile_api_key_env=""
  profile_disable_update_env=""
else
  load_profile "$requested_profile"
fi

# Ordinary profile launches always share one persistent container per profile.
# The explicit run mode retains its wider, per-launch host broker and therefore
# continues to use the legacy attached-container lifecycle for now.
singleton_requested=false
if [ -z "$singleton_control_action" ] && [ "$run_mode" = false ]; then
  singleton_requested=true
fi

profile_credential_forward_mode=false
if [ -n "${AGENT_CONTAINER_FORWARD_API_KEY+x}" ]; then
  case "$AGENT_CONTAINER_FORWARD_API_KEY" in
    true) profile_credential_forward_mode=true ;;
    false) profile_credential_forward_mode=false ;;
    *)
      die "--container-forward-api-key must be true or false."
      ;;
  esac
fi

# Every Agent endpoint, model, token, and setting uses this one explicit path.
# Each exact name is an authorization; values are inherited by Apple container
# and never copied into this launcher's argv. Runtime/identity and loader
# variables stay launcher-managed because overriding them could affect the
# root entrypoint itself.
explicit_forward_env_names=()
explicit_forward_env_value="${AGENT_CONTAINER_FORWARD_ENV:-}"
if [ -n "$explicit_forward_env_value" ]; then
  case "$explicit_forward_env_value" in
    ,*|*,|*,,*|*$'\n'*|*$'\r'*|*$'\t'*)
      die "--container-forward-env must be a comma-separated list of environment-variable names without empty entries."
      ;;
  esac
  IFS=, read -r -a requested_forward_env_names <<EOF
$explicit_forward_env_value
EOF
  for forward_env_name in "${requested_forward_env_names[@]}"; do
    [ -n "$forward_env_name" ] && validate_env_name "$forward_env_name" \
      || die "--container-forward-env contains an invalid environment-variable name."
    validate_forward_env_name "$forward_env_name" \
      || die "--container-forward-env contains a launcher-managed name: $forward_env_name"
    printenv "$forward_env_name" >/dev/null 2>&1 \
      || die "--container-forward-env requested '$forward_env_name', but it is unset or not exported."
    if [ "${#explicit_forward_env_names[@]}" -eq 0 ] \
      || ! array_contains_value "$forward_env_name" "${explicit_forward_env_names[@]}"; then
      explicit_forward_env_names+=("$forward_env_name")
    fi
  done
fi

if [ -n "${AGENT_CONTAINER_IMAGE:-}" ]; then
  die "AGENT_CONTAINER_IMAGE is not supported. Image references are profile-scoped to preserve ownership and uninstall provenance."
fi
image_repository="agent-container-$profile_id"
image_name="$image_repository:latest"

[ "$(uname -s)" = "Darwin" ] \
  || die "agent-container is supported only on macOS."
[ "$(uname -m)" = "arm64" ] \
  || die "agent-container requires Apple silicon."

macos_major=$(sw_vers -productVersion | cut -d. -f1)
case "$macos_major" in
  ''|*[!0-9]*) die "Could not determine the macOS version." ;;
esac
if [ "${macos_major:-0}" -lt 26 ]; then
  die "macOS 26 or newer is required by the supported Apple container release."
fi

host_uid=$(id -u)
host_gid=$(id -g)
[ "$host_uid" -gt 0 ] && [ "$host_gid" -gt 0 ] \
  || die "Refusing to launch an Agent container from a numeric root account."
singleton_container_name="agent-$profile_id-$host_uid-singleton"

container_bin="${AGENT_CONTAINER_BIN:-container}"
command -v "$container_bin" >/dev/null 2>&1 \
  || die "Apple container is not installed. Install it from https://github.com/apple/container/releases"

container_version_output=$("$container_bin" --version 2>&1) \
  || die "Unable to execute '$container_bin --version'."
container_version=$(printf '%s\n' "$container_version_output" \
  | sed -nE 's/.*version ([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' \
  | head -n 1)
[ -n "$container_version" ] \
  || die "Could not parse Apple container version from: $container_version_output"
version_at_least "$container_version" "$MIN_CONTAINER_VERSION" \
  || die "Apple container $MIN_CONTAINER_VERSION or newer is required (found $container_version)."

if ! "$container_bin" system status >/dev/null 2>&1; then
  printf '%s\n' \
    "Apple container services are not running; starting them now..." >&2
  "$container_bin" system start \
    || die "Unable to start Apple container services with: $container_bin system start"
  "$container_bin" system status >/dev/null 2>&1 \
    || die "Apple container services did not become ready after: $container_bin system start"
fi

# Return every project-labeled container plus any container occupying this
# launcher's reserved name pattern. The latter is reported even without our
# labels so recovery never deletes an unproven resource merely because its
# name looks familiar.
list_native_agent_containers() {
  local list_tmp parsed_records
  list_tmp=$(mktemp "${TMPDIR:-/tmp}/agent-container-list.XXXXXX") \
    || die "Unable to create temporary storage for Apple container state."
  if ! "$container_bin" list --all --format json > "$list_tmp" 2>/dev/null; then
    rm -f "$list_tmp"
    die "Unable to enumerate Apple containers for stale-session safety."
  fi
  if ! parsed_records=$("$osascript_bin" -l JavaScript - \
    "$list_tmp" "$host_uid" 2>/dev/null <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('container list is not readable UTF-8');
  const containers = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(containers)) throw new Error('container list must be an array');

  const hostUID = argv[1];
  const reserved = new RegExp(
    '^agent-[a-z0-9-]+-' + hostUID + '(?:-[0-9]+|-singleton)$'
  );
  const records = [];
  for (const container of containers) {
    if (container === null || typeof container !== 'object' || Array.isArray(container)) {
      throw new Error('container list contains a non-object record');
    }
    const id = container.id;
    if (typeof id !== 'string' || /[\t\r\n]/.test(id)) {
      throw new Error('container id is not a single-line string');
    }
    const configuration = container.configuration;
    if (configuration === null || typeof configuration !== 'object'
        || Array.isArray(configuration) || configuration.id !== id) {
      throw new Error('container configuration identity does not match its record');
    }
    const labels = configuration && typeof configuration === 'object'
      && configuration.labels && typeof configuration.labels === 'object'
      ? configuration.labels
      : {};
    const owned = labels['com.loadchange.agent-container'] === 'true';
    if (!owned && !reserved.test(id)) continue;

    const state = container.status && typeof container.status === 'object'
      ? container.status.state
      : null;
    if (!['unknown', 'stopped', 'running', 'stopping'].includes(state)) {
      throw new Error('managed container has an invalid runtime state');
    }
    const values = [
      id,
      owned ? 'true' : 'false',
      labels['com.loadchange.agent-container.profile'] ?? '-',
      labels['com.loadchange.agent-container.host-uid'] ?? '-',
      labels['com.loadchange.agent-container.launcher-pid'] ?? '-',
      labels['com.loadchange.agent-container.mode'] ?? '-',
      labels['com.loadchange.agent-container.workspace-roots-sha256'] ?? '-',
      labels['com.loadchange.agent-container.config-sha256'] ?? '-',
      state
    ];
    if (values.some((value) => typeof value !== 'string' || /[\t\r\n]/.test(value))) {
      throw new Error('managed container metadata is not a single-line string');
    }
    records.push(values.join('\t'));
  }
  return records.join('\n');
}
JXA
  ); then
    rm -f "$list_tmp"
    die "Apple container state did not match the expected JSON contract."
  fi
  rm -f "$list_tmp"
  [ -z "$parsed_records" ] || printf '%s\n' "$parsed_records"
}

# Confirm only the narrow fact needed after an attached --rm start: the exact
# container ID is absent from a successful, structurally valid `list --all`.
# Inspect stderr is intentionally not parsed because Apple may wrap a
# not-found phrase inside a broader service/RPC error. Any list failure,
# malformed record, or matching ID is indeterminate and therefore returns
# failure without deleting anything.
native_container_name_is_absent() {
  local expected_name="$1"
  local list_tmp
  list_tmp=$(mktemp "${TMPDIR:-/tmp}/agent-container-absence.XXXXXX") \
    || return 1
  if ! "$container_bin" list --all --format json > "$list_tmp" 2>/dev/null; then
    rm -f "$list_tmp"
    return 1
  fi
  if ! "$osascript_bin" -l JavaScript - \
    "$list_tmp" "$expected_name" >/dev/null 2>&1 <<'JXA'
ObjC.import('Foundation');

function run(argv) {
  const error = Ref();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    argv[0],
    $.NSUTF8StringEncoding,
    error
  );
  if (!source) throw new Error('container list is not readable UTF-8');
  const containers = JSON.parse(ObjC.unwrap(source));
  if (!Array.isArray(containers)) throw new Error('container list must be an array');

  const expectedID = argv[1];
  for (const container of containers) {
    if (container === null || typeof container !== 'object' || Array.isArray(container)) {
      throw new Error('container list contains a non-object record');
    }
    const id = container.id;
    if (typeof id !== 'string' || /[\t\r\n]/.test(id)) {
      throw new Error('container id is not a single-line string');
    }
    if (id === expectedID) throw new Error('container still exists');
  }
  return 'absent';
}
JXA
  then
    rm -f "$list_tmp"
    return 1
  fi
  rm -f "$list_tmp"
}

valid_sha256_value() {
  [ "${#1}" -eq 64 ] || return 1
  case "$1" in
    *[!0-9a-f]*) return 1 ;;
  esac
}

validate_singleton_native_record() {
  local native_id="$1"
  local native_owned="$2"
  local native_profile="$3"
  local native_uid="$4"
  local native_pid="$5"
  local native_mode="$6"
  local native_roots_hash="$7"
  local native_config_hash="$8"

  valid_profile_id "$native_profile" \
    || die "Container '$native_id' has an invalid singleton profile label."
  [ "$native_id" = "agent-$native_profile-$host_uid-singleton" ] \
    || die "Singleton container identity mismatch: $native_id"
  [ "$native_owned" = true ] \
    || die "Container '$native_id' occupies a singleton name without project ownership labels."
  [ "$native_uid" = "$host_uid" ] \
    || die "Container '$native_id' has mismatched singleton host UID provenance."
  case "$native_pid" in
    ''|0|1|*[!0-9]*)
      die "Container '$native_id' has an invalid creator PID label."
      ;;
  esac
  [ "$native_mode" = singleton ] \
    || die "Container '$native_id' lacks the singleton mode label."
  # Accept the legacy roots column from structured list parsing, but a generic
  # singleton neither requires nor publishes a static workspace-root hash.
  [ -n "$native_roots_hash" ] \
    || die "Container '$native_id' has invalid singleton metadata."
  valid_sha256_value "$native_config_hash" \
    || die "Container '$native_id' has an invalid singleton configuration fingerprint."
}

clear_singleton_state_files() {
  local singleton_state_root="$1"
  local singleton_stage_root="$singleton_state_root/guest-stage"
  local singleton_ssh_stage="$singleton_stage_root/ssh"

  [ -e "$singleton_state_root" ] || [ -L "$singleton_state_root" ] || return 0
  validate_managed_directory "$singleton_state_root"
  validate_managed_directory "$singleton_stage_root"
  validate_managed_directory "$singleton_ssh_stage"
  if [ -d "$singleton_stage_root" ]; then
    rm -f "$singleton_stage_root/gitconfig"
    if [ -d "$singleton_ssh_stage" ]; then
      rm -f \
        "$singleton_ssh_stage/config" \
        "$singleton_ssh_stage/known_hosts" \
        "$singleton_ssh_stage/known_hosts.old" \
        "$singleton_ssh_stage/allowed_signers"
      rmdir "$singleton_ssh_stage" 2>/dev/null || true
    fi
    rmdir "$singleton_stage_root" 2>/dev/null || true
  fi
  rm -f \
    "$singleton_state_root/phase" \
    "$singleton_state_root/creator-pid" \
    "$singleton_state_root/agent-version" \
    "$singleton_state_root/image-digest" \
    "$singleton_state_root/config.sha256"
  rmdir "$singleton_state_root" 2>/dev/null || true
}

if [ -n "$singleton_control_action" ]; then
  host_home_dir=$(resolve_absolute_dir "$host_home_dir") \
    || die "Unable to resolve the host home for singleton control."
  control_state_root="$host_home_dir/.agent-container"
  control_profiles_root="$control_state_root/profiles"
  control_profile_root="$control_profiles_root/$profile_id"
  control_singleton_root="$control_profile_root/singleton"
  if [ -e "$control_state_root" ] || [ -L "$control_state_root" ]; then
    validate_managed_directory "$control_state_root"
    ownership_marker_valid "$control_state_root/.agent-container-owned" \
      || die "Agent state has no valid ownership marker; singleton control stopped fail-closed."
    validate_managed_directory "$control_profiles_root"
    validate_managed_directory "$control_profile_root"
    validate_managed_directory "$control_singleton_root"
  fi

  if [ "$singleton_control_action" = stop ]; then
    acquire_lifecycle_lock
  fi

  singleton_record=""
  while IFS=$'\t' read -r \
    native_id native_owned native_profile native_uid native_pid \
    native_mode native_roots_hash native_config_hash native_state; do
    [ -n "$native_id" ] || continue
    if [ "$native_id" = "$singleton_container_name" ]; then
      [ -z "$singleton_record" ] \
        || die "Apple container returned duplicate records for '$singleton_container_name'."
      validate_singleton_native_record \
        "$native_id" "$native_owned" "$native_profile" "$native_uid" \
        "$native_pid" "$native_mode" "$native_roots_hash" \
        "$native_config_hash"
      singleton_record=$(printf '%s\t%s\t%s\t%s\n' \
        "$native_state" "$native_roots_hash" "$native_config_hash" "$native_pid")
    fi
  done <<EOF
$(list_native_agent_containers)
EOF

  if [ -z "$singleton_record" ]; then
    if [ "$singleton_control_action" = stop ]; then
      clear_singleton_state_files "$control_singleton_root"
    fi
    printf '%s singleton: stopped (container %s is absent)\n' \
      "$profile_id" "$singleton_container_name"
    exit 0
  fi

  IFS=$'\t' read -r \
    singleton_native_state singleton_native_roots_hash \
    singleton_native_config_hash singleton_creator_pid <<EOF
$singleton_record
EOF

  if [ "$singleton_control_action" = status ]; then
    singleton_phase=$(read_single_line "$control_singleton_root/phase" || true)
    [ -n "$singleton_phase" ] || singleton_phase=unregistered
    printf '%s singleton: %s (container=%s phase=%s config-sha256=%s)\n' \
      "$profile_id" \
      "$singleton_native_state" \
      "$singleton_container_name" \
      "$singleton_phase" \
      "$singleton_native_config_hash"
    exit 0
  fi

  if [ "$singleton_native_state" != stopped ]; then
    "$container_bin" stop --time 5 "$singleton_container_name" >/dev/null 2>&1 \
      || true
  fi

  post_stop_record=""
  while IFS=$'\t' read -r \
    native_id native_owned native_profile native_uid native_pid \
    native_mode native_roots_hash native_config_hash native_state; do
    [ "$native_id" = "$singleton_container_name" ] || continue
    validate_singleton_native_record \
      "$native_id" "$native_owned" "$native_profile" "$native_uid" \
      "$native_pid" "$native_mode" "$native_roots_hash" \
      "$native_config_hash"
    post_stop_record="$native_state"
  done <<EOF
$(list_native_agent_containers)
EOF

  case "$post_stop_record" in
    '') ;;
    stopped)
      "$container_bin" delete --force "$singleton_container_name" >/dev/null 2>&1 \
        || native_container_name_is_absent "$singleton_container_name" \
        || die "The stopped '$profile_id' singleton could not be deleted safely."
      ;;
    *)
      die "The '$profile_id' singleton remained in state '$post_stop_record' after stop; it was not force-deleted."
      ;;
  esac
  native_container_name_is_absent "$singleton_container_name" \
    || die "Could not prove the '$profile_id' singleton container is absent after stop."
  clear_singleton_state_files "$control_singleton_root"
  printf '%s singleton stopped: %s\n' "$profile_id" "$singleton_container_name"
  exit 0
fi

http_proxy_value="${AGENT_CONTAINER_HTTP_PROXY:-}"
https_proxy_value="${AGENT_CONTAINER_HTTPS_PROXY:-}"
all_proxy_value="${AGENT_CONTAINER_ALL_PROXY:-}"
no_proxy_value="${AGENT_CONTAINER_NO_PROXY:-localhost,127.0.0.1}"
dns1_value="${AGENT_CONTAINER_DNS1:-}"
dns2_value="${AGENT_CONTAINER_DNS2:-}"
timezone_value="${AGENT_CONTAINER_TZ:-}"
host_alias_value="${AGENT_CONTAINER_HOST_ALIAS:-}"
block_host_value="${AGENT_CONTAINER_BLOCK_HOST:-}"
extra_ca_setting="${AGENT_CONTAINER_EXTRA_CA_CERTS:-auto}"

reject_control_characters --container-http-proxy "$http_proxy_value"
reject_control_characters --container-https-proxy "$https_proxy_value"
reject_control_characters --container-all-proxy "$all_proxy_value"
reject_control_characters --container-no-proxy "$no_proxy_value"
reject_control_characters --container-dns1 "$dns1_value"
reject_control_characters --container-dns2 "$dns2_value"
reject_control_characters --container-timezone "$timezone_value"
reject_control_characters --container-host-alias "$host_alias_value"
reject_control_characters --container-block-host "$block_host_value"
reject_control_characters --container-cpus "${AGENT_CONTAINER_CPUS:-4}"
reject_control_characters --container-memory "${AGENT_CONTAINER_MEMORY:-4g}"

host_aliases=()
if [ -n "$host_alias_value" ]; then
  case "$host_alias_value" in
    ,*|*,|*,,*) die "--container-host-alias must contain comma-separated DNS names." ;;
  esac
  IFS=, read -r -a requested_host_aliases <<EOF
$host_alias_value
EOF
  for host_alias in "${requested_host_aliases[@]}"; do
    case "$host_alias" in
      ''|*[!A-Za-z0-9.-]*|.*|*.|*..*)
        die "--container-host-alias contains an unsafe DNS name: $host_alias"
        ;;
    esac
    if [ "${#host_aliases[@]}" -eq 0 ] \
      || ! array_contains_value "$host_alias" "${host_aliases[@]}"; then
      host_aliases+=("$host_alias")
    fi
  done
fi

blocked_hosts=()
if [ -n "$block_host_value" ]; then
  case "$block_host_value" in
    ,*|*,|*,,*) die "--container-block-host must contain comma-separated DNS names." ;;
  esac
  IFS=, read -r -a requested_blocked_hosts <<EOF
$block_host_value
EOF
  for blocked_host in "${requested_blocked_hosts[@]}"; do
    case "$blocked_host" in
      ''|*[!A-Za-z0-9.-]*|.*|*.|*..*)
        die "--container-block-host contains an unsafe DNS name: $blocked_host"
        ;;
    esac
    if array_contains_value "$blocked_host" "${host_aliases[@]}"; then
      die "A hostname cannot be both --container-host-alias and --container-block-host: $blocked_host"
    fi
    if [ "${#blocked_hosts[@]}" -eq 0 ] \
      || ! array_contains_value "$blocked_host" "${blocked_hosts[@]}"; then
      blocked_hosts+=("$blocked_host")
    fi
  done
fi

case "$extra_ca_setting" in
  ''|auto) ;;
  /*)
    case "$extra_ca_setting" in
      *','*|*$'\n'*|*$'\r'*|*$'\t'*)
        die "--container-extra-ca contains characters unsupported by the Apple build-secret interface."
        ;;
    esac
    ;;
  *)
    die "--container-extra-ca must be 'auto' or an absolute PEM bundle path."
    ;;
esac

proxy_values_lower=$(
  printf '%s\n' "$http_proxy_value" "$https_proxy_value" "$all_proxy_value" \
    | tr '[:upper:]' '[:lower:]'
)
case "$proxy_values_lower" in
  *host.docker.internal*)
    die "host.docker.internal is Docker-specific and is unreachable from Apple containers. Configure a VM-reachable proxy address, or explicitly create and use Apple's host.container.internal bridge as documented in README.md."
    ;;
esac

host_workspace=$(pwd -P)
mount_root="$host_workspace"
common_git_dir=""

if command -v git >/dev/null 2>&1 \
  && git -C "$host_workspace" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git_top=$(git -C "$host_workspace" rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$git_top" ] && [ -d "$git_top" ]; then
    mount_root=$(resolve_absolute_dir "$git_top")
  fi

  common_git_dir=$(git -C "$host_workspace" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [ -z "$common_git_dir" ]; then
    common_git_raw=$(git -C "$host_workspace" rev-parse --git-common-dir 2>/dev/null || true)
    if [ -n "$common_git_raw" ]; then
      case "$common_git_raw" in
        /*) common_git_dir="$common_git_raw" ;;
        *) common_git_dir=$(resolve_absolute_dir "$mount_root/$common_git_raw" || true) ;;
      esac
    fi
  fi
fi

if [ -n "$common_git_dir" ]; then
  [ -d "$common_git_dir" ] \
    || die "Git reported a common directory that does not exist: $common_git_dir"
  common_git_dir=$(resolve_absolute_dir "$common_git_dir")
fi
reject_control_characters "workspace path" "$host_workspace"
reject_control_characters "workspace root" "$mount_root"
reject_control_characters "Git common directory" "$common_git_dir"
if [ "$singleton_requested" = true ] \
  && [ -n "$common_git_dir" ] \
  && ! path_contains "$mount_root" "$common_git_dir"; then
  die "The current Git worktree uses an external common directory '$common_git_dir'. Dynamic singleton sharing currently supports one workspace root; use 'agent-container run $profile_id --' for this worktree."
fi

home_canonical=$(resolve_absolute_dir "$host_home_dir")
host_home_dir="$home_canonical"

extra_share_paths=()
extra_share_modes=()
if [ "$run_mode" = true ]; then
  share_index=0
  while [ "$share_index" -lt "${#extra_share_inputs[@]}" ]; do
    share_input="${extra_share_inputs[$share_index]}"
    share_mode="${extra_share_input_modes[$share_index]}"
    [ -d "$share_input" ] \
      || die "Additional share is not an existing directory: $share_input"
    share_path=$(resolve_absolute_dir "$share_input") \
