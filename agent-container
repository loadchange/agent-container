#!/bin/bash
set -euo pipefail

# Source-tree bootstrap only. Installed releases place the prebuilt Rust binary
# at this path, so normal launches do not invoke Cargo or this script.
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
launcher="$script_dir/target/release/agent-container-launcher"
launcher_argv0=agent-container

# The tracked compatibility commands are tiny source-tree shims. Installed
# releases use direct symlinks to the Rust binary, so this branch exists only
# to preserve argv[0] dispatch while developing from a checkout.
if [ "${1:-}" = __agent_container_source_alias ]; then
  [ "$#" -ge 2 ] || {
    echo "Error: incomplete source alias dispatch." >&2
    exit 64
  }
  case "$2" in
    claude|codex|grok) launcher_argv0="$2-container" ;;
    *)
      echo "Error: invalid source alias profile: $2" >&2
      exit 64
      ;;
  esac
  shift 2
fi

launcher_stale=false
if [ ! -x "$launcher" ]; then
  launcher_stale=true
else
  for source_file in \
    "$script_dir/Cargo.toml" \
    "$script_dir/Cargo.lock" \
    "$script_dir/src/main.rs" \
    "$script_dir/src/launcher.rs" \
    "$script_dir/src/broker.rs"; do
    if [ "$source_file" -nt "$launcher" ]; then
      launcher_stale=true
      break
    fi
  done
fi

if [ "$launcher_stale" = true ]; then
  command -v cargo >/dev/null 2>&1 || {
    echo "Error: Cargo is required to run agent-container from a source checkout." >&2
    exit 69
  }
  cargo build \
    --locked \
    --offline \
    --release \
    --target-dir "$script_dir/target" \
    --manifest-path "$script_dir/Cargo.toml" \
    >/dev/null
fi

exec -a "$launcher_argv0" "$launcher" "$@"
