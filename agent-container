host_free_vnodes=$(sysctl -n kern.free_vnodes 2>/dev/null || true)
case "$host_num_files:$host_max_files:$host_max_files_per_proc:$host_max_vnodes:$host_free_vnodes" in
  *[!0-9:]*)
    host_num_files=""
    host_max_files=""
    host_max_files_per_proc=""
    host_max_vnodes=""
    host_free_vnodes=""
    ;;
esac
if [ -z "$host_num_files" ] \
  || [ -z "$host_max_files" ] \
  || [ -z "$host_max_files_per_proc" ] \
  || [ -z "$host_max_vnodes" ] \
  || [ -z "$host_free_vnodes" ] \
  || [ "$host_max_files" -le 0 ] \
  || [ "$host_max_files_per_proc" -le 0 ] \
  || [ "$host_max_vnodes" -le 0 ] \
  || [ "$host_free_vnodes" -gt "$host_max_vnodes" ]; then
  if is_true "${AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK:-false}"; then
    warn "Unable to read all macOS file/vnode limits; continuing only because AGENT_CONTAINER_ACCEPT_VIRTIOFS_RISK is enabled."
    # If counters recover after launch, a zero baseline makes the live
    # watchdog conservative instead of performing arithmetic on an empty value.
    host_num_files=0
